# {{ ansible_managed }}
# /etc/conformite/conformite.env — paramètres de /usr/local/sbin/conformite-analyse (M26-E24).
# Aucun secret ici (fichier lisible) : les identifiants S3 sont dans /etc/conformite/s3.env (600).
CONFORMITE_DATASTREAM="{{ durcissement_conformite_datastream }}"
CONFORMITE_TAILORING="{{ durcissement_conformite_tailoring }}"
# Paires « étiquette=identifiant de profil XCCDF », séparées par des espaces.
CONFORMITE_REFERENTIELS="{% for ref, profil in durcissement_conformite_profils.items() %}{{ ref }}={{ profil }}{% if not loop.last %} {% endif %}{% endfor %}"
CONFORMITE_S3_URL="{{ durcissement_conformite_s3_url }}"
CONFORMITE_COMPARTIMENT="{{ durcissement_conformite_compartiment }}"
CONFORMITE_TEXTFILE="{{ durcissement_conformite_textfile }}"
CONFORMITE_LYNIS="{{ 'oui' if durcissement_conformite_lynis | bool else 'non' }}"
