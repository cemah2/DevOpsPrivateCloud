# {{ durcissement_entete }}
# /etc/medisphere/conformite/conformite.env — paramètres de /usr/local/sbin/conformite-analyse (M26-E24).
# Aucun secret ici : les identifiants S3 sont dans s3.env (600), dans le même dossier.
CONFORMITE_DATASTREAM="{{ durcissement_conformite_datastream }}"
# Triplets « étiquette:profil adapté:fichier de tailoring » (profils et fichiers d'E10), séparés par des espaces.
CONFORMITE_REFERENTIELS="{% for r in durcissement_conformite_referentiels %}{{ r.etiquette }}:xccdf_org.ssgproject.content_profile_{{ r.profil }}_medisphere:{{ durcissement_conformite_dossier }}/tailoring-{{ r.tailoring }}.xml{% if not loop.last %} {% endif %}{% endfor %}"
CONFORMITE_S3_URL="{{ durcissement_conformite_s3_url }}"
CONFORMITE_COMPARTIMENT="{{ durcissement_conformite_compartiment }}"
CONFORMITE_TEXTFILE="{{ durcissement_conformite_textfile }}"
CONFORMITE_LYNIS="{{ 'oui' if durcissement_conformite_lynis | bool else 'non' }}"
