# {{ durcissement_entete }}
# conformite-analyse.timer — rôle durcissement (M26-E24). Le dimanche à {{ durcissement_conformite_heure }}, décalé
# d'une durée aléatoire FIXE par hôte (FixedRandomDelay) : les analyses ne tombent pas toutes à la même
# minute sur pve01, et chaque hôte garde le même créneau d'une semaine à l'autre (comparaisons propres).
[Unit]
Description=Analyse de conformité hebdomadaire (MédiSphère)

[Timer]
OnCalendar={{ durcissement_conformite_calendrier }}
RandomizedDelaySec={{ durcissement_conformite_decalage }}
FixedRandomDelay=yes
AccuracySec=1min
# Machine éteinte le dimanche : l'analyse part au démarrage suivant.
Persistent=true

[Install]
WantedBy=timers.target
