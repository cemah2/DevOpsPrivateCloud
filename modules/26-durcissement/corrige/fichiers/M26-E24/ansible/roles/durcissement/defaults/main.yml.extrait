# roles/durcissement/defaults/main.yml — EXTRAIT : variables ajoutées en M26-E24 (conformité continue).
# Les variables du rôle d'E10 (durcissement_referentiel, durcissement_exceptions, durcissement_ssg_dossier,
# durcissement_conformite_dossier = /etc/medisphere/conformite…) sont inchangées et réutilisées ici.

# Interrupteur (retour arrière : false, puis rejouer le rôle → minuterie arrêtée et désactivée).
durcissement_conformite_continue_actif: true

# Contenu SCAP et profils adaptés : ceux du domaine « conformite » d'E10, sans rien redéfinir.
#   - flux de données : {{ durcissement_ssg_dossier }}/ssg-debian13-ds.xml (Debian, archive amont dépliée
#     par E10) ; ssg-rl10-ds.xml du paquet scap-security-guide d'AppStream (Rocky) ;
#   - profils adaptés : {{ durcissement_conformite_dossier }}/tailoring-{cis,anssi}.xml (E10), qui déclarent
#     les profils xccdf_org.ssgproject.content_profile_<id>_medisphere (référentiel moins les exceptions).
# Les identifiants sont ceux relevés en E04 (referentiels.md) ; vérifie-les par « oscap info ».
durcissement_conformite_datastream_par_famille:
  Debian: "{{ durcissement_ssg_dossier }}/ssg-debian13-ds.xml"
  RedHat: /usr/share/xml/scap/ssg/content/ssg-rl10-ds.xml
durcissement_conformite_datastream: "{{ durcissement_conformite_datastream_par_famille[ansible_facts['os_family']] }}"

# Référentiels mesurés : étiquette « referentiel » des métriques, profil adapté d'E10 (tailoring-<nom>.xml)
# et identifiant du profil d'origine (le profil évalué est <id>_medisphere, déclaré par le tailoring).
durcissement_conformite_referentiels:
  - etiquette: cis_l1_serveur
    tailoring: cis
    profil: "{{ 'cis_level1_server' if ansible_facts['os_family'] == 'Debian' else 'cis_server_l1' }}"
  - etiquette: "anssi_{{ durcissement_anssi_niveau }}"
    tailoring: anssi
    profil: >-
      anssi_bp28_{{ {'minimal': 'minimal', 'intermediaire': 'intermediary',
                     'renforce': 'enhanced', 'eleve': 'high'}[durcissement_anssi_niveau] }}

# Planification : dimanche 03:30, décalage aléatoire fixe par hôte jusqu'à 30 min.
durcissement_conformite_heure: "03:30"
durcissement_conformite_calendrier: "Sun *-*-* {{ durcissement_conformite_heure }}:00"
durcissement_conformite_decalage: 30min
# Bornes de charge (mesurées sur mon01 : ~6 min et ~350 Mio par référentiel, à remplacer par TES mesures).
durcissement_conformite_quota_cpu: 50%
durcissement_conformite_memoire_max: 1G

# Résultats.
durcissement_conformite_s3_url: https://s3-01.par1.medisphere.internal:8333
durcissement_conformite_compartiment: conformite
durcissement_conformite_s3_cle_acces: "{{ vault_s3_conformite_cle_acces }}"
durcissement_conformite_s3_cle_secrete: "{{ vault_s3_conformite_cle_secrete }}"
# Même dossier que le rôle node_exporter (M21-E08) ; monté dans le DaemonSet node-exporter de kps
# pour les nœuds de k8s-par1.
durcissement_conformite_textfile: "{{ node_exporter_dossier_textfile | default('/var/lib/prometheus/node-exporter') }}"

# Lynis (dépôt CISOfy sur Debian : Debian 13 livre une 3.1.4 jugée trop ancienne par Lynis ; EPEL sur Rocky).
durcissement_conformite_lynis: true
durcissement_conformite_lynis_depot_debian: https://packages.cisofy.com/community/lynis/deb/
durcissement_conformite_lynis_cle_debian: https://packages.cisofy.com/keys/cisofy-software-public.key
