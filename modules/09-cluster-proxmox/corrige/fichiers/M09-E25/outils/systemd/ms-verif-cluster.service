# /etc/systemd/system/ms-verif-cluster.service — M09-E25 (PLAT-1051)
# Sonde du cluster hv-par1. Déclenchée par ms-verif-cluster.timer (toutes les 5 minutes).
# Test manuel : sudo systemctl start ms-verif-cluster.service ; journalctl -u ms-verif-cluster -n 40

[Unit]
Description=MédiSphère : sonde du cluster de virtualisation hv-par1
Documentation=https://git01.par1.medisphere.internal/plateforme/outils/-/blob/main/docs/astreinte.md
Wants=network-online.target
After=network-online.target
OnFailure=ms-alerte@%n.service

[Service]
Type=oneshot
User=admin
Group=admin
# Version installée par « task install:systeme », jamais le clone de travail.
ExecStart=/usr/local/bin/ms-verif-cluster --quiet
TimeoutStartSec=3min
SyslogIdentifier=ms-verif-cluster
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
UMask=0077
