# ~/.config/workbook/pve-hv-supervision.env — accès en LECTURE SEULE à l'API de hv-par1 (M09-E25)
# Mode 600, propriétaire admin. Jamais dans un dépôt. Format de M00-E17 (lu par lib/ms-commun.sh).
# Le secret vient de Vault critique (vault_pve_hv_supervision_secret), affiché une seule fois à la
# création du jeton : copie-le ici avec un éditeur, jamais par « echo » dans le shell.
PVE_API_URL="https://hv01.par1.medisphere.internal:8006/api2/json"
PVE_NODE="hv01"
PVE_TOKEN_ID="wb-supervision@pve!hv"
PVE_TOKEN_SECRET="<SECRET-DU-JETON>"
# Avant M09-E26 : /usr/local/share/ca-certificates/hv-par1-root-ca.crt (autorité du cluster, M09-E18) ;
# après : racine MédiSphère.
PVE_CACERT="/usr/local/share/ca-certificates/medisphere-root-ca.crt"
