# ~/.gitconfig sur adm01 — EXTRAIT (M01-E27) : signature SSH des commits et étiquettes
# Posé en M01-E03 : ici, on le vérifie (git config --show-origin --get-regexp '^(user|gpg|commit|tag)\.')
[user]
	# DOIT être une adresse VÉRIFIÉE de ton compte GitLab, sinon « Unverified »
	email = <MOI>@medisphere.internal
	# Clé DÉDIÉE à la signature (chemin ABSOLU de la clé publique ; la privée est à côté)
	signingkey = /home/admin/.ssh/id_ed25519_signature.pub
[gpg]
	format = ssh
[gpg "ssh"]
	# Fichier de confiance LOCAL, mis à jour volontairement depuis
	# plateforme/medisphere:docs/socle/securite/allowed_signers (jamais le fichier
	# du dépôt directement : une branche pourrait y ajouter une clé)
	allowedSignersFile = /home/admin/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
