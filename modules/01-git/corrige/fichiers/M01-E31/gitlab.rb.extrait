# =============================================================================
# /etc/gitlab/gitlab.rb — EXTRAIT (M01-E31) : durcissement côté fichier
# Les réglages applicatifs (2FA, Admin Mode, visibilité…) sont en base : voir
# durcir-gitlab.sh. Ici, ce qui relève du serveur web et du système.
#
# ⚠️ Depuis GitLab 19.2, les réglages NGINX de l'application sont sous
# gitlab_rails['nginx'][...] ; les anciennes clés nginx[...] sont dépréciées mais
# encore appliquées. N'écris pas les deux formes pour une même clé.
# =============================================================================

# TLS : protocoles récents seulement (valeur par défaut actuelle, écrite pour
# qu'un changement de défaut ne passe pas inaperçu à la relecture).
gitlab_rails['nginx']['ssl_protocols'] = "TLSv1.2 TLSv1.3"
# HSTS : le navigateur refusera tout retour en HTTP pendant 2 ans.
gitlab_rails['nginx']['hsts_max_age'] = 63072000
# Redirection HTTP -> HTTPS (port 80 ouvert seulement pour rediriger).
gitlab_rails['nginx']['redirect_http_to_https'] = true

# Rien ne doit partir vers l'extérieur sans décision (souveraineté, HDS).
gitlab_rails['usage_ping_enabled'] = false

# Taille maximale d'un push (Mo), filet global en plus des hooks de M01-E26.
# (Réglage applicatif receive_max_input_size, possible aussi par l'API.)

# Journaux : rétention locale (logrotate interne) ; l'envoi centralisé viendra au M22.
logging['logrotate_rotate'] = 30
