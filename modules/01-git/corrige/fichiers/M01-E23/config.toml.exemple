# /etc/gitlab-runner/config.toml — runner01 (M01-E23), après « gitlab-runner register »
# Fichier root:root 0600 : il contient le jeton d'authentification du runner.
# Le jeton ci-dessous est un exemple : le vrai commence par « glrt- ».

concurrent = 2           # 2 vCPU : deux jobs en parallèle au plus sur ce runner
check_interval = 0       # 0 = valeur par défaut (interrogation de GitLab toutes les 3 s)
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "runner01-shell"
  url = "https://git01.par1.medisphere.internal"
  id = 1
  token = "glrt-<JETON-D-AUTHENTIFICATION>"
  token_obtained_at = 2026-10-03T08:00:00Z
  token_expires_at = 0001-01-01T00:00:00Z
  executor = "shell"
  shell = "bash"
  [runners.cache]
    MaxUploadedArchiveSize = 0
