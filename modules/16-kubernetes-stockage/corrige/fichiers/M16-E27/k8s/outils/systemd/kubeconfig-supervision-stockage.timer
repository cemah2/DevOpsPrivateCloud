# ~/.config/systemd/user/kubeconfig-supervision-stockage.timer — M16-E27
# Quotidien : le jeton (48 h) n'est jamais à moins d'un jour de son expiration.
[Unit]
Description=MédiSphère : renouvellement quotidien du jeton de la sonde du stockage Kubernetes

[Timer]
OnCalendar=*-*-* 06:40
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
