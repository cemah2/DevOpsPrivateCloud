# ~/.config/systemd/user/kubeconfig-supervision-stockage.service (adm01, utilisateur admin) — M16-E27
# Renouvelle le jeton lié (48 h) du kubeconfig de la sonde ms-verif-k8s-stockage. S'exécute avec
# le kubeconfig personnel de l'administrateur (droit « create serviceaccounts/token » sur
# wb-system/ms-supervision-stockage) : si ce certificat personnel (7 jours) a expiré, le
# renouvellement échoue ; l'échec se voit au plus tard 24 h après, quand la sonde (unité système,
# branchée sur ms-alerte@) signale « KO api » (une unité utilisateur ne peut pas déclencher
# l'unité système ms-alerte@).
[Unit]
Description=MédiSphère : renouvelle le jeton de la sonde du stockage Kubernetes

[Service]
Type=oneshot
ExecStart=%h/src/k8s/outils/kubeconfig-supervision-stockage.sh
