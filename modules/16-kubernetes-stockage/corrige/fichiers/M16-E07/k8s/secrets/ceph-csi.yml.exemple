# secrets/ceph-csi.yml (plateforme/k8s) — MODÈLE EN CLAIR, sans valeur réelle (M16-E06, complété en E07).
# Le vrai fichier est chiffré par Ansible Vault, identité « critique ». Ajout de la seconde clé
# sans fichier en clair : le fichier entier est rechiffré à partir d'un tube.
#
#   admin@adm01:~/src/k8s$ { (cd ~/src/ansible && uv run ansible-vault view --vault-id critique@outils/vault-pass-client.sh ~/src/k8s/secrets/ceph-csi.yml); \
#         printf 'ceph_csi_cephfs_cle: "'; ssh ceph01 'sudo ceph auth get-key client.k8s-cephfs'; printf '"\n'; } \
#       | (cd ~/src/ansible && uv run ansible-vault encrypt --vault-id critique@outils/vault-pass-client.sh \
#            --output ~/src/k8s/secrets/ceph-csi.yml.nouveau -) \
#     && mv ~/src/k8s/secrets/ceph-csi.yml.nouveau ~/src/k8s/secrets/ceph-csi.yml
ceph_csi_rbd_cle: "<CLÉ-DE-CLIENT.K8S>"
ceph_csi_cephfs_cle: "<CLÉ-DE-CLIENT.K8S-CEPHFS>"
