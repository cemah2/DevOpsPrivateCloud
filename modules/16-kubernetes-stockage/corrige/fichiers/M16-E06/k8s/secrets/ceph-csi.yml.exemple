# secrets/ceph-csi.yml (plateforme/k8s) — MODÈLE EN CLAIR, sans valeur réelle (M16-E06).
# Le vrai fichier est chiffré par Ansible Vault, identité « critique » (première ligne :
# $ANSIBLE_VAULT;1.2;AES256;critique) ; il est créé sans jamais exister en clair sur un disque :
#
#   admin@adm01:~/src/k8s$ { printf 'ceph_csi_rbd_cle: "'; ssh ceph01 'sudo ceph auth get-key client.k8s'; printf '"\n'; } \
#       | (cd ~/src/ansible && uv run ansible-vault encrypt --vault-id critique@outils/vault-pass-client.sh \
#            --output ~/src/k8s/secrets/ceph-csi.yml -)
#
# Lu par outils/ceph-csi-secrets.sh. Registre des secrets : « plateforme/k8s secrets/ceph-csi.yml ».
ceph_csi_rbd_cle: "<CLÉ-DE-CLIENT.K8S>"
