// /etc/apt/apt.conf.d/52medisphere-unattended-upgrades — SÉCURITÉ SEULEMENT (M03-E09)
// La liste par défaut (50unattended-upgrades) contient aussi « label=Debian » : les mises à
// jour de version intermédiaire. Une liste d'apt.conf déclarée dans un second fichier
// S'AJOUTE à la première : il faut d'abord la vider avec « #clear ».
// Contrôle : apt-config dump | grep Origins-Pattern
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
};
// Pas de redémarrage automatique : il se planifie (fenêtre de maintenance, M04).
Unattended-Upgrade::Automatic-Reboot "false";
