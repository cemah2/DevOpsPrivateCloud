# ~/.config/workbook/pve-packer.env — accès de Packer à l'API Proxmox (M03-E02).
# Dossier 700, fichier 600, JAMAIS dans un dépôt. Inscrit au registre des secrets.
# Lu par outils/construire.sh (set -a ; . fichier ; set +a) : les variables PKR_VAR_<nom>
# alimentent les variables Packer <nom>. En CI, mêmes noms en variables protégées et masquées.
#
# <IP-PVE01> : une adresse (ou un nom) présente dans le certificat de pve01 (voir M00-E17).
# <NOEUD>    : nom du nœud Proxmox (hostname de pve01).
# <SECRET>   : affiché UNE fois par « pveum user token add » ; le coller ici avec l'éditeur.
PKR_VAR_proxmox_url="https://<IP-PVE01>:8006/api2/json"
PKR_VAR_proxmox_username="wb-packer@pve!packer"
PKR_VAR_proxmox_token="<SECRET>"
PKR_VAR_proxmox_node="<NOEUD>"
