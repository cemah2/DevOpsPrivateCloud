# plateforme/k8s — secrets/loki.yml (Ansible Vault « critique ») : FORME du fichier, valeurs factices.
#   ansible-vault create --vault-id critique@outils/vault-pass-client.sh secrets/loki.yml
# Lu par outils/secrets-k8s.sh (composant « loki ») qui crée le Secret loki-objstore dans l'espace
# journaux (clés LOKI_S3_ACCESS_KEY_ID et LOKI_S3_SECRET_ACCESS_KEY, injectées en variables
# d'environnement de Loki). Identifiants de l'utilisateur RGW « loki » (radosgw-admin, M22-E02).
loki_s3_access_key_id: "EXEMPLE-REMPLACER"
loki_s3_secret_access_key: "EXEMPLE-REMPLACER"
