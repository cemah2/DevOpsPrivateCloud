 import json
 import logging
 import sys
+from contextvars import ContextVar
 from datetime import UTC, datetime
 
+# Identifiant de la requête HTTP en cours (posé par le middleware de app.py). Une variable de
+# contexte suit la requête jusque dans le fil d'exécution des points d'entrée synchrones.
+request_id_courant: ContextVar[str | None] = ContextVar("request_id", default=None)
+
 # Attributs standard d'un LogRecord : tout ce qui n'est pas dedans a été passé
 # par « extra=... » et part tel quel dans la ligne JSON.
 # « color_message » : doublon colorisé ajouté par uvicorn, inutile en JSON.
@@ -40,6 +45,16 @@
         return json.dumps(ligne, ensure_ascii=False, default=str)
 
 
+class FiltreRequete(logging.Filter):
+    """Ajoute ``request_id`` à tout enregistrement émis pendant une requête HTTP."""
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        rid = request_id_courant.get()
+        if rid is not None and not hasattr(record, "request_id"):
+            record.request_id = rid
+        return True
+
