+def test_request_id_genere_et_journalise(client, caplog):
+    from mediagenda.journal import FormateurJson
+
+    with caplog.at_level(logging.INFO, logger="mediagenda"):
+        r = client.post("/api/v1/rendez-vous", json=RDV)
+    rid = r.headers["X-Request-ID"]
+    assert len(rid) == 32
+    lignes = [json.loads(FormateurJson().format(e)) for e in caplog.records]
+    # la ligne d'accès ET la ligne métier (« rendez-vous créé ») portent le même identifiant
+    assert {ligne["message"] for ligne in lignes if ligne.get("request_id") == rid} >= {
+        "requête",
+        "rendez-vous créé",
+    }
+
+
+def test_request_id_recu_conserve_ou_remplace(client):
+    assert (
+        client.get("/sante", headers={"X-Request-ID": "abc-12345678"}).headers["X-Request-ID"]
+        == "abc-12345678"
+    )
+    remplace = client.get("/sante", headers={"X-Request-ID": "x y {inject}"}).headers[
+        "X-Request-ID"
+    ]
+    assert remplace != "x y {inject}" and len(remplace) == 32
