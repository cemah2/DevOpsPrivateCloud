// config.alloy — proposition de Lucas Martin pour remplacer la configuration de l'agent du cluster
// « Plus simple et plus complète : on récupère TOUT, on triera dans Grafana. »

logging {
	level  = "debug"
	format = "logfmt"
}

discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "pods" {
	targets = discovery.kubernetes.pods.targets

	// toutes les étiquettes Kubernetes, comme ça on peut filtrer sur n'importe quoi
	rule {
		action = "labelmap"
		regex  = "__meta_kubernetes_pod_label_(.+)"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		target_label  = "__path__"
		replacement   = "/var/log/pods/*$1/*.log"
	}
}

local.file_match "pods" {
	path_targets = discovery.relabel.pods.output
}

loki.source.file "pods" {
	targets    = local.file_match.pods.targets
	forward_to = [loki.process.tout.receiver]
}

loki.process "tout" {
	stage.docker { }

	stage.json {
		expressions = {
			level   = "",
			route   = "",
			code    = "",
			message = "",
		}
	}

	stage.labels {
		values = {
			level = "",
			route = "",
			code  = "",
		}
	}

	forward_to = [loki.write.loki.receiver]
}

loki.source.journal "noeud" {
	max_age    = "8760h"
	forward_to = [loki.write.loki.receiver]
}

loki.source.kubernetes_events "evenements" {
	forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://10.10.41.62:3100/loki/api/v1/push"

		basic_auth {
			username = "lucas"
			password = "Lucas-M22!"
		}
	}
}
