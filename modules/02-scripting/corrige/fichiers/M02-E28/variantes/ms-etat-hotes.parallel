#!/usr/bin/env bash
# ms-etat-hotes — variante GNU parallel (M02-E28). Comparaison seulement : la version retenue est bin/ms-etat-hotes.
#
# Paquet Debian « parallel » (20240222 sur Debian 13). --keep-order rend la sortie dans l'ordre des
# arguments, --will-cite supprime l'avertissement de citation. Le code retour de parallel est le
# NOMBRE de jobs en échec (plafonné à 101) : on ne s'en sert pas, l'état est dans chaque ligne.

# shellcheck source=../lib/ms-commun.sh disable=SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ms-commun.sh"

readonly COMMANDE_DISTANTE='uname -r; uptime -s; df --output=pcent / | tail -n 1 | tr -d " %"; apt-get -s -o Debug::NoLocking=1 dist-upgrade 2>/dev/null | grep -c "^Inst " || true'

etat_hote() {
  local hote="$1" sortie rc=0 champs
  sortie="$(ssh -n -o BatchMode=yes -o ConnectTimeout=5 "$hote" "$COMMANDE_DISTANTE" 2>/dev/null)" || rc=$?
  if ((rc == 255)); then printf '%s\tinjoignable\t-\t-\t-\t-\n' "$hote"; return 1; fi
  mapfile -t champs <<<"$sortie"
  if ((rc != 0 || ${#champs[@]} != 4)); then printf '%s\terreur\t-\t-\t-\t-\n' "$hote"; return 1; fi
  printf '%s\tok\t%s\t%s\t%s\t%s\n' "$hote" "${champs[@]}"
}

main() {
  set -Eeuo pipefail
  if [[ "${1:-}" == --un ]]; then etat_hote "$2"; exit; fi
  local jobs_max=4
  if [[ "${1:-}" == -j ]]; then jobs_max="$2"; shift 2; fi
  [[ "$jobs_max" =~ ^([1-9]|[12][0-9]|3[0-2])$ ]] || die "-j attend un entier de 1 à 32" 2
  (($# > 0)) || { echo "Usage : ms-etat-hotes [-j N] HOTE..." >&2; exit 2; }
  require_cmd parallel
  local resultats
  # --timeout 30 : un hôte bloqué après la connexion ne bloque pas tout le relevé.
  resultats="$(parallel --will-cite --keep-order --jobs "$jobs_max" --timeout 30 \
    "$(readlink -f "${BASH_SOURCE[0]}")" --un {} ::: "$@" || true)"
  printf '%s\n' "$resultats"
  # Un hôte tué par --timeout n'a pas de ligne : on le compte comme une erreur.
  [[ "$(grep -c . <<<"$resultats")" -eq $# ]] || return 1
  ! cut -f2 <<<"$resultats" | grep -qv '^ok$'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
