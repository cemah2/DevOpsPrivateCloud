# ~/.config/workbook/pbs-lecture.env — jeton Proxmox Backup Server en LECTURE SEULE (M02-E26)
#
# Fichier SECRET : mode 600, jamais dans un dépôt.
#   install -m 600 /dev/null ~/.config/workbook/pbs-lecture.env
# Jeton : rôle DatastoreAudit sur /datastore/ds-lab/par1 (utilisateur ET jeton).

PBS_API_URL="https://10.20.10.10:8007/api2/json"
PBS_DATASTORE="ds-lab"
PBS_NAMESPACE="par1"
PBS_TOKEN_ID="wb-verif@pbs!lecture"
PBS_TOKEN_SECRET="<SECRET-AFFICHE-UNE-SEULE-FOIS>"
# Épingle de la clé publique du certificat de pbs01 (calcul : corrigé de M02-E26)
PBS_PINNEDPUBKEY="sha256//<EMPREINTE-BASE64>"
