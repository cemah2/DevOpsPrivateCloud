# ~/.config/workbook/pve-lecture.env — jeton Proxmox VE en LECTURE SEULE (M02-E26)
#
# Même format que pve-api.env (M00-E17). Fichier SECRET : mode 600, jamais dans un dépôt.
#   install -m 600 /dev/null ~/.config/workbook/pve-lecture.env
# Jeton : rôle PVEAuditor sur /pool/lab, séparation des privilèges.

PVE_API_URL="https://<IP-PVE01>:8006/api2/json"
PVE_NODE="<NOM-DU-NOEUD>"
PVE_TOKEN_ID="wb-automation@pve!lecture"
PVE_TOKEN_SECRET="<SECRET-AFFICHE-UNE-SEULE-FOIS>"
PVE_CACERT="$HOME/.config/workbook/pve-root-ca.pem"
