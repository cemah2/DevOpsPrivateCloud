#!/bin/bash
# ms-archiver-journaux v0.2 — archive les journaux du spool (un tar.gz par hôte), puis vide le spool.
# Auteur : Lucas Martin. Revue de Karim : « mode strict activé, donc ça s'arrête à la moindre erreur ».
# Usage : ms-archiver-journaux [-s SPOOL] [-a ARCHIVES]
set -euo pipefail

BASE="$(dirname "$0")/.."
SPOOL="$BASE/spool"
ARCHIVES="$BASE/archives"
while getopts 's:a:' opt; do
  case "$opt" in
    s) SPOOL="$OPTARG" ;;
    a) ARCHIVES="$OPTARG" ;;
    *) echo "Usage : $0 [-s SPOOL] [-a ARCHIVES]" >&2; exit 2 ;;
  esac
done

if [ ! -f "$SPOOL/.zone-de-test" ]; then
  echo "Spool non marqué : $SPOOL" >&2
  exit 3
fi
mkdir -p "$ARCHIVES"

log() { echo "$(date '+%F %T') $*"; }

purger() {
  local h="$1"
  rm -f "$SPOOL/$h"/*
  log "$h : spool vidé"
}

archiver() {
  local h="$1" archive
  archive="$ARCHIVES/$h-$(date +%Y%m%d).tar.gz"
  tar -C "$SPOOL/$h" -czf "$archive" .
  gzip -t "$archive"
  log "$h : archive $archive vérifiée"
}

n=0
for d in "$SPOOL"/*/; do
  h=$(basename "$d")
  # Un hôte en échec ne doit pas bloquer les autres
  if archiver "$h"; then
    purger "$h"
    n=$((n + 1))
  else
    log "$h : ÉCHEC de l'archivage, spool conservé"
  fi
done

log "Terminé : $n hôte(s) archivé(s)"
