# Chart rendu dans base/rendu/ (lu par outils/rendre-base.sh). Monter de version = changer ces deux
# lignes dans une MR, relancer le script, relire le diff du rendu.
CHART_REF=oci://registry.par1.medisphere.internal/charts/mediagenda
CHART_VERSION=0.5.0
# Digest de l'artefact OCI publié et signé en M17-E08/E12 (helm push l'affiche ; Harbor aussi).
CHART_DIGEST=sha256:<DIGEST-DU-CHART-0.5.0>
