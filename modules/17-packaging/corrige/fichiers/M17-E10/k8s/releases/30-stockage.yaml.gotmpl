# Stockage et données (M16). external-snapshotter est installé par Kustomize
# (composants/snapshot-controller/, M16-E06) : ce n'est pas une release Helm, il reste hors de ce
# fichier. Les fichiers de valeurs sont ceux des modules 14 à 16, à leurs chemins d'origine.
bases:
  - _communs.yaml
---
releases:
  - name: ceph-csi-rbd
    namespace: ceph-csi
    chart: ceph-csi/ceph-csi-rbd
    version: 3.18.1
    labels:
      groupe: stockage
      composant: ceph-csi-rbd
    values:
      - ../composants/ceph-csi/values-rbd.yaml

  - name: ceph-csi-cephfs
    namespace: ceph-csi
    chart: ceph-csi/ceph-csi-cephfs
    version: 3.18.1
    labels:
      groupe: stockage
      composant: ceph-csi-cephfs
    values:
      - ../composants/ceph-csi/values-cephfs.yaml

  - name: cnpg
    namespace: cnpg-system
    chart: cnpg/cloudnative-pg
    version: 0.29.1
    labels:
      groupe: stockage
      composant: cnpg
    values:
      - ../composants/cloudnative-pg/values.yaml

  # Plugin Barman Cloud de CloudNativePG (M16-E18), même espace que l'opérateur.
  - name: plugin-barman-cloud
    namespace: cnpg-system
    chart: cnpg/plugin-barman-cloud
    version: 0.8.1
    labels:
      groupe: stockage
      composant: plugin-barman-cloud
    # Ordre d'une installation neuve : les CRD et le webhook de l'opérateur d'abord.
    needs:
      - cnpg-system/cnpg
    values:
      - ../composants/plugin-barman-cloud/values.yaml

  - name: velero
    namespace: velero
    chart: vmware-tanzu/velero
    version: 12.2.1
    labels:
      groupe: stockage
      composant: velero
    values:
      - ../composants/velero/values.yaml
