# group_vars/role_routeur/pare_feu.yml — EXTRAIT M08-E23 (PLAT-933) : à ajouter à la matrice des flux
# (commune à gw01 et gw02 depuis M07-E24 ; rôle pare_feu). Section « À travers les passerelles ».
# V_STOPUB (ens19.30) existe depuis M07-E25. Définition à ajouter :
#   - {nom: CEPH_NOEUDS, valeur: '{ 10.10.30.51, 10.10.30.52, 10.10.30.53 }', commentaire: "ceph01-03, réseau public"}
pare_feu_transit:
  - {entree: $V_INFRA, sortie: $V_STOPUB, source: $RUNNER01, destination: $CEPH_NOEUDS, proto: tcp, ports: 3300,
     motif: "runner01 → moniteurs de ceph-par1 (msgr2), job de dérive de plateforme/ceph", ref: M08-E23}
  - {entree: $V_INFRA, sortie: $V_STOPUB, source: $RUNNER01, destination: $CEPH_NOEUDS, proto: tcp, ports: 6800-7568,
     motif: "runner01 → gestionnaire actif de ceph-par1 (orch ls), job de dérive", ref: M08-E23}
