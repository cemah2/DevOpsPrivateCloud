# ~/.config/workbook/s3-medidoc-app.env (et s3-medidoc-audit.env) — M08-E12. Mode 600, sur adm01.
# Valeurs : sortie de « aws iam create-access-key --user-name medidoc-app » (profil racine du compte).
# Copie de référence : Vault « lab » (vault_s3_medidoc_app_*). Inscrit au registre des secrets.
AWS_ACCESS_KEY_ID="<CLE-D-ACCES>"
AWS_SECRET_ACCESS_KEY="<CLE-SECRETE>"
AWS_ENDPOINT_URL="https://rgw.par1.medisphere.internal"
AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
