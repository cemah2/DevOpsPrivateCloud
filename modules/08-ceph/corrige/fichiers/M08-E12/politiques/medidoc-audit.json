{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListerTout",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation", "s3:GetBucketVersioning"],
      "Resource": ["arn:aws:s3:::medidoc-documents", "arn:aws:s3:::medidoc-journaux"]
    },
    {
      "Sid": "LireTout",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": ["arn:aws:s3:::medidoc-documents/*", "arn:aws:s3:::medidoc-journaux/*"]
    }
  ]
}
