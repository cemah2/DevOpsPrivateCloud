# /etc/nftables.conf sur pbs01 — ajout M08-E25, chaîne input, à côté des règles de M01-E28 et M06-E28.
# pbs01 n'est pas géré par Ansible (hôte physique de PAR2) : modification à la main, avec les
# précautions de M00-E21 (nft -c -f, session ouverte, retour arrière programmé).
		iifname "wg0" ip saddr 10.10.30.20 tcp dport 8007 accept comment "cephcli01 : sauvegarde de ceph-par1 (M08-E25)"
