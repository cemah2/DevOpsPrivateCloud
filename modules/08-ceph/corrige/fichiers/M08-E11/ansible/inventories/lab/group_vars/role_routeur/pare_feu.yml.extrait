# group_vars/role_routeur/pare_feu.yml — EXTRAIT M08-E11 (PLAT-921) : flux à ajouter à la matrice
# des flux (commune à gw01 et gw02 depuis M07-E24 ; rôle pare_feu), section « À travers les passerelles ».
# V_STOPUB (ens19.30) existe depuis M07-E25. Définition à ajouter :
#   - {nom: RGW_VIP, valeur: 10.10.30.200, commentaire: "rgw.par1.medisphere.internal (ingress cephadm)"}
pare_feu_transit:
  - {entree: $V_INFRA, sortie: $V_STOPUB, source: $RUNNER01, destination: $RGW_VIP, proto: tcp, ports: 443,
     motif: "runner01 → S3 de ceph-par1 (tests de la CI de MédiDoc)", ref: M08-E11}
# Matrice documentaire (docs/socle/matrice-flux.md) : même ligne, avec le ticket PLAT-921.
