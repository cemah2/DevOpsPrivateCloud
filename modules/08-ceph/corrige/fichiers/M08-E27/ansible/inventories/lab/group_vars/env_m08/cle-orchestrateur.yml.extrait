---
# group_vars/env_m08 (rôle ceph_noeud, M08-E02/E03) — EXTRAIT : renouvellement de la clé SSH de
# l'orchestrateur (M08-E27, SEC-953 ; recommandation de CVE-2026-50152). Données PUBLIQUES.
# Le rôle pose ceph_noeud_cle_orchestrateur dans /var/lib/cephadm/.ssh/authorized_keys avec
# « exclusive: true » : la valeur peut contenir plusieurs clés, une par ligne.
#
# Étape 1 (MR, pipeline) : ancienne ET nouvelle clé acceptées.
ceph_noeud_cle_orchestrateur: |
  ssh-ed25519 <ANCIENNE-CLE-PUBLIQUE> ceph-<FSID>
  ssh-ed25519 <NOUVELLE-CLE-PUBLIQUE> ceph-par1-orchestrateur-2026-10
#
# Étape 2 (sur ceph01) : ceph cephadm set-priv-key -i … ; set-pub-key -i … ; check-host sur chaque nœud.
# Étape 3 (MR, pipeline) : la seule nouvelle clé ; l'ancienne disparaît des trois nœuds.
# ceph_noeud_cle_orchestrateur: "ssh-ed25519 <NOUVELLE-CLE-PUBLIQUE> ceph-par1-orchestrateur-2026-10"
