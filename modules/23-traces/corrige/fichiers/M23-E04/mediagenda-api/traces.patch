+"""Traces OpenTelemetry de MédiAgenda (M23-E04).
+
+Tout se règle par les variables d'environnement STANDARD d'OpenTelemetry, posées par la
+plateforme (composant kustomize « telemetrie » de mediagenda/deploiement) ; le code n'ajoute
+aucune variable MEDIAGENDA_* :
+
+- OTEL_SERVICE_NAME            nom du service (mediagenda-api) ;
+- OTEL_RESOURCE_ATTRIBUTES     deployment.environment.name=…,service.namespace=medisphere ;
+- OTEL_EXPORTER_OTLP_ENDPOINT  agent Collector du nœud (http://…:4317, gRPC sans TLS dans le cluster) ;
+- OTEL_TRACES_SAMPLER(_ARG)    échantillonnage en tête (parentbased_traceidratio, M23-E09) ;
+- OTEL_PROPAGATORS             tracecontext,baggage par défaut (W3C) ;
+- OTEL_SDK_DISABLED=true       coupe tout (le SDK ne crée plus que des spans vides).
+
+Sans OTEL_EXPORTER_OTLP_ENDPOINT (poste de développement, tests), les spans sont créées
+(identifiants de trace disponibles) mais rien n'est exporté : pas d'erreur de connexion en boucle
+vers un localhost:4317 qui n'existe pas.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+
+from opentelemetry import trace
+from opentelemetry.exporter.otlp.proto.grpc.trace_exporter import OTLPSpanExporter
+from opentelemetry.instrumentation.psycopg import PsycopgInstrumentor
+from opentelemetry.instrumentation.redis import RedisInstrumentor
+from opentelemetry.sdk.resources import Resource
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import BatchSpanProcessor
+
+journal = logging.getLogger("mediagenda.telemetrie")
+
+# Chemins jamais tracés : sondes de Kubernetes et collecte de Prometheus (une requête toutes les
+# quelques secondes, sans intérêt pour le diagnostic). Expressions rationnelles cherchées dans
+# l'URL complète, séparées par des virgules (format d'excluded_urls de l'instrumentation).
+URLS_EXCLUES = "/sante$,/pret$,/metrics$"
+
+_fournisseur: TracerProvider | None = None
+
+
+def configurer(version: str) -> None:
+    """Installe le fournisseur de traces global et instrumente psycopg et redis.
+
+    À appeler UNE fois, au démarrage du processus, AVANT la création du pool PostgreSQL et du
+    client Valkey : l'instrumentation remplace les fonctions de connexion des bibliothèques.
+    """
+    global _fournisseur
+    if _fournisseur is not None:
+        return
+    # Resource.create lit OTEL_SERVICE_NAME et OTEL_RESOURCE_ATTRIBUTES ; on y ajoute la version
+    # livrée (MEDIAGENDA_VERSION), la même que celle de /sante et de l'étiquette de l'image.
+    ressource = Resource.create({"service.version": version})
+    # L'échantillonneur n'est pas passé : le SDK lit OTEL_TRACES_SAMPLER et OTEL_TRACES_SAMPLER_ARG
+    # (défaut : parentbased_always_on).
+    _fournisseur = TracerProvider(resource=ressource)
+    if os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT") or os.environ.get(
+        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT"
+    ):
+        # Point d'accès, TLS (schéma http:// = sans TLS), en-têtes, délai et compression viennent
+        # des variables OTEL_EXPORTER_OTLP_*. Envoi par lots, en tâche de fond : une requête HTTP
+        # n'attend jamais le Collector.
+        _fournisseur.add_span_processor(BatchSpanProcessor(OTLPSpanExporter()))
+        journal.info("traces exportées en OTLP", extra={"version": version})
+    else:
+        journal.info("OTEL_EXPORTER_OTLP_ENDPOINT absente : traces non exportées")
+    trace.set_tracer_provider(_fournisseur)
+
+    # Une span par requête SQL (nom « SELECT mediagenda », attributs db.*). Les paramètres des
+    # requêtes ne sont PAS enregistrés (capture_parameters=False, valeur par défaut) : ils
+    # contiennent des données de patients. Pas de sqlcommenter : il modifierait le texte des
+    # requêtes envoyées à PostgreSQL.
+    PsycopgInstrumentor().instrument(tracer_provider=_fournisseur)
+    # Une span par commande Valkey (GET, SET, DEL…) ; la valeur des clés n'est pas enregistrée.
+    RedisInstrumentor().instrument(tracer_provider=_fournisseur)
+
+
+def arreter() -> None:
+    """Vide les spans en attente (fin de processus, après l'arrêt propre d'uvicorn)."""
+    if _fournisseur is not None:
+        _fournisseur.shutdown()
