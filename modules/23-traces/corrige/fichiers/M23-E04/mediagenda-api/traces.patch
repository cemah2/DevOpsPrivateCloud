+"""Traces (M23-E04) : spans produites, sondes exclues, contexte W3C repris, aucune donnée patient."""
+
+from __future__ import annotations
+
+import pytest
+from opentelemetry import trace
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import SimpleSpanProcessor
+from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
+
+RDV = {
+    "patient": "Jeanne Dupont",
+    "praticien": "dr-morel",
+    "debut": "2026-11-02T09:00:00+01:00",
+    "motif": "Contrôle annuel",
+}
+
+_EXPORTATEUR = InMemorySpanExporter()
+
+
+@pytest.fixture(scope="module", autouse=True)
+def fournisseur():
+    # Le fournisseur global ne se pose qu'une fois par processus : on le pose ici, pour ce module.
+    fournisseur = TracerProvider()
+    fournisseur.add_span_processor(SimpleSpanProcessor(_EXPORTATEUR))
+    trace.set_tracer_provider(fournisseur)
+    yield fournisseur
+
+
+@pytest.fixture
+def spans():
+    _EXPORTATEUR.clear()
+    yield _EXPORTATEUR
+    _EXPORTATEUR.clear()
+
+
+def _par_nom(exportateur):
+    return {s.name: s for s in exportateur.get_finished_spans()}
+
+
+def test_creation_trace_serveur_et_metier(client, spans):
+    assert client.post("/api/v1/rendez-vous", json=RDV).status_code == 201
+    noms = _par_nom(spans)
+    serveur = noms["POST /api/v1/rendez-vous"]
+    metier = noms["mediagenda.rendez_vous.creer"]
+    assert serveur.kind == trace.SpanKind.SERVER
+    assert metier.parent.span_id == serveur.context.span_id
+    assert metier.attributes["mediagenda.praticien"] == "dr-morel"
+    assert metier.attributes["mediagenda.rendez_vous.id"] == 1
+    assert "mediagenda.cache.invalider" in noms
+
+
+def test_aucune_donnee_patient_dans_les_attributs(client, spans):
+    client.post("/api/v1/rendez-vous", json=RDV)
+    for span in spans.get_finished_spans():
+        for valeur in (span.attributes or {}).values():
+            assert "Jeanne" not in str(valeur)
+            assert "Contrôle" not in str(valeur)
+
+
+def test_sondes_et_metriques_non_tracees(client, spans):
+    for chemin in ("/sante", "/pret", "/metrics"):
+        assert client.get(chemin).status_code == 200
+    assert spans.get_finished_spans() == ()
+
+
+def test_contexte_w3c_repris(client, spans):
+    trace_id = "4bf92f3577b34da6a3ce929d0e0e4736"
+    entete = {"traceparent": f"00-{trace_id}-00f067aa0ba902b7-01"}
+    client.get("/api/v1/creneaux", params={"date": "2026-11-02"}, headers=entete)
+    serveur = _par_nom(spans)["GET /api/v1/creneaux"]
+    assert format(serveur.context.trace_id, "032x") == trace_id
+    assert serveur.attributes["mediagenda.cache.resultat"] == "miss"
+    assert "mediagenda.creneaux.calculer" in _par_nom(spans)
+
+
+def test_conflit_est_un_evenement_pas_une_erreur(client, spans):
+    client.post("/api/v1/rendez-vous", json=RDV)
+    spans.clear()
+    assert client.post("/api/v1/rendez-vous", json=RDV).status_code == 409
+    metier = _par_nom(spans)["mediagenda.rendez_vous.creer"]
+    assert [e.name for e in metier.events] == ["mediagenda.conflit_creneau"]
