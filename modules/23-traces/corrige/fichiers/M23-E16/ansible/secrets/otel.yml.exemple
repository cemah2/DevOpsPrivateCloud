# plateforme/ansible — secrets/otel.yml : STRUCTURE seulement (M23-E16). Le vrai fichier est chiffré par
# « ansible-vault encrypt --vault-id critique@prompt » et n'est jamais commité en clair.
# secrets-k8s.sh (composant « otel ») en tire le Secret traces/otlp-jetons, clé « jetons » :
#   une ligne par émetteur, « <jeton> <nom> » (l'extension bearertokenauth ignore ce qui suit le jeton).
otel_jetons_otlp:
  - nom: adm01-essai
    proprietaire: plateforme
    cree_le: "2026-10-22"
    jeton: "<64 caractères hexadécimaux : openssl rand -hex 32>"
