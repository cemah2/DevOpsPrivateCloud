{
  "uid": "m23-pipeline-traces",
  "title": "Pipeline de traces",
  "tags": [
    "traces",
    "plateforme",
    "m23"
  ],
  "description": "Chaîne application → agents → passerelle → Tempo : ce qui entre, ce qui sort, ce qui se perd (M23-E16, RB-237).",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "RB-237",
      "type": "link",
      "url": "https://git01.par1.medisphere.internal/plateforme/medisphere/-/blob/main/docs/observabilite/traces/runbooks/RB-237-collector-perd-des-donnees.md"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Spans acceptées par Collector (entrée)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (rate({__name__=~\"otelcol_receiver_accepted_spans(_total)?\"}[5m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Spans envoyées par exportateur (sortie)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, exporter) (rate({__name__=~\"otelcol_exporter_sent_spans(_total)?\"}[5m]))",
          "legendFormat": "{{job}} → {{exporter}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pertes : refus, mise en file, envoi",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (rate({__name__=~\"otelcol_receiver_refused_spans(_total)?\"}[5m]))",
          "legendFormat": "refus récepteur {{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (rate({__name__=~\"otelcol_processor_memory_limiter_refused_spans(_total)?\"}[5m]))",
          "legendFormat": "refus memory_limiter {{job}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, exporter) (rate({__name__=~\"otelcol_exporter_enqueue_failed_spans(_total)?\"}[5m]))",
          "legendFormat": "file pleine {{job}}/{{exporter}}"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job, exporter) (rate({__name__=~\"otelcol_exporter_send_failed_spans(_total)?\"}[5m]))",
          "legendFormat": "envoi abandonné {{job}}/{{exporter}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Remplissage des files d'attente",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, exporter) (otelcol_exporter_queue_size / otelcol_exporter_queue_capacity)",
          "legendFormat": "{{job}}/{{exporter}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tempo : octets reçus et spans rejetées",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(tempo_distributor_bytes_received_total[5m]))",
          "legendFormat": "octets reçus/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(tempo_discarded_spans_total[5m]))",
          "legendFormat": "rejet {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mémoire des Collectors (tas Go)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job) (otelcol_process_runtime_heap_alloc_bytes)",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}