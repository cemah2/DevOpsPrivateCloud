# plateforme/k8s — secrets/tempo.yml (Ansible Vault « critique ») : FORME du fichier, valeurs factices.
#   ansible-vault create --vault-id critique@outils/vault-pass-client.sh secrets/tempo.yml
# Lu par outils/secrets-k8s.sh (composant « tempo », sur le modèle des composants thanos et loki) qui
# crée le Secret « tempo-objstore » dans l'espace traces, clés AWS_ACCESS_KEY_ID et AWS_SECRET_ACCESS_KEY
# (injectées en variables d'environnement de Tempo par tempo.extraEnvFrom). Identifiants de
# l'utilisateur RGW « tempo » (radosgw-admin, M23-E03), les mêmes que ~/.config/workbook/s3-tempo.env.
tempo_s3_access_key_id: "EXEMPLE-REMPLACER"
tempo_s3_secret_access_key: "EXEMPLE-REMPLACER"
