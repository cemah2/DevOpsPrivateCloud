+def test_trace_id_dans_le_journal_et_exemplar(client, spans):
+    import json
+    import logging
+
+    from mediagenda.journal import FormateurJson
+
+    class Capture(logging.Handler):
+        """Formate AU MOMENT du log, comme le gestionnaire stdout de production."""
+
+        def __init__(self) -> None:
+            super().__init__(logging.INFO)
+            self.setFormatter(FormateurJson())
+            self.lignes: list[dict] = []
+
+        def emit(self, record: logging.LogRecord) -> None:
+            self.lignes.append(json.loads(self.format(record)))
+
+    capture = Capture()
+    journal_acces = logging.getLogger("mediagenda.acces")
+    journal_acces.addHandler(capture)
+    niveau = journal_acces.level
+    journal_acces.setLevel(logging.INFO)
+    try:
+        client.post("/api/v1/rendez-vous", json=RDV)
+    finally:
+        journal_acces.removeHandler(capture)
+        journal_acces.setLevel(niveau)
+    serveur = _par_nom(spans)["POST /api/v1/rendez-vous"]
+    trace_id = format(serveur.context.trace_id, "032x")
+    assert capture.lignes[-1]["trace_id"] == trace_id
+    assert len(capture.lignes[-1]["span_id"]) == 16
+
+    om = client.get("/metrics", headers={"Accept": "application/openmetrics-text; version=1.0.0"})
+    assert om.headers["content-type"].startswith("application/openmetrics-text")
+    assert f'# {{trace_id="{trace_id}"}}' in om.text
+    texte = client.get("/metrics")
+    assert texte.headers["content-type"].startswith("text/plain")
+    assert "trace_id" not in texte.text
+
+
+def test_pas_de_trace_id_hors_requete():
