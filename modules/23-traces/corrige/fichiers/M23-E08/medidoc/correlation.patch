diff --git a/internal/telemetrie/journal.go b/internal/telemetrie/journal.go
new file mode 100644
index 0000000..066f467
--- /dev/null
+++ b/internal/telemetrie/journal.go
@@ -0,0 +1,34 @@
+package telemetrie
+
+import (
+	"context"
+	"log/slog"
+
+	"go.opentelemetry.io/otel/trace"
+)
+
+// JournalCorrele enveloppe un gestionnaire slog : chaque ligne écrite AVEC un contexte qui porte une
+// span (s.journal.InfoContext(ctx, …), Log(ctx, …)) reçoit trace_id et span_id au format W3C
+// (hexadécimal, 32 et 16 caractères), les mêmes que dans Tempo (M23-E08).
+type JournalCorrele struct{ slog.Handler }
+
+// Handle ajoute les identifiants de la span courante puis délègue.
+func (j JournalCorrele) Handle(ctx context.Context, r slog.Record) error {
+	if sc := trace.SpanContextFromContext(ctx); sc.IsValid() {
+		r.AddAttrs(
+			slog.String("trace_id", sc.TraceID().String()),
+			slog.String("span_id", sc.SpanID().String()),
+		)
+	}
+	return j.Handler.Handle(ctx, r)
+}
+
+// WithAttrs et WithGroup gardent l'enveloppe (sinon journal.With(…) la perdrait).
+func (j JournalCorrele) WithAttrs(a []slog.Attr) slog.Handler {
+	return JournalCorrele{j.Handler.WithAttrs(a)}
+}
+
+// WithGroup : voir WithAttrs.
+func (j JournalCorrele) WithGroup(nom string) slog.Handler {
+	return JournalCorrele{j.Handler.WithGroup(nom)}
+}
diff --git a/internal/telemetrie/journal_test.go b/internal/telemetrie/journal_test.go
new file mode 100644
index 0000000..1f0a27b
--- /dev/null
+++ b/internal/telemetrie/journal_test.go
@@ -0,0 +1,36 @@
+package telemetrie_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log/slog"
+	"testing"
+
+	sdktrace "go.opentelemetry.io/otel/sdk/trace"
+
+	"git01.par1.medisphere.internal/medidoc/medidoc/internal/telemetrie"
+)
+
+func TestJournalCorrele(t *testing.T) {
+	var sortie bytes.Buffer
+	journal := slog.New(telemetrie.JournalCorrele{Handler: slog.NewJSONHandler(&sortie, nil)}).With("composant", "essai")
+	ctx, span := sdktrace.NewTracerProvider().Tracer("essai").Start(context.Background(), "requête")
+	journal.InfoContext(ctx, "dans une requête")
+	span.End()
+	journal.Info("hors requête")
+
+	lignes := bytes.Split(bytes.TrimSpace(sortie.Bytes()), []byte("\n"))
+	var avec, sans map[string]any
+	_ = json.Unmarshal(lignes[0], &avec)
+	_ = json.Unmarshal(lignes[1], &sans)
+	if avec["trace_id"] != span.SpanContext().TraceID().String() || avec["span_id"] != span.SpanContext().SpanID().String() {
+		t.Errorf("trace_id/span_id absents ou faux : %v", avec)
+	}
+	if avec["composant"] != "essai" {
+		t.Error("With() a perdu l'enveloppe")
+	}
+	if _, ok := sans["trace_id"]; ok {
+		t.Error("trace_id hors requête")
+	}
+}
