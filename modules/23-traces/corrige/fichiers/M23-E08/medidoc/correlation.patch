+func TestExemplarEnOpenMetrics(t *testing.T) {
+	ts, enreg := serveurTrace(t)
+	r, err := http.Get(ts.URL + "/documents")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = r.Body.Close()
+	traceID := enreg.Ended()[0].SpanContext().TraceID().String()
+
+	req, _ := http.NewRequest(http.MethodGet, ts.URL+"/metrics", nil)
+	req.Header.Set("Accept", "application/openmetrics-text; version=1.0.0")
+	r, err = http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	corps, _ := io.ReadAll(r.Body)
+	_ = r.Body.Close()
+	if !strings.HasPrefix(r.Header.Get("Content-Type"), "application/openmetrics-text") {
+		t.Fatalf("OpenMetrics attendu, reçu %q", r.Header.Get("Content-Type"))
+	}
+	if !strings.Contains(string(corps), `trace_id="`+traceID+`"`) {
+		t.Errorf("exemplar de la trace %s absent de /metrics", traceID)
+	}
+}
