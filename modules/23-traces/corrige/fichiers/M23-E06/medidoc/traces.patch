M23-E06 (DEV-2406) — MédiDoc : traces OpenTelemetry (SDK Go 1.47, otelhttp 0.72, otelaws 0.72).
Base : medidoc/medidoc tel que livré (apps/medidoc). Sur une branche :
  git apply --index traces.patch       (go.mod et go.sum compris : versions figées)
  go vet ./... && go test ./...
Équivalent pour les seules dépendances :
  go get go.opentelemetry.io/otel@v1.47.0 go.opentelemetry.io/otel/sdk@v1.47.0 \
    go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc@v1.47.0 \
    go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp@v0.72.0 \
    go.opentelemetry.io/contrib/instrumentation/github.com/aws/aws-sdk-go-v2/otelaws@v0.72.0 \
    go.opentelemetry.io/contrib/propagators/autoprop@v0.72.0 && go mod tidy
- internal/telemetrie (nouveau) : fournisseur de traces, exportateur OTLP gRPC, propagateurs (OTEL_PROPAGATORS),
  filtre des sondes ; tests (nom de span = motif de route, contexte W3C repris, aucune donnée de santé) ;
- cmd/medidoc/main.go : traces démarrées avant le client S3, gestionnaire HTTP enveloppé par otelhttp,
  dernières spans envoyées à l'arrêt ;
- internal/stockage/client.go : une span par appel S3 (otelaws) ;
- internal/serveur/serveur.go : attributs medidoc.document.id et medidoc.document.taille sur la span serveur.

diff --git a/cmd/medidoc/main.go b/cmd/medidoc/main.go
index 012d0ca..f0d5315 100644
--- a/cmd/medidoc/main.go
+++ b/cmd/medidoc/main.go
@@ -19,9 +19,12 @@ import (
 	"syscall"
 	"time"
 
+	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
+
 	"git01.par1.medisphere.internal/medidoc/medidoc/internal/config"
 	"git01.par1.medisphere.internal/medidoc/medidoc/internal/serveur"
 	"git01.par1.medisphere.internal/medidoc/medidoc/internal/stockage"
+	"git01.par1.medisphere.internal/medidoc/medidoc/internal/telemetrie"
 )
 
 // version est fixée à la compilation (-ldflags "-X main.version=…").
@@ -49,6 +52,20 @@ func lancer() error {
 	ctx, arreter := signal.NotifyContext(context.Background(), syscall.SIGTERM, syscall.SIGINT)
 	defer arreter()
 
+	// Traces (M23-E06) : avant le client S3, que l'instrumentation AWS enveloppe.
+	arreterTraces, err := telemetrie.Demarrer(ctx, cfg.Version)
+	if err != nil {
+		return fmt.Errorf("traces : %w", err)
+	}
+	defer func() {
+		// Dernières spans envoyées après l'arrêt du serveur (5 s au plus).
+		fin, annulerFin := context.WithTimeout(context.Background(), 5*time.Second)
+		defer annulerFin()
+		if err := arreterTraces(fin); err != nil {
+			journal.Warn("envoi des dernières spans impossible", "erreur", err.Error())
+		}
+	}()
+
 	client, err := stockage.NouveauClient(ctx, stockage.ParamsClient{
 		Endpoint: cfg.Endpoint, Region: cfg.Region, CAFile: cfg.CAFile,
 	})
@@ -58,8 +75,10 @@ func lancer() error {
 	srv := serveur.Nouveau(stockage.NouveauDepot(client, cfg.Bucket), cfg.MaxOctets, cfg.Version, journal)
 
 	httpSrv := &http.Server{
-		Addr:              fmt.Sprintf(":%d", cfg.Port),
-		Handler:           srv.Handler(),
+		Addr: fmt.Sprintf(":%d", cfg.Port),
+		// Une span serveur par requête, nommée d'après le motif de la route (« GET /documents/{id} »),
+		// contexte W3C lu dans les en-têtes entrants ; sondes et /metrics exclues.
+		Handler:           otelhttp.NewHandler(srv.Handler(), "medidoc", otelhttp.WithFilter(telemetrie.HorsSondes)),
 		ReadHeaderTimeout: 10 * time.Second,
 		ReadTimeout:       5 * time.Minute, // téléversements lents
 		WriteTimeout:      5 * time.Minute,
