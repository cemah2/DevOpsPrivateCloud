diff --git a/internal/telemetrie/telemetrie.go b/internal/telemetrie/telemetrie.go
new file mode 100644
index 0000000..1158fce
--- /dev/null
+++ b/internal/telemetrie/telemetrie.go
@@ -0,0 +1,81 @@
+// Package telemetrie installe les traces OpenTelemetry de MédiDoc (M23-E06).
+//
+// Tout se règle par les variables d'environnement STANDARD d'OpenTelemetry, posées par la
+// plateforme (composant kustomize « telemetrie » de medidoc/deploiement) :
+//
+//	OTEL_SERVICE_NAME            medidoc
+//	OTEL_RESOURCE_ATTRIBUTES     deployment.environment.name=…,service.namespace=medisphere
+//	OTEL_EXPORTER_OTLP_ENDPOINT  http://otel-agent-collector.traces.svc.cluster.local:4317 (gRPC sans TLS)
+//	OTEL_TRACES_SAMPLER(_ARG)    lus par le SDK (défaut : parentbased_always_on)
+//	OTEL_PROPAGATORS             lus par autoprop (défaut : tracecontext,baggage)
+//	OTEL_SDK_DISABLED=true       aucune trace
+//
+// Sans OTEL_EXPORTER_OTLP_ENDPOINT (poste de développement, tests), les spans existent (identifiants
+// disponibles pour les journaux) mais ne sont pas exportées.
+package telemetrie
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"os"
+	"strings"
+
+	"go.opentelemetry.io/contrib/propagators/autoprop"
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
+	"go.opentelemetry.io/otel/sdk/resource"
+	sdktrace "go.opentelemetry.io/otel/sdk/trace"
+)
+
+// Arret vide les spans en attente et ferme l'exportateur.
+type Arret func(context.Context) error
+
+// Demarrer installe le fournisseur de traces et le propagateur globaux. À appeler une fois, au
+// démarrage, AVANT de créer le client S3 et le serveur HTTP.
+func Demarrer(ctx context.Context, version string) (Arret, error) {
+	rien := func(context.Context) error { return nil }
+	if strings.EqualFold(strings.TrimSpace(os.Getenv("OTEL_SDK_DISABLED")), "true") {
+		return rien, nil
+	}
+	// Propagation W3C (traceparent, baggage) par défaut ; OTEL_PROPAGATORS peut la changer.
+	otel.SetTextMapPropagator(autoprop.NewTextMapPropagator())
+
+	// Ressource : OTEL_SERVICE_NAME et OTEL_RESOURCE_ATTRIBUTES (WithFromEnv), SDK, et la version
+	// livrée (la même que /healthz). Pas de semconv importé : une seule clé, écrite en clair.
+	res, err := resource.New(ctx,
+		resource.WithFromEnv(),
+		resource.WithTelemetrySDK(),
+		resource.WithAttributes(attribute.String("service.version", version)),
+	)
+	if err != nil && !errors.Is(err, resource.ErrPartialResource) {
+		return rien, err
+	}
+
+	opts := []sdktrace.TracerProviderOption{sdktrace.WithResource(res)}
+	if os.Getenv("OTEL_EXPORTER_OTLP_ENDPOINT") != "" || os.Getenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT") != "" {
+		// Point d'accès, TLS (http:// = sans TLS), en-têtes et délais : variables OTEL_EXPORTER_OTLP_*.
+		// La connexion gRPC est paresseuse : un Collector absent au démarrage ne bloque rien.
+		exp, err := otlptracegrpc.New(ctx)
+		if err != nil {
+			return rien, err
+		}
+		// Envoi par lots en tâche de fond : une requête HTTP n'attend jamais le Collector.
+		opts = append(opts, sdktrace.WithBatcher(exp))
+	}
+	// L'échantillonneur n'est pas passé : le SDK lit OTEL_TRACES_SAMPLER et OTEL_TRACES_SAMPLER_ARG.
+	fournisseur := sdktrace.NewTracerProvider(opts...)
+	otel.SetTracerProvider(fournisseur)
+	return fournisseur.Shutdown, nil
+}
+
+// HorsSondes est le filtre de l'instrumentation HTTP : ni les sondes de Kubernetes ni la collecte
+// de Prometheus ne produisent de span (une requête toutes les quelques secondes, sans intérêt).
+func HorsSondes(r *http.Request) bool {
+	switch r.URL.Path {
+	case "/healthz", "/readyz", "/metrics":
+		return false
+	}
+	return true
+}
