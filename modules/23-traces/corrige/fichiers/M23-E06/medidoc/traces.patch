@@ -0,0 +1,97 @@
+package telemetrie_test
+
+import (
+	"bytes"
+	"io"
+	"log/slog"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"go.opentelemetry.io/contrib/instrumentation/net/http/otelhttp"
+	"go.opentelemetry.io/otel/propagation"
+	sdktrace "go.opentelemetry.io/otel/sdk/trace"
+	"go.opentelemetry.io/otel/sdk/trace/tracetest"
+
+	"git01.par1.medisphere.internal/medidoc/medidoc/internal/serveur"
+	"git01.par1.medisphere.internal/medidoc/medidoc/internal/stockage"
+	"git01.par1.medisphere.internal/medidoc/medidoc/internal/stockage/stockagetest"
+	"git01.par1.medisphere.internal/medidoc/medidoc/internal/telemetrie"
+)
+
+// serveurTrace monte le serveur comme main.go, avec un fournisseur de traces local qui enregistre
+// les spans en mémoire (pas de fournisseur global : les tests restent indépendants).
+func serveurTrace(t *testing.T) (*httptest.Server, *tracetest.SpanRecorder) {
+	t.Helper()
+	enreg := tracetest.NewSpanRecorder()
+	fournisseur := sdktrace.NewTracerProvider(sdktrace.WithSpanProcessor(enreg))
+	log := slog.New(slog.NewJSONHandler(io.Discard, nil))
+	srv := serveur.Nouveau(stockage.NouveauDepot(stockagetest.Nouveau(), "medidoc-documents"), 1<<20, "1.2.3", log)
+	h := otelhttp.NewHandler(srv.Handler(), "medidoc",
+		otelhttp.WithFilter(telemetrie.HorsSondes),
+		otelhttp.WithTracerProvider(fournisseur),
+		otelhttp.WithPropagators(propagation.TraceContext{}),
+	)
+	ts := httptest.NewServer(h)
+	t.Cleanup(ts.Close)
+	return ts, enreg
+}
+
+func TestSondesNonTracees(t *testing.T) {
+	ts, enreg := serveurTrace(t)
+	for _, chemin := range []string{"/healthz", "/readyz", "/metrics"} {
+		r, err := http.Get(ts.URL + chemin)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = r.Body.Close()
+	}
+	if n := len(enreg.Ended()); n != 0 {
+		t.Fatalf("les sondes ne doivent produire aucune span, %d obtenue(s)", n)
+	}
+}
+
+func TestSpanNommeeParLaRouteEtContexteRepris(t *testing.T) {
+	ts, enreg := serveurTrace(t)
+	var corps bytes.Buffer
+	mw := multipart.NewWriter(&corps)
+	_ = mw.WriteField("patient", "PAT-000123")
+	fw, _ := mw.CreateFormFile("fichier", "compte-rendu-échographie.pdf")
+	_, _ = fw.Write([]byte("%PDF-1.7 contenu"))
+	_ = mw.Close()
+	req, _ := http.NewRequest(http.MethodPost, ts.URL+"/documents", &corps)
+	req.Header.Set("Content-Type", mw.FormDataContentType())
+	const traceID = "4bf92f3577b34da6a3ce929d0e0e4736"
+	req.Header.Set("traceparent", "00-"+traceID+"-00f067aa0ba902b7-01")
+	r, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = r.Body.Close()
+	if r.StatusCode != http.StatusCreated {
+		t.Fatalf("code %d", r.StatusCode)
+	}
+
+	spans := enreg.Ended()
+	if len(spans) != 1 {
+		t.Fatalf("une span attendue, %d obtenue(s)", len(spans))
+	}
+	s := spans[0]
+	if s.Name() != "POST /documents" {
+		t.Errorf("nom de span %q, attendu « POST /documents »", s.Name())
+	}
+	if got := s.SpanContext().TraceID().String(); got != traceID {
+		t.Errorf("trace %s, attendue %s (contexte W3C non repris)", got, traceID)
+	}
+	if !s.Parent().IsRemote() {
+		t.Error("le parent devrait être distant (MédiAgenda)")
+	}
+	for _, kv := range s.Attributes() {
+		v := kv.Value.Emit()
+		if strings.Contains(v, "PAT-000123") || strings.Contains(v, "échographie") {
+			t.Errorf("donnée de santé dans l'attribut %s=%s", kv.Key, v)
+		}
+	}
+}
