@@ -0,0 +1,53 @@
+"""Pièces jointes transmises à MédiDoc (M23-E06)."""
+
+from __future__ import annotations
+
+RDV = {
+    "patient": "Jeanne Dupont",
+    "praticien": "dr-morel",
+    "debut": "2026-11-02T09:00:00+01:00",
+}
+PDF = b"%PDF-1.7 compte rendu"
+
+
+def test_piece_jointe_transmise_a_medidoc(client_medidoc, medidoc_simule):
+    assert client_medidoc.post("/api/v1/rendez-vous", json=RDV).status_code == 201
+    r = client_medidoc.post(
+        "/api/v1/rendez-vous/1/pieces-jointes",
+        params={"nom": "ordonnance.pdf"},
+        content=PDF,
+        headers={"content-type": "application/pdf"},
+    )
+    assert r.status_code == 201
+    assert r.json() == {
+        "rdv_id": 1,
+        "document_id": "0123456789abcdef0123456789abcdef",
+        "taille": len(medidoc_simule.requetes[0].content),
+    }
+    envoyee = medidoc_simule.requetes[0]
+    assert envoyee.url.path == "/documents"
+    assert b'name="patient"\r\n\r\nrdv-1' in envoyee.content
+    assert PDF in envoyee.content
+
+
+def test_rendez_vous_absent_404(client_medidoc, medidoc_simule):
+    r = client_medidoc.post("/api/v1/rendez-vous/42/pieces-jointes", content=PDF)
+    assert r.status_code == 404
+    assert medidoc_simule.requetes == []
+
+
+def test_medidoc_en_erreur_502(client_medidoc, medidoc_simule):
+    client_medidoc.post("/api/v1/rendez-vous", json=RDV)
+    medidoc_simule.code = 500
+    r = client_medidoc.post("/api/v1/rendez-vous/1/pieces-jointes", content=PDF)
+    assert r.status_code == 502
+
+
+def test_sans_medidoc_503(client):
+    client.post("/api/v1/rendez-vous", json=RDV)
+    assert client.post("/api/v1/rendez-vous/1/pieces-jointes", content=PDF).status_code == 503
+
+
+def test_corps_vide_400(client_medidoc):
+    client_medidoc.post("/api/v1/rendez-vous", json=RDV)
+    assert client_medidoc.post("/api/v1/rendez-vous/1/pieces-jointes").status_code == 400
