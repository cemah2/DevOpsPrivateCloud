+def test_traceparent_transmis_a_medidoc(settings, depot, cache, medidoc_simule, spans):
+    import httpx
+    from fastapi.testclient import TestClient
+    from opentelemetry.instrumentation.httpx import HTTPXClientInstrumentor
+
+    from mediagenda.app import create_app
+    from mediagenda.documents import ClientMediDoc
+
+    # En production, telemetrie.configurer instrumente le transport HTTP réel de httpx ; le
+    # transport simulé des tests n'en est pas un : on instrumente donc ce client-là.
+    medidoc = ClientMediDoc("http://medidoc.test", transport=httpx.MockTransport(medidoc_simule))
+    HTTPXClientInstrumentor.instrument_client(medidoc._client)
+    with TestClient(create_app(settings, depot=depot, cache=cache, medidoc=medidoc)) as c:
+        c.post("/api/v1/rendez-vous", json=RDV)
+        c.post(
+            "/api/v1/rendez-vous/1/pieces-jointes",
+            content=b"%PDF",
+            headers={"content-type": "application/pdf"},
+        )
+    entete = medidoc_simule.requetes[0].headers["traceparent"]
+    serveur = _par_nom(spans)["POST /api/v1/rendez-vous/{rdv_id}/pieces-jointes"]
+    # Même trace des deux côtés : MédiDoc reprendra ce contexte.
+    assert entete.split("-")[1] == format(serveur.context.trace_id, "032x")
+    assert "mediagenda.piece_jointe.deposer" in _par_nom(spans)
