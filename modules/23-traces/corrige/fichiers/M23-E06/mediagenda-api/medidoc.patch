+# --- MédiDoc simulé (M23-E06) -----------------------------------------------------------------
+class MediDocSimule:
+    """Transport httpx qui imite POST /documents de MédiDoc et garde les requêtes reçues."""
+
+    def __init__(self) -> None:
+        self.requetes: list = []
+        self.code = 201
+
+    def __call__(self, requete):
+        import httpx
+
+        self.requetes.append(requete)
+        if self.code != 201:
+            return httpx.Response(self.code, json={"erreur": "simulée"})
+        return httpx.Response(
+            201, json={"id": "0123456789abcdef0123456789abcdef", "taille": len(requete.content)}
+        )
+
+
+@pytest.fixture
+def medidoc_simule() -> MediDocSimule:
+    return MediDocSimule()
+
