+"""Pièces jointes des rendez-vous, rangées par MédiDoc (M23-E06).
+
+MédiAgenda ne stocke aucun document : il transmet le fichier à MédiDoc (POST /documents) et
+renvoie l'identifiant attribué. Simplification assumée : le champ « patient » de MédiDoc reçoit
+l'identifiant du rendez-vous (« rdv-<id> »), MédiAgenda n'ayant pas d'identifiant de patient.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+
+
+class ErreurMediDoc(Exception):
+    """MédiDoc n'a pas pu enregistrer le document (indisponible ou réponse inattendue)."""
+
+
+class ClientMediDoc:
+    def __init__(self, url: str, transport: httpx.AsyncBaseTransport | None = None) -> None:
+        # Délais courts : un MédiDoc lent ne doit pas retenir les requêtes de MédiAgenda.
+        self._client = httpx.AsyncClient(
+            base_url=url, timeout=httpx.Timeout(10.0, connect=2.0), transport=transport
+        )
+
+    async def deposer(
+        self, rdv_id: int, nom: str, type_contenu: str, contenu: bytes
+    ) -> dict[str, Any]:
+        try:
+            reponse = await self._client.post(
+                "/documents",
+                data={"patient": f"rdv-{rdv_id}"},
+                files={"fichier": (nom, contenu, type_contenu)},
+            )
+        except httpx.HTTPError as exc:
+            raise ErreurMediDoc(f"MédiDoc injoignable : {exc.__class__.__name__}") from exc
+        if reponse.status_code != 201:
+            raise ErreurMediDoc(f"MédiDoc a répondu {reponse.status_code}")
+        return reponse.json()
+
+    async def fermer(self) -> None:
+        await self._client.aclose()
