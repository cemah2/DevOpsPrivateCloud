# secrets/jenkins.yml (plateforme/k8s) — EXEMPLE EN CLAIR (M19-E19, E20). Fichier réel chiffré sous
# l'identité « critique ». Lu par outils/secrets-k8s.sh (lignes « jenkins » de outils/secrets-k8s.conf).
jenkins_admin_utilisateur: "admin"
jenkins_admin_mot_de_passe: "<openssl rand -base64 24>"
jenkins_mot_de_passe_karim: "<openssl rand -base64 24>"
jenkins_mot_de_passe_wb_checks: "<openssl rand -base64 24>"
# M19-E20 : jeton de déploiement GitLab « jenkins-lecture » de mediagenda/api (read_repository).
jenkins_gitlab_lecture_utilisateur: "<NOM-D'UTILISATEUR-DU-JETON-DE-DÉPLOIEMENT>"
jenkins_gitlab_lecture_jeton: "gldt-<JETON>"
