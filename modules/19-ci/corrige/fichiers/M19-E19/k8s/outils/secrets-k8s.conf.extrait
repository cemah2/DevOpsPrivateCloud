# outils/secrets-k8s.conf (plateforme/k8s) — EXTRAIT : lignes ajoutées par M19-E19 (format de E04).
# Jenkins (essai) : admin (controller.admin.existingSecret), autres comptes locaux
# (controller.additionalExistingSecrets → ${jenkins-comptes-<clé>} dans JCasC).
jenkins  jenkins  jenkins-admin    jenkins-admin-user=vault:jenkins_admin_utilisateur jenkins-admin-password=vault:jenkins_admin_mot_de_passe
jenkins  jenkins  jenkins-comptes  karim-benali=vault:jenkins_mot_de_passe_karim wb-checks=vault:jenkins_mot_de_passe_wb_checks
