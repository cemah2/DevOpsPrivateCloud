# plateforme/k8s — secrets/gitlab-runner-protege.yml (M19-E24) : MODÈLE EN CLAIR, à ne jamais
# committer tel quel. Le vrai fichier est chiffré par Ansible Vault, identité « critique » :
#   uv run --project ~/src/ansible ansible-vault encrypt --vault-id critique@$HOME/src/ansible/outils/vault-pass-client.sh secrets/gitlab-runner-protege.yml
# Lu par outils/secrets-k8s.sh (composant « gitlab-runner-protege ») → Secret
# gitlab-runner/gitlab-runner-protege-jeton (clés runner-token et runner-registration-token vide).
espace: gitlab-runner
secret: gitlab-runner-protege-jeton
donnees:
  runner-token: "glrt-<JETON-DU-RUNNER-PROTEGE>"
  runner-registration-token: ""
