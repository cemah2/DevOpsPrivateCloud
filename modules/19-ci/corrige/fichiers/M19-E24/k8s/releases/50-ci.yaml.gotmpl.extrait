# releases/50-ci.yaml.gotmpl (plateforme/k8s) — EXTRAIT : release ajoutée par M19-E24 (SEC-2024) sous
# « gitlab-runner » (E04), « buildkitd » (E08) et « gitlab-agent » (E18). Même chart, même version que
# « gitlab-runner » (une seule ligne à changer par release à la montée de version, E26).
# Avant le premier apply : espaces/ci-jobs-protege/ (task appliquer), puis
# « outils/secrets-k8s.sh appliquer gitlab-runner-protege » (Secret gitlab-runner-protege-jeton) et
# « outils/secrets-k8s.sh appliquer cosign-ci » (Secret ci-jobs-protege/cosign-medisphere) :
# Helmfile ne crée ni l'espace des jobs ni les Secrets.
releases:
  # … gitlab-runner, buildkitd, gitlab-agent …
  - name: gitlab-runner-protege
    namespace: gitlab-runner
    chart: gitlab/gitlab-runner
    version: 0.93.0                  # = celle de la release gitlab-runner ; 0.94.x en M19-E26
    labels:
      groupe: ci
      composant: gitlab-runner-protege
    rollbackOnFailure: true
    values:
      - ../composants/gitlab-runner-protege/values.yaml
