# outils/secrets-k8s.conf (plateforme/k8s) — EXTRAIT : lignes ajoutées par M19-E24 (format de M19-E04).
# Le script outils/secrets-k8s.sh n'est pas modifié : on ajoute deux composants à sa table.
#   admin@adm01:~/src/k8s$ outils/secrets-k8s.sh appliquer gitlab-runner-protege
#   admin@adm01:~/src/k8s$ outils/secrets-k8s.sh appliquer cosign-ci
#   admin@adm01:~/src/k8s$ outils/secrets-k8s.sh verifier cosign-ci

# Runner k8s-par1-protege (chart gitlab/gitlab-runner : runners.secret). La racine MédiSphère du
# gestionnaire est le Secret gitlab-runner-certs de M19-E04 (même espace gitlab-runner), réutilisé.
gitlab-runner-protege  gitlab-runner    gitlab-runner-protege-jeton  runner-token=vault:gitlab_runner_protege_jeton runner-registration-token=vide:
# Clé de signature MédiSphère (M13), montée par le SEUL runner protégé dans ses pods de job.
cosign-ci              ci-jobs-protege  cosign-medisphere            cosign.key=vault:cosign_cle_privee cosign.password=vault:cosign_mot_de_passe
