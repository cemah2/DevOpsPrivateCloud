# plateforme/ci-templates — templates/securite/template.yml, version v2.8.0 (M19-E29, SEC-2029).
# EXTRAIT : différences avec la v2.7.0 (M19-E24), elle-même dérivée de la v2.3.0 (M19-E15).
#   - securite:sbom extrait AUSSI le prédicat de provenance SLSA v1 de BuildKit de l'archive ;
#   - securite:signature (runner protégé) ajoute les attestations SBOM (spdxjson) et provenance
#     (slsaprovenance1), sur l'index, après les signatures ;
#   - securite:verification vérifie la signature ET les deux attestations, comme le fera la porte.
# Interface avec construction-image (E10) : image.tar et IMAGE_EMPREINTE (dotenv) de image:construction,
# IMAGE_REF (dotenv) de image:publication. Entrées : celles de la v2.7.0, inchangées.
spec:
  inputs:
    # … entrées de la v2.7.0 inchangées …
---
# … securite:semgrep, securite:gitleaks, .securite-v2-base, .securite-v2-toujours, .securite-v2-publiee,
#   securite:trivy inchangés …

securite:sbom:
  extends: [.securite-v2-base, .securite-v2-toujours]
  stage: $[[ inputs.stage_analyse ]]
  interruptible: true
  needs:
    - job: "$[[ inputs.job_construction ]]"
      artifacts: true
  script:
    - syft version
    - syft scan oci-archive:image.tar --platform "$[[ inputs.plateforme_analyse ]]" --quiet -o spdx-json=sbom.spdx.json -o cyclonedx-json=sbom.cdx.json
    - jq -e '.spdxVersion == "SPDX-2.3" and (.packages | length) > 0' sbom.spdx.json > /dev/null
    # v2.8.0 : prédicat de provenance extrait de l'archive (le manifeste d'attestation de BuildKit
    # n'est jamais servi par Harbor sous la politique « signature exigée », M13-E09).
    - |
      tar -xOf image.tar "blobs/sha256/${IMAGE_EMPREINTE#sha256:}" > index-archive.json
      att="$(jq -r '[.manifests[] | select(.annotations["vnd.docker.reference.type"] == "attestation-manifest")][0].digest // empty' index-archive.json)"
      if [ -z "$att" ]; then
        echo "aucune attestation de provenance dans l'index (construction sans attest:provenance=mode=max ?)"
        exit 1
      fi
      couche="$(tar -xOf image.tar "blobs/sha256/${att#sha256:}" \
        | jq -r '[.layers[] | select(.annotations["in-toto.io/predicate-type"] == "https://slsa.dev/provenance/v1")][0].digest')"
      tar -xOf image.tar "blobs/sha256/${couche#sha256:}" | jq -e '.predicate' > provenance.json
      jq -r '"provenance : buildType=" + .buildDefinition.buildType' provenance.json
  artifacts:
    paths: [sbom.spdx.json, sbom.cdx.json, provenance.json]
    expire_in: 1 year

securite:signature:
  extends: [.securite-v2-base, .securite-v2-publiee]
  tags: ["$[[ inputs.runner_protege ]]"]
  stage: $[[ inputs.stage ]]
  interruptible: false
  needs:
    - job: "$[[ inputs.job_construction ]]"
      artifacts: true
    - job: "$[[ inputs.job_publication ]]"
      artifacts: true
    - job: securite:sbom
      artifacts: true
  variables:
    DOCKER_CONFIG: /tmp/auth-registre
  script:
    - echo "composant securite $[[ component.version ]] sur $CI_RUNNER_DESCRIPTION"
    - case "${IMAGE_REF:-}" in *@sha256:*) ;; *) echo "IMAGE_REF doit désigner une empreinte (reçu « ${IMAGE_REF:-} »)"; exit 1 ;; esac
    # L'image publiée est celle de l'archive analysée, décrite par le SBOM et la provenance.
    - test "${IMAGE_REF#*@}" = "$IMAGE_EMPREINTE" || { echo "IMAGE_REF ne désigne pas l'image construite"; exit 1; }
    - |
      if [ ! -r "$[[ inputs.cle_cosign ]]" ]; then
        echo "clé de signature absente de $[[ inputs.cle_cosign ]] : ce job doit tourner sur le runner protégé"
        exit 1
      fi
    - mkdir -p "$DOCKER_CONFIG" && chmod 700 "$DOCKER_CONFIG"
    - printf '%s' "$HARBOR_ROBOT_TOKEN" | cosign login "${IMAGE_REF%%/*}" -u "$HARBOR_ROBOT_USER" --password-stdin > /dev/null
    - COSIGN_PASSWORD="$(cat "$[[ inputs.mot_de_passe_cosign ]]")"; export COSIGN_PASSWORD
    # … boucle d'attente de l'analyse de Harbor de la v2.3.0, inchangée …
    - SIGNER=(--key "$[[ inputs.cle_cosign ]]" --signing-config /etc/medisphere/signing-config.json)
    - cosign sign "${SIGNER[@]}" "$IMAGE_REF"
    - |
      depot="${IMAGE_REF%@*}"
      tar -xOf image.tar "blobs/sha256/${IMAGE_EMPREINTE#sha256:}" > index-archive.json
      for m in $(jq -r '.manifests[] | select((.platform.os // "unknown") != "unknown") | .digest' index-archive.json); do
        cosign sign "${SIGNER[@]}" "$depot@$m"
      done
    # Attestations sur l'index : SBOM SPDX et provenance SLSA v1 de BuildKit.
    - cosign attest "${SIGNER[@]}" --type spdxjson --predicate sbom.spdx.json "$IMAGE_REF"
    - cosign attest "${SIGNER[@]}" --type slsaprovenance1 --predicate provenance.json "$IMAGE_REF"
  after_script:
    - rm -rf /tmp/auth-registre

securite:verification:
  extends: [.securite-v2-base, .securite-v2-publiee]
  stage: $[[ inputs.stage ]]
  needs:
    - job: "$[[ inputs.job_publication ]]"
      artifacts: true
    - job: securite:signature
      artifacts: false
  variables:
    DOCKER_CONFIG: /tmp/auth-registre
  script:
    - mkdir -p "$DOCKER_CONFIG" && chmod 700 "$DOCKER_CONFIG"
    - printf '%s' "$HARBOR_ROBOT_TOKEN" | cosign login "${IMAGE_REF%%/*}" -u "$HARBOR_ROBOT_USER" --password-stdin > /dev/null
    - VERIFIER=(--key /etc/medisphere/cosign.pub --insecure-ignore-tlog=true)
    - cosign verify "${VERIFIER[@]}" "$IMAGE_REF" > /dev/null
    - cosign verify-attestation "${VERIFIER[@]}" --type spdxjson "$IMAGE_REF" > /dev/null
    - cosign verify-attestation "${VERIFIER[@]}" --type slsaprovenance1 "$IMAGE_REF" > /dev/null
    - cosign tree "$IMAGE_REF"
    - echo "Publiée, signée, attestée, vérifiée -> $IMAGE_REF ($IMAGE_ETIQUETTE)"
  after_script:
    - rm -rf /tmp/auth-registre
