# plateforme/k8s — releases/50-ci.yaml.gotmpl : changements de M19-E26 (CHG-2026).
# Trois lignes « version » et une valeur de l'agent ; tout le reste est inchangé.
releases:
  - name: gitlab-runner
    namespace: gitlab-runner
    chart: gitlab/gitlab-runner
    version: 0.94.0          # était 0.93.0 (Runner 19.4.0) → Runner 19.5.0 ; prends le dernier 0.94.z
    # …
  - name: gitlab-runner-protege
    namespace: gitlab-runner
    chart: gitlab/gitlab-runner
    version: 0.94.0          # toujours la même que gitlab-runner
    # …
  - name: gitlab-agent
    namespace: gitlab-agent
    chart: gitlab/gitlab-agent
    version: 2.33.0          # appVersion v19.5.0 (index https://charts.gitlab.io) ; était 2.32.0 (v19.4.0)
    # …
