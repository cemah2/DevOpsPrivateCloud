---
# secrets/gitlab-runner.yml (plateforme/k8s) — EXEMPLE EN CLAIR (M19-E04, complété en M19-E07). Le fichier réel est
# chiffré sous l'identité « critique » ; on ne l'édite qu'avec ansible-vault, depuis ~/src/ansible :
#   uv run ansible-vault create --encrypt-vault-id critique ../k8s/secrets/gitlab-runner.yml
#   uv run ansible-vault edit ../k8s/secrets/gitlab-runner.yml
# Lu par outils/secrets-k8s.sh (table outils/secrets-k8s.conf).

# Jeton d'authentification du runner d'instance k8s-par1 (POST /api/v4/user/runners, M19-E04).
gitlab_runner_jeton: "glrt-<JETON>"

# M19-E07 : clés de l'identité ci-cache de s3-01 (cache des runners). Mêmes valeurs que
# vault_seaweedfs_ci_cache_* de plateforme/ansible (host_vars/s3-01/vault.yml).
ci_cache_cle_acces: "<CLE-ACCES-CI-CACHE>"
ci_cache_cle_secrete: "<CLE-SECRETE-CI-CACHE>"
