# outils/secrets-k8s.conf (plateforme/k8s) — EXTRAIT : ligne ajoutée par M19-E20 (format de E04).
# Jeton de déploiement GitLab « jenkins-lecture » de mediagenda/api, lu par JCasC
# (${jenkins-gitlab-utilisateur}, ${jenkins-gitlab-jeton}) ; variables dans secrets/jenkins.yml.
jenkins  jenkins  jenkins-gitlab  utilisateur=vault:jenkins_gitlab_lecture_utilisateur jeton=vault:jenkins_gitlab_lecture_jeton
