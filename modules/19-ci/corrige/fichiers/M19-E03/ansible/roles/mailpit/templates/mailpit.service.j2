# {{ mailpit_entete }}
[Unit]
Description=Mailpit {{ mailpit_version }} — messagerie du lab MédiSphère (SMTP 25, interface 8025)
Documentation=https://mailpit.axllent.org/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ mailpit_utilisateur }}
Group={{ mailpit_groupe }}
EnvironmentFile={{ mailpit_dossier_config }}/mailpit.env
ExecStart={{ mailpit_binaire }}
Restart=on-failure
RestartSec=5s

# Port 25 sans root : la seule capacité donnée au processus (et la seule qu'il peut avoir).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Système de fichiers : tout en lecture seule, sauf la base.
ProtectSystem=strict
ReadWritePaths={{ mailpit_dossier_donnees }}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077

# Noyau, processus, réseau
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
