# {{ mailpit_entete }}
# Options de Mailpit {{ mailpit_version }} (variables MP_…, documentation « Runtime options »).
# AUCUN secret ici : les mots de passe sont dans {{ mailpit_dossier_config }}/ui-auth (bcrypt).
MP_LABEL="{{ mailpit_label }}"
MP_DATABASE={{ mailpit_dossier_donnees }}/mailpit.db
MP_MAX_MESSAGES={{ mailpit_max_messages }}
MP_MAX_AGE={{ mailpit_max_age }}
# Pas de requête vers GitHub au démarrage : la version est pilotée par l'inventaire.
MP_DISABLE_VERSION_CHECK=true

# SMTP : port 25, STARTTLS {{ 'obligatoire' if mailpit_smtp_starttls_obligatoire else 'proposé' }}. Aucune authentification
# demandée (les clients du lab n'en ont pas), aucun relais ni renvoi configuré : rien ne sort.
MP_SMTP_BIND_ADDR={{ mailpit_smtp_ecoute }}
MP_SMTP_TLS_CERT={{ mailpit_tls_certificat }}
MP_SMTP_TLS_KEY={{ mailpit_tls_cle }}
MP_SMTP_REQUIRE_STARTTLS={{ mailpit_smtp_starttls_obligatoire | bool | lower }}

# Interface et API : HTTPS, authentification basique, noms d'hôte autorisés.
MP_UI_BIND_ADDR={{ mailpit_ui_ecoute }}
MP_UI_TLS_CERT={{ mailpit_tls_certificat }}
MP_UI_TLS_KEY={{ mailpit_tls_cle }}
MP_UI_AUTH_FILE={{ mailpit_dossier_config }}/ui-auth
MP_ALLOWED_HOSTS={{ mailpit_noms_autorises | join(',') }}
