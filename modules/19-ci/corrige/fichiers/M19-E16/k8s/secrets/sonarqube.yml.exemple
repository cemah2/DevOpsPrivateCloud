# secrets/sonarqube.yml (plateforme/k8s) — EXEMPLE EN CLAIR (M19-E16). Le fichier réel est chiffré
# sous l'identité « critique » (uv run ansible-vault create --encrypt-vault-id critique …).
# Lu par outils/secrets-k8s.sh (lignes « sonarqube » de outils/secrets-k8s.conf) et, pour le mot de
# passe admin, par toi depuis adm01 (ansible-vault view) : il n'entre pas dans le cluster.

# Code des sondes du chart (X-Sonar-Passcode de /api/system/liveness) : 32 caractères aléatoires.
sonarqube_code_supervision: "<openssl rand -hex 16>"
# Mot de passe du compte admin, posé à la première connexion (API api/users/change_password).
sonarqube_mot_de_passe_admin: "<openssl rand -base64 24>"
