# RabbitMQ « sauvegarde-definitions » et l'identité S3 du compartiment messagerie-definitions. Chemin par
# chemin, comme pour wb-checks (M27-E03) : jamais « kv/data/plateforme/rabbitmq/* ».
path "kv/data/plateforme/rabbitmq/sauvegarde-definitions" {
  capabilities = ["read"]
}
path "kv/data/plateforme/rabbitmq/messagerie-definitions-s3" {
  capabilities = ["read"]
}
