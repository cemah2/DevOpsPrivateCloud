# /etc/systemd/system/patroni.service (géré par Ansible, M27-E13), d'après l'unité fournie par Patroni.
[Unit]
Description=Patroni : PostgreSQL haute disponibilité ({{ patroni_scope }})
After=network-online.target etcd.service
Wants=network-online.target

[Service]
Type=simple
User=postgres
Group=postgres
ExecStart={{ patroni_venv }}/bin/patroni /etc/patroni/patroni.yml
ExecReload=/bin/kill -s HUP $MAINPID
# Ne tuer que Patroni : il arrête PostgreSQL proprement lui-même.
KillMode=process
TimeoutSec=30
# Pas de redémarrage automatique : un Patroni qui meurt ne doit pas revenir en boucle avec un état douteux.
Restart=no

[Install]
WantedBy=multi-user.target
