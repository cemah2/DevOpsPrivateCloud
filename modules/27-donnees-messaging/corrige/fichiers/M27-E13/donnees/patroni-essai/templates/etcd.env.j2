# /etc/default/etcd — {{ inventory_hostname }} (géré par Ansible, M27-E13). Variables ETCD_* lues par etcd.
# Essai : HTTP sans TLS ni authentification, dans le seul VLAN vsandbox.
ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="/var/lib/etcd/{{ inventory_hostname }}"
ETCD_LISTEN_PEER_URLS="http://{{ ansible_host }}:2380"
ETCD_LISTEN_CLIENT_URLS="http://{{ ansible_host }}:2379,http://127.0.0.1:2379"
ETCD_INITIAL_ADVERTISE_PEER_URLS="http://{{ ansible_host }}:2380"
ETCD_ADVERTISE_CLIENT_URLS="http://{{ ansible_host }}:2379"
ETCD_INITIAL_CLUSTER="{% for h in groups['pg_essai'] %}{{ h }}=http://{{ hostvars[h].ansible_host }}:2380{{ ',' if not loop.last else '' }}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="{{ etcd_jeton_grappe }}"
