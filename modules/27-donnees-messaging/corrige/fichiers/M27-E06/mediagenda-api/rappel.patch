 from __future__ import annotations
 
+import re
 from datetime import date, datetime
+from typing import Literal, Self
 
-from pydantic import AwareDatetime, BaseModel, Field
+from pydantic import AwareDatetime, BaseModel, Field, model_validator
+
+# Mêmes formats que ceux qu'accepte MédiNotif (apps/medinotif, message.py) : un rappel que
+# MédiNotif refuserait est refusé dès la prise de rendez-vous (422), pas au moment d'envoyer.
+_TELEPHONE = re.compile(r"^\+?[0-9][0-9 .]{5,19}$")
+_COURRIEL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+
+
+class Rappel(BaseModel):
+    """Choix du patient pour les rappels (M27-E06, DEV-2806).
+
+    Le consentement est explicite : sans choix, « aucun » (pas de rappel). Le contact est
+    une donnée personnelle : il n'apparaît jamais dans un journal ni dans une trace.
+    """
+
+    canal: Literal["sms", "mail", "aucun"] = "aucun"
+    contact: str | None = Field(default=None, max_length=254)
+
+    @model_validator(mode="after")
+    def _coherence(self) -> Self:
+        if self.canal == "aucun":
+            if self.contact is not None:
+                raise ValueError("contact interdit quand canal vaut « aucun »")
+        elif self.contact is None:
+            raise ValueError(f"contact obligatoire pour le canal {self.canal}")
+        elif self.canal == "sms" and not _TELEPHONE.fullmatch(self.contact):
+            raise ValueError("numéro de téléphone invalide")
+        elif self.canal == "mail" and not _COURRIEL.fullmatch(self.contact):
+            raise ValueError("adresse de courriel invalide")
+        return self
 
 
