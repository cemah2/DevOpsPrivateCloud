@@ -0,0 +1,68 @@
+"""Rappel du patient (M27-E06, DEV-2806) : validation, valeurs par défaut, persistance simulée."""
+
+from __future__ import annotations
+
+import pytest
+from pydantic import ValidationError
+
+from mediagenda.depot import _depuis_ligne
+from mediagenda.modeles import Rappel
+
+RDV = {"patient": "Jeanne Dupont", "praticien": "dr-morel", "debut": "2026-11-02T09:00:00+01:00"}
+
+
+def test_sans_rappel_par_defaut(client):
+    cree = client.post("/api/v1/rendez-vous", json=RDV)
+    assert cree.status_code == 201
+    assert cree.json()["rappel"] == {"canal": "aucun", "contact": None}
+
+
+@pytest.mark.parametrize(
+    ("rappel", "attendu"),
+    [
+        ({"canal": "sms", "contact": "+33612345678"}, 201),
+        ({"canal": "mail", "contact": "jeanne@exemple.fr"}, 201),
+        ({"canal": "sms"}, 422),  # contact manquant
+        ({"canal": "mail", "contact": "pas-un-courriel"}, 422),
+        ({"canal": "sms", "contact": "appelez-moi"}, 422),
+        ({"canal": "aucun", "contact": "+33612345678"}, 422),  # contact sans consentement
+        ({"canal": "pigeon", "contact": "x"}, 422),
+    ],
+)
+def test_validation_du_rappel(client, rappel, attendu):
+    assert client.post("/api/v1/rendez-vous", json={**RDV, "rappel": rappel}).status_code == attendu
+
+
+def test_rappel_relu(client):
+    rdv_id = client.post(
+        "/api/v1/rendez-vous", json={**RDV, "rappel": {"canal": "sms", "contact": "+33612345678"}}
+    ).json()["id"]
+    assert client.get(f"/api/v1/rendez-vous/{rdv_id}").json()["rappel"]["canal"] == "sms"
+
+
+def test_contact_jamais_journalise(client, caplog):
+    client.post(
+        "/api/v1/rendez-vous", json={**RDV, "rappel": {"canal": "sms", "contact": "+33612345678"}}
+    )
+    assert "33612345678" not in caplog.text
+
+
+def test_ligne_de_la_base_vers_le_modele():
+    ligne = {
+        "id": 3,
+        "patient": "P",
+        "praticien": "dr-x",
+        "debut": "2026-11-02T09:00:00+01:00",
+        "duree_minutes": 30,
+        "motif": None,
+        "cree_le": "2026-10-23T10:00:00+00:00",
+        "canal_rappel": "mail",
+        "contact_rappel": "p@exemple.fr",
+    }
+    rdv = _depuis_ligne(ligne)
+    assert rdv.rappel == Rappel(canal="mail", contact="p@exemple.fr")
+
+
+def test_modele_refuse_l_incoherence():
+    with pytest.raises(ValidationError):
+        Rappel(canal="mail")
