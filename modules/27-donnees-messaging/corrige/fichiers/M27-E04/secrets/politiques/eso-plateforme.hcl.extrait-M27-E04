# À AJOUTER à politiques/eso-plateforme.hcl — plateforme/secrets (M27-E04, DEV-2804).
# EXCEPTION ÉCRITE à la règle « le magasin de plateforme ne lit pas les secrets des équipes » :
# les utilisateurs RabbitMQ sont créés par la PLATEFORME dans l'espace messagerie (Topology
# Operator), avec le mot de passe que l'application lira de son côté. Seul le secret AMQP est lu,
# chemin par chemin (jamais kv/data/medinotif/*). Validée par Sophie Laurent (SEC-2804).
path "kv/data/medinotif/recette/amqp" {
  capabilities = ["read"]
}

path "kv/data/mediagenda/recette/amqp" {
  capabilities = ["read"]
}
