# tofu/eso-espaces.tf — plateforme/secrets : EXTRAIT (M27-E04 ; medinotif-prod en E08)
# Un rôle k8s-par1 et une politique eso-<espace> de plus : kv/medinotif/recette/* seulement.
locals {
  espaces_eso = {
    # … entrées du M25 (mediagenda-*, medidoc-*) …
    "medinotif-recette" = { application = "medinotif", environnement = "recette", chemins_creds = [] }
  }
}
