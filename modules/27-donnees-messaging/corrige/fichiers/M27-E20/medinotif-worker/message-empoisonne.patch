+def test_echec_passager_rejete_avec_remise_en_file(monkeypatch):
+    """Un échec passager est un basic.reject (compté par la limite de livraison), pas un nack."""
+    canal = FauxCanal([SMS, None])
+    source = source_avec(canal)
+    monkeypatch.setattr(source._arret, "wait", lambda _t: source._arret.is_set())
+    canal_consume = canal.consume
+
+    def consume(*a, **k):
+        for item in canal_consume(*a, **k):
+            if item[0] is None:
+                source.arreter()
+            yield item
+
+    canal.consume = consume
+    source.consommer(lambda _corps: Resultat.ECHEC)
+    assert canal.reject == [(1, True)]
+    assert canal.nack == []
