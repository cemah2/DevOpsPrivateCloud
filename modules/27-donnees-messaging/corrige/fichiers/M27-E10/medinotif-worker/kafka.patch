+@pytest.mark.integration
+def test_vrai_kafka():
+    bootstrap = os.environ.get("MEDINOTIF_TEST_KAFKA_BOOTSTRAP")
+    if not bootstrap:
+        pytest.skip("MEDINOTIF_TEST_KAFKA_BOOTSTRAP non définie")
+    from confluent_kafka import Consumer, Producer
+    from confluent_kafka.admin import AdminClient, NewTopic
+
+    suffixe = uuid.uuid4().hex[:8]
+    topic, rebut = f"essai-{suffixe}", f"essai-rebut-{suffixe}"
+    admin = AdminClient({"bootstrap.servers": bootstrap})
+    for f in admin.create_topics([NewTopic(topic, 1, 1), NewTopic(rebut, 1, 1)]).values():
+        f.result(10)
+    producteur = Producer({"bootstrap.servers": bootstrap})
+    for corps in (SMS, b"invalide", SMS):
+        producteur.produce(topic, corps)
+    producteur.flush(10)
+
+    source = SourceKafka(
+        configuration_client(bootstrap), topic=topic, groupe=f"g-{suffixe}", topic_rebut=rebut
+    )
+    vus = []
+
+    def traiter(corps):
+        resultat = Traiteur(ExpediteurSimule(0))(corps)
+        vus.append(resultat)
+        if len(vus) == 3:
+            source.arreter()
+        return resultat
+
+    source.consommer(traiter)
+    assert vus == [Resultat.ENVOYE, Resultat.INVALIDE, Resultat.ENVOYE]
+    lecteur = Consumer(
+        {
+            "bootstrap.servers": bootstrap,
+            "group.id": f"l-{suffixe}",
+            "auto.offset.reset": "earliest",
+        }
+    )
+    lecteur.subscribe([rebut])
+    message = None
+    for _ in range(20):
+        message = lecteur.poll(1.0)
+        if message is not None and message.error() is None:
+            break
+    assert message is not None and message.value() == b"invalide"
+    # offsets validés du groupe : 3 (après le dernier message)
+    from confluent_kafka import TopicPartition
+
+    validation = Consumer({"bootstrap.servers": bootstrap, "group.id": f"g-{suffixe}"})
+    assert validation.committed([TopicPartition(topic, 0)], timeout=10)[0].offset == 3
+    lecteur.close()
+    validation.close()
