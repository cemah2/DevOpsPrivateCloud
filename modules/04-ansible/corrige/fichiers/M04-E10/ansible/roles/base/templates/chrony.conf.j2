{{ base_entete | comment }}
#
# chrony, client de temps du lab MédiSphère (rôle base, M04-E10 ; modèle de M04-E08).
# Base : /etc/chrony/chrony.conf de Debian 13 (chrony 4.6). Différences :
#   - sources = base_ntp_serveurs (ms_serveurs_ntp de l'inventaire : passerelle du VLAN,
#     PLAN.md §4.3 bis),
#     jamais les pools Internet ;
#   - pas de « sourcedir » : aucune source déposée à côté d'Ansible (fichier posé à la
#     main en M00-E31, sources fournies par DHCP) n'est prise en compte.
# Validé avant installation par : chronyd -p -f <fichier>

{% for serveur in base_ntp_serveurs %}
server {{ serveur }} iburst
{% endfor %}

# Clés d'authentification NTP, fréquence de dérive mesurée, clés et cookies NTS.
keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony

# Journaux (désactivés) : log tracking measurements statistics
logdir /var/log/chrony

# Ignorer les estimations trop incertaines ; recopier l'heure dans l'horloge matérielle.
maxupdateskew 100.0
rtcsync

# Saut d'horloge autorisé (écart > 1 s) pendant les trois premières mises à jour
# seulement : utile pour une VM restaurée ou restée longtemps éteinte.
makestep 1 3

# Secondes intercalaires tirées de la base tzdata du système.
leapseclist /usr/share/zoneinfo/leap-seconds.list

# Compléments locaux éventuels (vide sur les clients du lab).
confdir /etc/chrony/conf.d
