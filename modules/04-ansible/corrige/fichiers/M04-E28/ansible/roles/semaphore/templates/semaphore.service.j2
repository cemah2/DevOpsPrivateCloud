# {{ ansible_managed }}
# Semaphore UI — service durci (M04-E28). Le paquet officiel ne fournit pas d'unité.
[Unit]
Description=Semaphore UI (orchestrateur Ansible MédiSphère)
Documentation=https://semaphoreui.com/docs/
Requires=postgresql.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=semaphore
Group=semaphore
WorkingDirectory=/var/lib/semaphore
Environment=HOME=/var/lib/semaphore
ExecStart=/usr/bin/semaphore server --config /etc/semaphore/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s

# Écouter sur 443 et 80 sans être root : cette seule capacité.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Durcissement : système en lecture seule sauf le dossier de travail (dépôts clonés,
# ~/.ansible, ~/.ssh/known_hosts, collections installées par Semaphore).
ProtectSystem=strict
ReadWritePaths=/var/lib/semaphore
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
