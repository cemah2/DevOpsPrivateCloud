# ~/.config/workbook/pve-ansible.env — accès d'Ansible à l'API Proxmox (M04-E13).
# Dossier 700, fichier 600, JAMAIS dans un dépôt. Inscrit au registre des secrets.
# Chargement dans le shell avant d'utiliser l'inventaire dynamique :
#   set -a; . ~/.config/workbook/pve-ansible.env; set +a
# En CI (M04-E27) : mêmes noms en variables protégées et masquées du projet.
#
# <IP-PVE01> : une adresse présente dans le certificat de pve01 (M00-E17).
# <SECRET>   : affiché UNE fois par « pveum user token add » ; à coller avec l'éditeur.

# Plugin d'inventaire community.proxmox.proxmox (options url, user, token_id, token_secret).
PROXMOX_URL="https://<IP-PVE01>:8006"
PROXMOX_USER="wb-ansible@pve"
PROXMOX_TOKEN_ID="ansible"
PROXMOX_TOKEN_SECRET="<SECRET>"

# Modules community.proxmox.* (Molecule, M04-E24) : ils lisent PROXMOX_HOST, pas PROXMOX_URL,
# et la CA par PROXMOX_CA_PATH.
PROXMOX_HOST="<IP-PVE01>"
PROXMOX_CA_PATH="$HOME/.config/workbook/pve-root-ca.pem"

# Le plugin d'inventaire passe par la bibliothèque requests, qui n'utilise PAS le magasin
# système par défaut (elle embarque le sien, certifi) et n'a pas d'option « ca_path ».
# requests lit cette variable : magasin système de adm01, qui contient l'autorité de pve01
# depuis M03-E02 (/usr/local/share/ca-certificates/pve01-root-ca.crt).
REQUESTS_CA_BUNDLE="/etc/ssl/certs/ca-certificates.crt"
