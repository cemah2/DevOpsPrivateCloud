#!/usr/bin/env bash
# ms-verif-registre — sonde de service du registre Harbor (M13-E16, CHG-1416).
#
# Vérifie que le registre REND le service : santé globale et par composant, métriques joignables,
# version attendue, espace libre du volume de données, dernière exécution réussie et récente de chaque
# politique de réplication active, dernier ramasse-miettes réussi, certificat du point d'entrée.
# Lecture seule : API de Harbor avec le robot système « supervision » (lecture), HTTP des métriques.
#
# Usage : ms-verif-registre [-d|--seuil-disque POURCENT] [-s|--seuil-certificats JOURS] [-q|--quiet] [-h|--help]
# Configuration : /usr/local/etc/ms-verif-registre.conf (MS_CONF pour un autre chemin) ; secret du robot :
# MS_REG_SECRET (défaut /usr/local/etc/ms-verif-registre.secret, HARBOR_USER= / HARBOR_PASSWORD=, mode 600).
#
# Codes retour : 0 tout va bien ; 1 au moins une anomalie OU un contrôle impossible ; 2 usage.
# Principe (M02-E26) : « rien vu » n'est jamais « tout va bien ».

# lib/ms-commun.sh : bibliothèque commune de plateforme/outils (M02-E20). Référence dans le workbook :
# modules/02-scripting/corrige/fichiers/M02-E20/outils/lib/ms-commun.sh.
# shellcheck source-path=SCRIPTDIR source-path=SCRIPTDIR/../../../../../../02-scripting/corrige/fichiers/M02-E20/outils/bin source=../lib/ms-commun.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/ms-commun.sh"

_NB_OK=0
_NB_KO=0
_QUIET=0

usage() {
  cat <<'FIN'
Usage : ms-verif-registre [-d|--seuil-disque POURCENT] [-s|--seuil-certificats JOURS] [-q|--quiet] [-h|--help]

Sonde du registre Harbor : santé, composants, métriques, version, disque, réplications, ramasse-miettes, certificat.

  -d, --seuil-disque POURCENT     occupation maximale admise du volume de données (1 à 100, défaut 80)
  -s, --seuil-certificats JOURS   un certificat qui expire dans moins de JOURS jours est une anomalie (défaut 10)
  -q, --quiet                     n'afficher que les anomalies et le bilan

Codes retour : 0 tout va bien, 1 anomalie ou contrôle impossible, 2 usage.
Guide d'astreinte : docs/astreinte.md du projet plateforme/outils (section Registre).
FIN
}

ok() {
  _NB_OK=$((_NB_OK + 1))
  ((_QUIET)) || printf 'OK  %-12s %s\n' "$1" "$2"
}
ko() {
  _NB_KO=$((_NB_KO + 1))
  printf 'KO  %-12s %s\n' "$1" "$2"
}

# api CHEMIN — GET sur /api/v2.0 avec le robot de supervision (identifiants passés par descripteur).
api() {
  curl -sS --fail --max-time 15 --cacert "$MS_RACINE" -H 'Accept: application/json' \
    -K <(printf 'user = "%s:%s"\n' "$HARBOR_USER" "$HARBOR_PASSWORD") \
    "$MS_REG_URL/api/v2.0/$1" 2>/dev/null
}

# age_heures DATE_ISO — heures écoulées depuis la date (vide si illisible).
age_heures() {
  local t
  t="$(date -d "$1" +%s 2>/dev/null)" || return 1
  echo $((($(date +%s) - t) / 3600))
}

verifier_sante() {
  local s mauvais
  if ! s="$(curl -sS --fail --max-time 15 --cacert "$MS_RACINE" "$MS_REG_URL/api/v2.0/health" 2>/dev/null)"; then
    ko sante "$MS_REG_URL/api/v2.0/health ne répond pas"
    return 1
  fi
  mauvais="$(jq -r '[.components[]? | select(.status != "healthy") | .name] | join(" ")' <<<"$s" 2>/dev/null)"
  if [[ "$(jq -r '.status // empty' <<<"$s")" == healthy && -z "$mauvais" ]]; then
    ok sante "healthy ($(jq -r '.components | length' <<<"$s") composants)"
  else
    ko sante "état $(jq -r '.status // "illisible"' <<<"$s") ; composants en défaut : ${mauvais:-?}"
  fi
}

verifier_metriques() {
  local m
  if m="$(curl -sS --fail --max-time 15 "$MS_REG_METRIQUES" 2>/dev/null)" && grep -q '^harbor_' <<<"$m"; then
    ok metriques "$MS_REG_METRIQUES répond ($(grep -c '^harbor_' <<<"$m") échantillons harbor_*)"
  else
    ko metriques "$MS_REG_METRIQUES : pas de métriques harbor_*"
  fi
}

verifier_version() {
  local v
  v="$(api systeminfo | jq -r '.harbor_version // empty')"
  if [[ -z "$v" ]]; then
    ko version "version illisible (systeminfo)"
  elif [[ "$v" == "$MS_REG_VERSION"* ]]; then
    ok version "$v"
  else
    ko version "$v, attendue $MS_REG_VERSION (mise à jour à planifier, RB-132)"
  fi
}

verifier_disque() {
  local seuil="$1" s total libre pct
  s="$(api systeminfo/volumes)" || { ko disque "systeminfo/volumes illisible"; return; }
  total="$(jq -r '.storage[0].total // 0' <<<"$s")"
  libre="$(jq -r '.storage[0].free // 0' <<<"$s")"
  if [[ ! "$total" =~ ^[0-9]+$ ]] || ((total == 0)); then
    ko disque "taille du volume de données illisible"
    return
  fi
  pct=$((100 * (total - libre) / total))
  if ((pct >= seuil)); then
    ko disque "volume de données occupé à $pct % (seuil $seuil %)"
  else
    ok disque "volume de données occupé à $pct %"
  fi
}

verifier_replications() {
  local pols id nom e statut debut age n=0
  pols="$(api 'replication/policies?page_size=100')" || { ko replication "politiques illisibles"; return; }
  while IFS=$'\t' read -r id nom; do
    [[ -n "$id" ]] || continue
    n=$((n + 1))
    e="$(api "replication/executions?policy_id=$id&page_size=1&sort=-start_time")" || { ko replication "$nom : exécutions illisibles"; continue; }
    statut="$(jq -r '.[0].status // "aucune"' <<<"$e")"
    debut="$(jq -r '.[0].start_time // empty' <<<"$e")"
    age="$(age_heures "$debut" || true)"
    if [[ "$statut" != Succeed ]]; then
      ko replication "$nom : dernière exécution « $statut »"
    elif [[ -z "$age" ]] || ((age > MS_REG_REPLICATION_MAX_H)); then
      ko replication "$nom : dernière exécution réussie il y a ${age:-?} h (max $MS_REG_REPLICATION_MAX_H h)"
    else
      ok replication "$nom : réussie il y a $age h"
    fi
  done < <(jq -r '.[]? | select(.enabled == true) | [.id, .name] | @tsv' <<<"$pols")
  ((n > 0)) || ok replication "aucune politique active (rien à surveiller)"
}

verifier_gc() {
  local g statut quand age
  g="$(api 'system/gc?page_size=1&sort=-creation_time')" || { ko gc "historique du ramasse-miettes illisible"; return; }
  statut="$(jq -r '.[0].job_status // "aucun"' <<<"$g")"
  quand="$(jq -r '.[0].creation_time // empty' <<<"$g")"
  age="$(age_heures "$quand" || true)"
  if [[ "${statut,,}" != success ]]; then
    ko gc "dernier ramasse-miettes : « $statut »"
  elif [[ -z "$age" ]] || ((age > MS_REG_GC_MAX_JOURS * 24)); then
    ko gc "dernier ramasse-miettes réussi il y a ${age:-?} h (max $MS_REG_GC_MAX_JOURS jours)"
  else
    ok gc "réussi il y a $age h"
  fi
}

verifier_certificat() {
  local seuil_j="$1" pem fin
  if ! pem="$(openssl s_client -connect "$MS_REG_NOM:443" -servername "$MS_REG_NOM" -CAfile "$MS_RACINE" \
    -verify_hostname "$MS_REG_NOM" -verify_return_error </dev/null 2>/dev/null | openssl x509 2>/dev/null)" \
    || [[ -z "$pem" ]]; then
    ko certificat "$MS_REG_NOM:443 : injoignable, chaîne non reconnue par la racine MédiSphère, ou nom incorrect"
    return
  fi
  fin="$(openssl x509 -noout -enddate <<<"$pem" | cut -d= -f2)"
  if openssl x509 -noout -checkend $((seuil_j * 86400)) <<<"$pem" >/dev/null; then
    ok certificat "$MS_REG_NOM valide jusqu'au $fin"
  else
    ko certificat "$MS_REG_NOM expire dans moins de $seuil_j jours ($fin)"
  fi
}

main() {
  set -Eeuo pipefail
  local seuil_j="${MS_VERIF_SEUIL_CERTS:-10}" seuil_d="${MS_VERIF_SEUIL_DISQUE:-80}"
  while (($#)); do
    case "$1" in
      -d | --seuil-disque | -s | --seuil-certificats)
        [[ $# -ge 2 ]] || {
          usage >&2
          exit 2
        }
        if [[ "$1" == -d || "$1" == --seuil-disque ]]; then seuil_d="$2"; else seuil_j="$2"; fi
        shift 2
        ;;
      -q | --quiet)
        _QUIET=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        log_err "option inconnue : $1"
        usage >&2
        exit 2
        ;;
    esac
  done
  [[ "$seuil_j" =~ ^[1-9][0-9]{0,2}$ ]] || die "--seuil-certificats attend un nombre de jours entre 1 et 999" 2
  [[ "$seuil_d" =~ ^([1-9]|[1-9][0-9]|100)$ ]] || die "--seuil-disque attend un pourcentage entre 1 et 100" 2
  require_cmd curl jq openssl
  local conf="${MS_CONF:-/usr/local/etc/ms-verif-registre.conf}"
  [[ -r "$conf" ]] || die "configuration illisible : $conf" 1
  # shellcheck source=../etc/ms-verif-registre.conf
  source "$conf"
  [[ -n "${MS_REG_URL:-}" && -n "${MS_REG_NOM:-}" && -n "${MS_REG_VERSION:-}" ]] \
    || die "configuration incomplète ($conf) : rien à surveiller ne veut pas dire que tout va bien" 1
  local secret="${MS_REG_SECRET:-/usr/local/etc/ms-verif-registre.secret}" mode
  [[ -r "$secret" ]] || die "secret du robot de supervision illisible : $secret" 1
  mode="$(stat -c '%a' -- "$secret")"
  (((8#$mode & 8#077) == 0)) || die "$secret est lisible par d'autres que son propriétaire (mode $mode)" 1
  HARBOR_USER=""
  HARBOR_PASSWORD=""
  # shellcheck source=/dev/null
  source "$secret"
  [[ -n "$HARBOR_USER" && -n "$HARBOR_PASSWORD" ]] || die "HARBOR_USER ou HARBOR_PASSWORD absent de $secret" 1

  if verifier_sante; then
    verifier_version
    verifier_disque "$seuil_d"
    verifier_replications
    verifier_gc
  fi
  verifier_metriques
  verifier_certificat "$seuil_j"

  echo "Bilan : $_NB_OK contrôle(s) OK, $_NB_KO anomalie(s)."
  ((_NB_OK > 0)) || die "aucun contrôle n'a abouti" 1
  if ((_NB_KO > 0)); then
    log_err "$_NB_KO anomalie(s) sur le registre"
    exit 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
