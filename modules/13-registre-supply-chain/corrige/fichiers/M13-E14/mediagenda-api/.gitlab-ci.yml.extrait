# mediagenda/api — .gitlab-ci.yml : EXTRAIT (M13-E14). Le reste est celui de M13-E09 (workflow,
# variables, stages, tests, hadolint) : on ajoute un fichier à l'inclusion et un job.
include:
  - project: plateforme/ci-templates
    ref: v1.<Y>.<Z>          # étiquette du dépôt de gabarits, jamais une branche
    file:
      - templates/qualite.yml
      - templates/release.yml
      - templates/image.yml
      - templates/supply-chain.yml
      - templates/verification.yml

# sc:publication (templates/supply-chain.yml) exporte SC_REF = <registre>/<dépôt>@<digest> dans son
# rapport dotenv ; .verifier-signature le prend comme IMAGE_REF par défaut et porte les mêmes règles
# que la publication (étiquette vX.Y.Z, branche par défaut). Il suit la signature.
verifier-signature:
  extends: .verifier-signature
  needs:
    - job: sc:publication    # artefacts : le rapport dotenv (SC_REF)
      artifacts: true
    - job: sc:signature
      artifacts: false
