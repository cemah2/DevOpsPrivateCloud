# Dockerfiles des quatre applications — EXTRAITS des lignes changées (M13-E04), une MR par projet.
# Seul le PRÉFIXE change ; étiquette et empreinte (épinglée au M12) restent identiques.

# mediagenda/api (Dockerfile)
FROM registry.par1.medisphere.internal/dockerhub/library/python:3.13-slim-trixie@sha256:<EMPREINTE>
COPY --from=registry.par1.medisphere.internal/ghcr/astral-sh/uv:0.12.23@sha256:<EMPREINTE> /uv /usr/local/bin/uv

# medidoc/medidoc (Dockerfile)
FROM registry.par1.medisphere.internal/dockerhub/library/golang:1.26-trixie@sha256:<EMPREINTE> AS construction
# gcr.io n'a pas de cache : l'image distroless est COPIÉE dans bibliotheque par le pipeline des
# images de base (skopeo copy --all --preserve-digests, même empreinte que gcr.io) :
FROM registry.par1.medisphere.internal/bibliotheque/distroless-static-debian13:nonroot@sha256:<EMPREINTE>

# medinotif/worker (Dockerfile)
FROM registry.par1.medisphere.internal/dockerhub/library/python:3.13-slim-trixie@sha256:<EMPREINTE>

# legacy/legacy-rdv (Dockerfile)
FROM registry.par1.medisphere.internal/dockerhub/library/php:8.4-apache-trixie@sha256:<EMPREINTE>

# compose.yaml de mediagenda/api (recette locale) : mêmes préfixes pour postgres et valkey :
#   image: registry.par1.medisphere.internal/dockerhub/library/postgres:18-trixie
#   image: registry.par1.medisphere.internal/dockerhub/valkey/valkey:8-trixie
