# plateforme/ci-templates — templates/image.yml : EXTRAIT (M13-E04, PLAT-1404).
# Toutes les images des jobs passent par les caches de Harbor. Les EMPREINTES ne changent pas : un
# cache sert le même manifeste que l'amont (même contenu, même sha256). Relève-les avec
#   skopeo inspect --format '{{.Digest}}' docker://registry.par1.medisphere.internal/dockerhub/moby/buildkit:v0.34.0-rootless
variables:
  # Avant (M12-E21) : docker.io/moby/buildkit:v0.34.0-rootless@sha256:<EMPREINTE>
  IMAGE_BUILDKIT: registry.par1.medisphere.internal/dockerhub/moby/buildkit:v0.34.0-rootless@sha256:<EMPREINTE>
  # Avant : docker.io/hadolint/hadolint:v2.15.1-debian@sha256:<EMPREINTE>
  IMAGE_HADOLINT: registry.par1.medisphere.internal/dockerhub/hadolint/hadolint:v2.15.1-debian@sha256:<EMPREINTE>
# Les jobs utilisent « name: $IMAGE_BUILDKIT » et « name: $IMAGE_HADOLINT » : aucune autre ligne ne
# change. Publier une nouvelle version 1.x.y du dépôt de gabarits (la branche v1 la suit, M01-E25).
