# host_vars/runner02/gitlab_runner.yml — EXTRAIT (M13-E04, PLAT-1404).
# ⚠️ Noms de variables du rôle gitlab_runner étendu au M12-E20 pour l'exécuteur docker : adapte-les
# à ton rôle. Ce qui doit se retrouver dans /etc/gitlab-runner/config.toml, section [runners.docker] :
#
#   image = "registry.par1.medisphere.internal/dockerhub/library/debian:trixie-slim"
#   allowed_images = ["registry.par1.medisphere.internal/**/*"]
#   allowed_services = ["registry.par1.medisphere.internal/**/*"]
#   allowed_pull_policies = ["always", "if-not-present"]
#   pull_policy = ["if-not-present"]
#   privileged = false
#
# allowed_images : motifs « doublestar » de la documentation de l'exécuteur Docker (« ** » traverse
# les « / ») ; un job qui déclare « image: python:3.13 » échoue AVANT de tirer quoi que ce soit
# (« The "python:3.13" image is not present on list of allowed images »).
# L'image d'aide (gitlab-runner-helper) n'est pas concernée par allowed_images : elle vient de
# registry.gitlab.com, ou du cache si tu règles helper_image (pour aller plus loin).
gitlab_runner_docker_image: registry.par1.medisphere.internal/dockerhub/library/debian:trixie-slim
gitlab_runner_docker_allowed_images:
  - registry.par1.medisphere.internal/**/*
gitlab_runner_docker_allowed_services:
  - registry.par1.medisphere.internal/**/*
gitlab_runner_docker_allowed_pull_policies: [always, if-not-present]
gitlab_runner_docker_pull_policy: [if-not-present]
