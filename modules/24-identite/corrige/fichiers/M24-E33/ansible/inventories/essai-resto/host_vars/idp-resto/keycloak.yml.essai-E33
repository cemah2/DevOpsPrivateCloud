# host_vars/idp-resto/keycloak.yml — essai de montée de version sur la COPIE (M24-E33).
# Étape 1 : restaurer la sauvegarde de la nuit avec keycloak_version 26.7.5 (RB-243 §4).
# Étape 2 : passer à ces valeurs et rejouer --tags keycloak : migration de la COPIE.
keycloak_version: "26.8.1"
keycloak_sha256: "4e2740b181faa2ea623a1c2ecf00855935311e546046e2f857615a47ed24cbe8"
keycloak_hostname: https://sso.par1.medisphere.internal
keycloak_mandataires: [10.10.10.10]
keycloak_tas: "-Xms384m -Xmx768m"
keycloak_verifier: false
keycloak_options:
  event-metrics-user-enabled: "true"
  spi-events-listener--jboss-logging--success-level: info
  spi-events-listener--jboss-logging--error-level: warn
  features-disabled: impersonation
