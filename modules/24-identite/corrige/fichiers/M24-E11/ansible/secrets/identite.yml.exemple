# plateforme/ansible — secrets/identite.yml : STRUCTURE seulement (M24, palier 2). Le vrai fichier est
# chiffré sous l'identité « critique » et n'est JAMAIS édité à la main : il est écrit par
# plateforme/identite/outils/ranger-secret-client.sh <client> (qui lit le secret dans Keycloak).
# SEULE source des secrets des clients OIDC confidentiels du royaume medisphere :
#   - VMs (Ansible) : playbooks qui chargent ce fichier (vars_files), ex. netbox.yml (M24-E15) ;
#   - cluster : composant « identite » de plateforme/k8s/outils/secrets-k8s.sh (M24-E12) ;
#   - OpenTofu : variables éphémères chargées par outils/charger-acces.sh (registre, acces-proxmox) ;
#   - gitlab.rb (à la main, M24-E11), pbs01 (API, M24-E15).
# Clé = identifiant du client, tiret remplacé par « _ ». Rotation : M24-E29, RB-244.
keycloak_secrets_clients:
  gitlab: "<secret généré par Keycloak — M24-E11>"
  grafana: "<M24-E12>"
  argocd: "<M24-E13>"
  harbor: "<M24-E14>"
  proxmox: "<M24-E15>"
  pbs: "<M24-E15>"
  netbox: "<M24-E15>"
  oauth2_proxy: "<M24-E18>"
  step_ca: "<M24-E20>"
