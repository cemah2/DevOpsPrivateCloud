# {{ keycloak_entete }}
# /etc/systemd/system/keycloak.service — rôle keycloak (M24-E04).
[Unit]
Description=Keycloak {{ keycloak_version }} (fournisseur d'identité de MédiSphère)
Documentation=https://www.keycloak.org/server/configuration-production
After=network-online.target{{ " postgresql.service" if keycloak_bdd_hote in ["127.0.0.1", "localhost"] else "" }}
Wants=network-online.target
{% if keycloak_bdd_hote in ["127.0.0.1", "localhost"] %}
Requires=postgresql.service
{% endif %}

[Service]
Type=exec
User={{ keycloak_utilisateur }}
Group={{ keycloak_groupe }}
WorkingDirectory={{ keycloak_dossier_parent }}/keycloak
Environment="JAVA_OPTS_KC_HEAP={{ keycloak_tas }}"
# Construction faite par Ansible (root) : le service ne fait que démarrer l'image optimisée.
ExecStart={{ keycloak_dossier_parent }}/keycloak/bin/kc.sh start --optimized
# Java renvoie 143 sur SIGTERM : un arrêt demandé n'est pas un échec.
SuccessExitStatus=143
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
UMask=0027

# Durcissement : le service n'écrit que dans data/ de sa version.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths={{ keycloak_dossier_parent }}/keycloak-{{ keycloak_version }}/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
