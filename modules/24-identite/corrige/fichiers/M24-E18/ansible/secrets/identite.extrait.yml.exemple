---
# secrets/identite.yml de plateforme/ansible (Vault « critique ») — variables AJOUTÉES au M24-E18.
# Exemple en clair : valeurs à générer, jamais à recopier. Édition : uv run ansible-vault edit …
keycloak_secrets_clients:
  # … gitlab, grafana, argocd, harbor, proxmox, pbs, netbox (E11-E15) …
  oauth2_proxy: "<RANGÉ PAR outils/ranger-secret-client.sh oauth2-proxy>"
oauth2_proxy_client_id: oauth2-proxy
oauth2_proxy_cookie_secret_cluster: "<GÉNÉRÉ : openssl rand -hex 16>"
