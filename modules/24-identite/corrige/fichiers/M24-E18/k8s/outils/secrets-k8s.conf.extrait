# outils/secrets-k8s.conf (plateforme/k8s) — EXTRAIT : ligne AJOUTÉE au M24-E18 (composant « identite »).
# Vault : secrets/identite.yml de plateforme/ansible (lu par secrets-k8s.sh depuis M24-E12).
#   keycloak_secrets_clients.oauth2_proxy   secret du client Keycloak (ranger-secret-client.sh oauth2-proxy)
#   oauth2_proxy_client_id                  « oauth2-proxy » (la table n'a pas de source littérale)
#   oauth2_proxy_cookie_secret_cluster      openssl rand -hex 16 (32 caractères), propre au cluster
# Clés imposées par le chart oauth2-proxy (config.existingSecret) : client-id, client-secret, cookie-secret.
identite  oauth2-proxy  oauth2-proxy-oidc  client-id=vault:oauth2_proxy_client_id client-secret=vault:keycloak_secrets_clients.oauth2_proxy cookie-secret=vault:oauth2_proxy_cookie_secret_cluster
