# plateforme/k8s — outils/secrets-k8s.sh : MODIFICATION de M24-E12 (DEV-2512).
# Les secrets des clients OIDC servent aux VMs (Ansible) ET au cluster : ils n'ont qu'UNE source,
# secrets/identite.yml de plateforme/ansible (Vault « critique »). Plutôt que d'en garder une copie
# dans plateforme/k8s (deux fichiers à faire tourner, M24-E29), le script lit le Vault d'un composant
# dans plateforme/ansible quand plateforme/k8s n'en a pas.
#
# 1. Dans l'en-tête, compléter la ligne « Valeurs : » :
#      Valeurs : secrets/<composant>.yml de plateforme/k8s ou, à défaut, de $MS_ANSIBLE_DIR (Vault
#                partagé avec les VMs, ex. « identite », M24-E12), chiffré par l'identité « critique ».
#
# 2. Dans le bloc de déchiffrement, remplacer
#      FICHIER="$RACINE/secrets/$COMPOSANT.yml"
#    par
       FICHIER="$RACINE/secrets/$COMPOSANT.yml"
       if [[ ! -e "$FICHIER" && -r "$ANSIBLE_DIR/secrets/$COMPOSANT.yml" ]]; then
         FICHIER="$ANSIBLE_DIR/secrets/$COMPOSANT.yml"
         info "Vault du composant $COMPOSANT lu dans plateforme/ansible : $FICHIER"
       fi
#    Le reste ne change pas : contrôle de l'en-tête (identité « critique »), déchiffrement en mémoire.
#    Un même nom de composant dans les deux dépôts est une erreur de conception : celui de
#    plateforme/k8s l'emporte (et le message ci-dessus n'apparaît pas), le relecteur de MR le voit.
