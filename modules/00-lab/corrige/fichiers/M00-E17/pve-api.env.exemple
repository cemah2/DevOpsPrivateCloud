# ~/.config/workbook/pve-api.env — accès à l'API Proxmox pour l'automatisation (M00-E17)
#
# Fichier SECRET : mode 600, dossier ~/.config/workbook en 700, jamais dans un dépôt git.
# Créé vide avec les bons droits AVANT d'y écrire le secret :
#   install -d -m 700 ~/.config/workbook
#   install -m 600 /dev/null ~/.config/workbook/pve-api.env
# Le secret sera déplacé dans Vault/OpenBao au module 25.
#
# Format imposé (lu par les vérifications et par ~/lab-scripts/vm-api.sh) :

PVE_API_URL="https://<IP-PVE01>:8006/api2/json"
PVE_NODE="<NOM-DU-NOEUD>"              # nom du nœud Proxmox (hostname de pve01), ex. pve01
PVE_TOKEN_ID="wb-automation@pve!lab"
PVE_TOKEN_SECRET="<SECRET-AFFICHE-UNE-SEULE-FOIS>"
PVE_CACERT="$HOME/.config/workbook/pve-root-ca.pem"   # copie de /etc/pve/pve-root-ca.pem
