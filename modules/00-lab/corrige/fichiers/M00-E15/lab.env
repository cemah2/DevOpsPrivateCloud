# lab/lab.env — configuration locale des vérifications, sur adm01 (M00-E15)
# Fichier ignoré par git. Partir de lab/lab.env.example, puis adapter.

# Hôtes SSH (alias de ~/.ssh/config). À partir de E15, plus « localhost ».
WB_PVE_HOST=pve01
WB_PBS_HOST=pbs01

# Options SSH supplémentaires (vide : tout est dans ~/.ssh/config)
WB_SSH_OPTS=""

# Délai max des tests réseau, en secondes
WB_TIMEOUT=5

# Réseau domestique
WB_LAN_MAISON="<LAN-MAISON>"

# Ajout du palier 2 : adresse LAN de hp01/pbs01. Sert à M00-E20 (avant le
# tunnel) et à M00-E21 (vérifier que l'interface web n'est plus exposée sur le LAN).
WB_PBS_LAN="<IP-HP01-LAN>"
