# Équivalent Proxmox VE 8 (Debian 12 bookworm), format une-ligne (M00-E06)
#
# /etc/apt/sources.list.d/pve-enterprise.list : commenter la ligne
# deb https://enterprise.proxmox.com/debian/pve bookworm pve-enterprise
#
# /etc/apt/sources.list.d/ceph.list : commenter la ligne enterprise (quincy, reef ou squid selon ta version)
# deb https://enterprise.proxmox.com/debian/ceph-quincy bookworm enterprise
#
# /etc/apt/sources.list.d/pve-no-subscription.list :
deb http://download.proxmox.com/debian/pve bookworm pve-no-subscription
#
# Clé de signature en PVE 8 : /etc/apt/trusted.gpg.d/proxmox-release-bookworm.gpg
