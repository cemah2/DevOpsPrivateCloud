# Extrait de host_vars/gw01/pare_feu.yml (matrice commune à gw01 et gw02 depuis M07-E24).
# M10-E04 (PLAT-1104) : certificat de la VIP externe d'OpenStack par ACME (step-ca).
#
# 1) pare_feu_definitions : AJOUTER (sauf si déjà définies par un module précédent)
  - {nom: V_OSAPI, valeur: '"ens19.50"'}
  - {nom: CA01, valeur: 10.10.20.11}
  - {nom: OSCTL01, valeur: 10.10.50.51}
  - {nom: OS_VIP_EXT, valeur: 10.10.50.201, commentaire: "VIP externe d'OpenStack (keepalived de Kolla sur osctl01)"}
#
# 2) pare_feu_transit : AJOUTER (bloc « OpenStack »)
  - {entree: $V_OSAPI, source: $OSCTL01, sortie: $V_INFRA, destination: $CA01, proto: tcp, ports: 443,
     motif: "osctl01 vers ca01 : ACME (émission du certificat externe), puis client ACME de Kolla (M10-E27)", ref: M10-E04}
  - {entree: $V_INFRA, source: $CA01, sortie: $V_OSAPI, destination: $OS_VIP_EXT, proto: tcp, ports: 80,
     motif: "ca01 vers la VIP externe d'OpenStack : défi ACME HTTP-01", ref: M10-E04}
# Inchangé et suffisant : MGMT (adm01) vers tout le lab ; DNS du lab ; NTP sur LAB_IFS ;
# « lab vers Internet » (images de quay.io, dépôts Debian et Docker pour bootstrap-servers).
# Pas de règle pour les réponses : la chaîne forward accepte « established,related » (M00-E26).
