# /etc/systemd/system/ms-verif-openstack.service.d/zz-test.conf — TEST TEMPORAIRE (M10-E26, étape 6)
# Fait échouer la sonde sans rien casser : les certificats de 30 jours deviennent « trop proches »
# d'un seuil de 400 jours. À supprimer juste après (puis systemctl daemon-reload).
[Service]
Environment=MS_VERIF_SEUIL_CERTS=400
