---
# host_vars/gw01/pare_feu.yml — EXTRAIT : ajout de M10-E25 (section « Sauvegardes vers PAR2 »).
# Même matrice sur gw02 (rôle pare_feu appliqué aux deux passerelles, M07-E24).
# $V_OSAPI : nom de la définition de l'interface VLAN 50 dans ta matrice (M07) ; adapte s'il diffère.
pare_feu_definitions:
  # … définitions existantes …
  - {nom: OSCTL01, valeur: 10.10.50.51}

pare_feu_transit:
  # … règles existantes (pve01, git01, dns01, ca01, nbx01 → PBS) …
  - {entree: $V_OSAPI, source: [$OSCTL01], sortie: $WG_S2S, destination: $PBS01, proto: tcp, ports: 8007,
     motif: "osctl01 vers PBS : base OpenStack (Mariabackup)", ref: M10-E25}
