---
# host_vars/gw01/pare_feu.yml — EXTRAIT : section « Cloud OpenStack » (M10-E27, SEC-1153).
# Même matrice sur gw02. Principe : TOUT ce qui n'est pas listé est refusé (politique drop de la
# chaîne de transit, M00/M06-E30). Les VIP et les nœuds sont dans le VLAN 50 ; les instances
# sortent par le VLAN 52 (SNAT des routeurs OVN et IP flottantes, 10.10.52.0/24).
# Noms de définitions ($V_…) : ceux de ta matrice (M07) ; adapte s'ils diffèrent.
pare_feu_definitions:
  # … définitions existantes …
  - {nom: OS_VIP_INT, valeur: 10.10.50.200}
  - {nom: OS_VIP_EXT, valeur: 10.10.50.201}
  - {nom: OS_API_NET, valeur: 10.10.50.0/24}
  - {nom: OS_EXT_NET, valeur: 10.10.52.0/24}
  - {nom: VPN_ADMIN, valeur: 10.255.1.0/24}

pare_feu_transit:
  # … règles existantes …
  # API publique (Keystone 5000, Nova 8774, Neutron 9696, Glance 9292, Cinder 8776, Placement 8780,
  # Heat 8004/8000, Octavia 9876, Horizon 443) : postes d'admin, VPN d'admin, runner de la CI.
  - {entree: $V_MGMT, source: [$ADM01], sortie: $V_OSAPI, destination: [$OS_VIP_INT, $OS_VIP_EXT], proto: tcp,
     ports: [443, 5000, 8000, 8004, 8774, 8776, 8780, 9292, 9696, 9876], motif: "adm01 vers les API OpenStack (deux VIP)", ref: M10-E27}
  - {entree: $WG_ADMIN, source: [$VPN_ADMIN], sortie: $V_OSAPI, destination: $OS_VIP_EXT, proto: tcp,
     ports: [443, 5000, 8000, 8004, 8774, 8776, 8780, 9292, 9696, 9876], motif: "VPN d'admin vers l'API et Horizon", ref: M10-E27}
  - {entree: $V_INFRA, source: [$RUNNER01], sortie: $V_OSAPI, destination: $OS_VIP_EXT, proto: tcp,
     ports: [443, 5000, 8000, 8004, 8774, 8776, 8780, 9292, 9696, 9876], motif: "runner01 : OpenTofu et CI vers l'API", ref: M10-E27}
  # Défis ACME HTTP-01 : ca01 vient chercher le jeton sur le port 80 des deux VIP.
  - {entree: $V_INFRA, source: [$CA01], sortie: $V_OSAPI, destination: [$OS_VIP_INT, $OS_VIP_EXT], proto: tcp, ports: 80,
     motif: "ca01 vers les VIP OpenStack : défis ACME (renouvellement des certificats)", ref: M10-E27}
  # Les conteneurs letsencrypt_lego de osctl01 parlent ACME à ca01 (443).
  - {entree: $V_OSAPI, source: [$OS_API_NET], sortie: $V_INFRA, destination: $CA01, proto: tcp, ports: 443,
     motif: "nœuds OpenStack vers step-ca (ACME)", ref: M10-E27}
  # Instances (VLAN 52) : DNS du socle et Internet seulement. AUCUN flux vers le VLAN 50.
  - {entree: $V_OSEXT, source: [$OS_EXT_NET], sortie: $V_INFRA, destination: [$DNS01, $DNS02], proto: udp, ports: 53,
     motif: "instances vers les résolveurs du socle", ref: M10-E27}
  - {entree: $V_OSEXT, source: [$OS_EXT_NET], sortie: $V_INFRA, destination: [$DNS01, $DNS02], proto: tcp, ports: 53,
     motif: "instances vers les résolveurs du socle (TCP)", ref: M10-E27}
  # Sortie Internet des instances : décision de M10-E12 (NAT sortant de la bordure), inchangée.
  # Instances (VLAN 52) vers le plan de contrôle (VLAN 50) : AUCUNE règle. La politique « drop »
  # de la chaîne de transit les refuse ; vérifier qu'aucune règle plus large (ex. « VLAN 52 vers
  # 10.10.0.0/16 » posée en M10-E12 pour tester) ne les autorise, et le prouver depuis une
  # instance (M10-E27, étape 5). Le refus est journalisé (préfixe « nft-fwd-drop: ») si
  # pare_feu_journaliser_rejets est actif (rôle pare_feu, M04).
