# Extrait de etc/kolla/passwords.yml (M10-E10). Ce fichier est CHIFFRÉ (Ansible Vault,
# identité « critique ») : on l'édite avec
#   uv run ansible-vault edit etc/kolla/passwords.yml   (depuis ~/src/openstack : identité « critique » par ansible.cfg)
# Les quatre clés cephx (valeur de « key = » dans « ceph auth get client.<nom> ») sont lues par
# les trousseaux-gabarits de etc/kolla/config/{glance,cinder,nova}/.
# ⚠️ kolla-mergepwd --clean (mise à jour, E28) retirerait ces entrées : ne pas l'utiliser, ou
# les remettre après fusion. Inscrire les quatre clés au registre des secrets.
ceph_cle_glance: "<CLE-CLIENT-GLANCE>"
ceph_cle_cinder: "<CLE-CLIENT-CINDER>"
ceph_cle_cinder_backup: "<CLE-CLIENT-CINDER-BACKUP>"
ceph_cle_nova: "<CLE-CLIENT-NOVA>"
# Existants, générés par kolla-genpwd (E03) : identifiants des secrets libvirt.
#   rbd_secret_uuid          -> secret de client.nova dans libvirt (disques éphémères)
#   cinder_rbd_secret_uuid   -> secret de client.cinder dans libvirt (volumes attachés)
