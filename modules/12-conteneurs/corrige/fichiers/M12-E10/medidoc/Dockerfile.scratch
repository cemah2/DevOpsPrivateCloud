# syntax=docker/dockerfile:1
# Variante « scratch » de MédiDoc (M12-E10, comparaison) : image finale VIDE, on y apporte
# soi-même ce que distroless fournissait (certificats racines, utilisateur non root).
#   docker build -f Dockerfile.scratch --build-arg VERSION=1.0.0 -t medidoc:1.0.0-scratch .
FROM golang:1.26-trixie AS construction
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd/ cmd/
COPY internal/ internal/
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/medidoc ./cmd/medidoc \
 # Un /etc/passwd minimal : sans lui, « USER 65532 » marche, mais les outils qui cherchent
 # un nom (journaux, ps de l'hôte) affichent un UID nu ; on le fournit pour la lisibilité.
 && printf 'nonroot:x:65532:65532:nonroot:/nonexistent:/sbin/nologin\n' > /out/passwd \
 && printf 'nonroot:x:65532:\n' > /out/group

FROM scratch
# Certificats racines de Debian (sans eux : « x509: certificate signed by unknown authority »
# au premier appel HTTPS vers S3). Pas de tzdata : MédiDoc journalise en UTC.
COPY --from=construction /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=construction /out/passwd /etc/passwd
COPY --from=construction /out/group /etc/group
COPY --from=construction /out/medidoc /usr/local/bin/medidoc
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/medidoc"]
