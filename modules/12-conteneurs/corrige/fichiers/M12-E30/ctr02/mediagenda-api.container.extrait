# ~app/.config/containers/systemd/mediagenda-api.container — ctr02, EXTRAIT : clés ajoutées ou
# modifiées en M12-E30 (CHG-1330). Le reste de l'unité (pod, réseau, secrets, variables) est celui
# de M12-E14 ; le nom de l'unité est celui de ton E14.
#   app@ctr02:~$ systemctl --user daemon-reload && systemctl --user restart mediagenda-api.service

[Container]
# Étiquette MOBILE de recette : « publier » = déplacer cette étiquette (skopeo copy).
Image=ctr01.par1.medisphere.internal:5000/mediagenda/api:recette
# Mise à jour automatique : compare l'empreinte de l'image locale à celle de l'étiquette dans le
# registre (label io.containers.autoupdate=registry posé par Quadlet).
AutoUpdate=registry
# Sonde de santé (l'image n'a pas de curl) : /sante ne dépend ni de la base ni du cache.
# Forme tableau JSON : écrite en chaîne, le Quadlet de Podman 5.4 perd le guillemet final (M12-E14).
HealthCmd=["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/sante', timeout=2)"]
HealthInterval=10s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=10s
# L'unité n'est « démarrée » pour systemd que lorsque le conteneur est HEALTHY (--sdnotify=healthy).
# Sans cette clé, l'unité est démarrée dès que le processus est lancé : une image cassée « réussit »
# son redémarrage et podman auto-update n'a aucune raison de revenir en arrière.
Notify=healthy

[Service]
# Délai laissé à la sonde pour passer « healthy » ; au-delà, le démarrage ÉCHOUE (→ retour arrière).
TimeoutStartSec=90
Restart=on-failure
