# /etc/systemd/system/wb-backup-conteneurs.timer — {{ inventory_hostname }} (M12-E29)
# Après Ceph (01:30), avant les services socle (01:55) et lab-nuit (02:30).
[Unit]
Description=Sauvegarde quotidienne des données des conteneurs vers PBS (M12-E29)

[Timer]
OnCalendar=*-*-* {{ sauvegarde_conteneurs_heure }}:00
RandomizedDelaySec=3min
Persistent=true

[Install]
WantedBy=timers.target
