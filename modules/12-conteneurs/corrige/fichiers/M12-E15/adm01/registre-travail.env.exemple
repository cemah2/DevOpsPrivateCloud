# ~/.config/workbook/registre-travail.env sur adm01 — 600, jamais dans un dépôt (M12-E15).
# Compte « plateforme » du registre de travail : vérifications du workbook (lab/bin/check 12 15,
# 12 46…), essais depuis adm01. Variable de lab/lab.env : WB_REGISTRE_ENV (défaut : ce chemin).
REGISTRE_UTILISATEUR=plateforme
REGISTRE_MOT_DE_PASSE=<MOT-DE-PASSE-PLATEFORME>
