# ~app/.config/containers/systemd/mediagenda-api.container (ctr02) — M12-E14.
# L'API MédiAgenda, dans le pod. Service généré : mediagenda-api.service
[Unit]
Description=API MédiAgenda (recette ctr02)
Requires=mediagenda-migrations.service mediagenda-valkey.service
After=mediagenda-migrations.service mediagenda-valkey.service

[Container]
ContainerName=mediagenda-api
Image=mediagenda-api.build
Pod=mediagenda.pod
# URL complète de la base (avec son mot de passe) : secret Podman, jamais dans ce fichier.
Secret=mediagenda-db-url,type=env,target=MEDIAGENDA_DB_URL
Environment=MEDIAGENDA_VALKEY_URL=redis://127.0.0.1:6379/0
Environment=MEDIAGENDA_LOG_LEVEL=INFO
# Vivacité sur /sante (ne dépend ni de la base ni du cache). Forme TABLEAU JSON : en chaîne
# simple, Quadlet 5.4 perd le guillemet final de « python -c "…" » (vérifié avec quadlet -dryrun),
# et la sonde échoue toujours. M12-E18 y ajoute HealthOnFailure= et des limites.
HealthCmd=["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/sante', timeout=2)"]
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy
# Arrêt propre : uvicorn laisse 20 s aux requêtes en cours ; on lui en laisse 30 avant SIGKILL.
StopTimeout=30

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
