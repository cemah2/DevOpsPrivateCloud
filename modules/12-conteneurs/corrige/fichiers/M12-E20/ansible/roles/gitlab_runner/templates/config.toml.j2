# {{ gitlab_runner_entete | replace('\n', ' ') }}
# /etc/gitlab-runner/config.toml de {{ inventory_hostname }} — exécuteur docker (M12-E20, PLAT-1320).
# Généré par le rôle gitlab_runner (tasks/executeur_docker.yml). Le jeton est relu dans le fichier
# en place à chaque passage : une rotation faite par le runner n'est pas écrasée.
# Référence : https://docs.gitlab.com/runner/configuration/advanced-configuration/
concurrent = {{ gitlab_runner_concurrent }}
check_interval = 0
# Arrêt du service : laisser finir les jobs en cours, 30 min au plus.
shutdown_timeout = 1800
log_level = "info"

[session_server]
  session_timeout = 1800

[[runners]]
  name = "{{ gitlab_runner_nom }}"
  url = "{{ gitlab_runner_url }}"
  token = "{{ _gitlab_runner_jeton_effectif }}"
  executor = "docker"
  [runners.cache]
    MaxUploadedArchiveSize = 0
  [runners.docker]
    # Image des jobs qui n'en déclarent pas : nom complet, empreinte d'index.
    image = "{{ gitlab_runner_docker_image }}"
    # JAMAIS privilégié (PLAN §4.10) : un job privilégié est root sur runner02, donc sur tous les
    # secrets des autres jobs. Les constructions passent par BuildKit sans privilège (M12-E21).
    privileged = false
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    # /cache : volume de cache du runner ; la racine MédiSphère, en lecture seule, pour les outils
    # des jobs qui parlent au registre (BuildKit, curl, skopeo) : jamais d'option « insecure ».
    volumes = {{ gitlab_runner_docker_volumes | to_json }}
    shm_size = 0
    # Toujours vérifier l'image auprès du registre (une image locale d'un autre job ne sert pas
    # par surprise) ; si le registre ne répond pas, utiliser la copie locale.
    pull_policy = {{ gitlab_runner_docker_pull_policy | to_json }}
    allowed_pull_policies = {{ gitlab_runner_docker_allowed_pull_policies | to_json }}
    # Exceptions de sécurité des conteneurs de job (M12-E21 : BuildKit sans privilège), justifiées
    # dans docs/conteneurs/construction-ci.md et l'ADR-0120. Vide tant qu'aucune n'est décidée.
    security_opt = {{ gitlab_runner_docker_security_opt | to_json }}
    # Bornes de chaque conteneur de job : deux jobs simultanés ne saturent pas la VM (4 Go).
    memory = "{{ gitlab_runner_docker_memoire }}"
    cpus = "{{ gitlab_runner_docker_cpus }}"
