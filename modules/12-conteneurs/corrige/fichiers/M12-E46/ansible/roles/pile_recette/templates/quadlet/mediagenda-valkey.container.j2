# {{ pile_recette_entete }}
[Unit]
Description=Valkey 8 de MédiAgenda (recette conteneurs v1)

[Container]
ContainerName=mediagenda-valkey
Image={{ pile_recette_image_valkey }}
Network=apps-recette.network
User=999:999
# Pas de --save "" : le Quadlet de Podman 5.4 supprime l'argument vide et tout ce qui le suit (M12-E14).
Exec=valkey-server --appendonly no
HealthCmd=["valkey-cli", "ping"]
HealthInterval=10s
Notify=healthy
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true

[Service]
Restart=always

[Install]
WantedBy=default.target
