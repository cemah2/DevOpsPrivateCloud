# {{ pile_recette_entete }}
[Unit]
Description=Valkey 8 de MédiAgenda (recette conteneurs v1)

[Container]
ContainerName=mediagenda-valkey
Image={{ pile_recette_image_valkey }}
Network=apps-recette.network
User=999:999
Exec=valkey-server --save "" --appendonly no
HealthCmd=valkey-cli ping
HealthInterval=10s
Notify=healthy
DropCapability=ALL
NoNewPrivileges=true
ReadOnly=true

[Service]
Restart=always

[Install]
WantedBy=default.target
