# {{ pile_recette_entete }}
[Unit]
Description=RabbitMQ 4 de MédiNotif (recette conteneurs v1)

[Container]
ContainerName=medinotif-rabbitmq
Image={{ pile_recette_image_rabbitmq }}
Network=apps-recette.network
HostName=medinotif-rabbitmq
Volume=medinotif-rabbitmq.volume:/var/lib/rabbitmq
Environment=RABBITMQ_DEFAULT_USER=medinotif
Secret=rabbitmq-mdp,type=env,target=RABBITMQ_DEFAULT_PASS
HealthCmd=rabbitmq-diagnostics -q ping
HealthInterval=20s
HealthStartPeriod=40s
Notify=healthy
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
