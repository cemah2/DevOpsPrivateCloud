# .dive-ci — seuils Dive de MédiSphère (M12-E16, ticket SEC-1316). Dive 0.13.
# Lu par « CI=true dive <image> » (ou « dive --ci --ci-config .dive-ci <image> »).
rules:
  # Part des octets de l'image réellement utile (non écrasée ou supprimée par une couche suivante).
  lowestEfficiency: 0.95
  # Octets gaspillés : fichiers écrits puis supprimés ou remplacés dans une couche ultérieure.
  highestWastedBytes: 20MB
  # Octets gaspillés rapportés aux octets que NOUS avons ajoutés. Attention : le gaspillage des
  # couches de l'image de base compte aussi (python:3.13-slim : ~6 Mo de fichiers dpkg/debconf
  # réécrits) ; sur une petite application Python (MédiNotif), 0,10 échoue sans faute de notre
  # part. 0,20 laisse passer la base et attrape un « apt-get » sans nettoyage dans nos couches.
  highestUserWastedPercent: 0.20
