# plateforme/k8s — secrets/medidoc-recette.yml (Vault « critique »), AVANT chiffrement (M20-E33).
#   cd ~/src/ansible && uv run ansible-vault create --vault-id critique@outils/vault-pass-client.sh \
#       ~/src/k8s/secrets/medidoc-recette.yml
# Mêmes clés dans secrets/medidoc-dev.yml (compte RGW medidoc-app du M08-E12 pour dev).
# Robot de tirage du cluster (M13) : Secret harbor-pull.
harbor_pull_utilisateur: "robot$k8s-pull"
harbor_pull_jeton: "<JETON-DU-ROBOT-K8S-PULL>"
# Compte RGW medidoc-recette (IAM du RGW, méthode du M08-E12) : Secret medidoc-s3.
medidoc_s3_cle_acces: "<CLE-D-ACCES-medidoc-recette>"
medidoc_s3_cle_secrete: "<CLE-SECRETE-medidoc-recette>"
