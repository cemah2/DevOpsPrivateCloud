# plateforme/k8s — secrets/mediagenda-recette.yml, AVANT chiffrement (M20-E12). Modèle : ne commite
# JAMAIS ce fichier en clair. Création chiffrée directement :
#   cd ~/src/ansible && uv run ansible-vault create --vault-id critique@outils/vault-pass-client.sh \
#       ~/src/k8s/secrets/mediagenda-recette.yml
# Mêmes clés pour mediagenda-dev.yml et mediagenda-prod.yml.
#
# Robot de tirage du cluster (M13, robot$k8s-pull) : le Secret harbor-pull de l'espace en est fait.
harbor_pull_utilisateur: "robot$k8s-pull"
harbor_pull_jeton: "<JETON-DU-ROBOT-K8S-PULL>"
