# plateforme/k8s — secrets/argocd.yml (EXEMPLE en clair : le vrai fichier est chiffré par
# « uv run ansible-vault encrypt --vault-id critique@… secrets/argocd.yml » et n'est JAMAIS en clair
# dans le dépôt). M20-E04 (formation), M20-E06 (les quatre groupes).
# Jetons de déploiement GitLab « argocd-lecture » (portée read_repository, expiration), un par groupe.
argocd_depots:
  plateforme:
    utilisateur: "argocd-plateforme"
    jeton: "gldt-REMPLACER"
  mediagenda:
    utilisateur: "argocd-mediagenda"
    jeton: "gldt-REMPLACER"
  medidoc:
    utilisateur: "argocd-medidoc"
    jeton: "gldt-REMPLACER"
  formation:
    utilisateur: "argocd-formation"
    jeton: "gldt-REMPLACER"
