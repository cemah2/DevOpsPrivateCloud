# plateforme/k8s — outils/secrets-k8s.sh : MODIFICATION de M20-E06 (PLAT-2106).
# Les composants dont les Secrets exigent des étiquettes ou une structure que la table ne sait pas
# décrire (Argo CD : argocd.argoproj.io/secret-type) ont un module outils/secrets-k8s.d/<composant>.sh,
# sourcé par le script. Deux changements dans secrets-k8s.sh :
#
# 1. La sélection des lignes de la table : un composant SANS ligne est accepté s'il a un module.
#    Remplacer
#      ((${#SELECTION[@]} > 0)) || { erreur "composant inconnu dans $TABLE : $COMPOSANT"; exit 2; }
#    par
       MODULE="$RACINE/outils/secrets-k8s.d/$COMPOSANT.sh"
       ((${#SELECTION[@]} > 0)) || [[ -r "$MODULE" ]] \
         || { erreur "composant inconnu (ni ligne dans $TABLE, ni module $MODULE) : $COMPOSANT"; exit 2; }
#
# 2. Le déchiffrement du Vault : il a lieu aussi quand un module existe. Remplacer la condition
#      if printf '%s\n' "${SELECTION[@]}" | grep -q '=vault:'; then
#    par
       if [[ -r "$MODULE" ]] || printf '%s\n' "${SELECTION[@]}" | grep -q '=vault:'; then
#
# 3. Juste avant le bilan final (« if [[ "$MODE" == verifier ]] && ((ECARTS > 0)) »), ajouter :
       if [[ -r "$MODULE" ]]; then
         # shellcheck source=/dev/null
         source "$MODULE"
         fonction="secrets_${COMPOSANT//-/_}_${MODE}"
         if declare -F "$fonction" >/dev/null && ! "$fonction"; then
           [[ "$MODE" == appliquer ]] && exit 1
           ECARTS=$((ECARTS + 1))
         fi
       fi
