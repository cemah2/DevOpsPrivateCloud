# plateforme/k8s — secrets/argocd.yml (Vault « critique ») : AJOUT de M20-E26, AVANT chiffrement.
# Édition : cd ~/src/ansible && uv run ansible-vault edit --vault-id critique@outils/vault-pass-client.sh ~/src/k8s/secrets/argocd.yml
# Jeton du compte de service argocd-gestion de lyo-k3s01 (Secret agence/argocd-gestion-jeton, clé
# « token », décodé) et autorité du serveur d'API de k3s (clé « ca.crt » du même Secret, PEM décodé).
lyo_k3s01_jeton: "<JETON-ARGOCD-GESTION>"
lyo_k3s01_ca: |
  -----BEGIN CERTIFICATE-----
  <AUTORITÉ DU SERVEUR D'API DE K3S (k3s-server-ca)>
  -----END CERTIFICATE-----
