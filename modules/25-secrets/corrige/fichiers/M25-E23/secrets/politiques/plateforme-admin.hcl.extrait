# politiques/plateforme-admin.hcl — À AJOUTER (M25-E23, INC-5223) : gestes de RB-250.
# Révoquer TOUS les baux d'un chemin (identifiants dynamiques fuités, certificats d'un rôle PKI) :
# « sudo » obligatoire. Puissant : chaque usage est dans l'audit et doit correspondre à un incident
# (requête LogQL de RB-250, § 7). revoke-force (abandon des baux sans révocation côté base) reste
# HORS de cette politique : jeton racine régénéré en cérémonie seulement (E28).
path "sys/leases/revoke-prefix/*" {
  capabilities = ["update", "sudo"]
}

path "sys/leases/lookup/*" {
  capabilities = ["list", "sudo"]
}
