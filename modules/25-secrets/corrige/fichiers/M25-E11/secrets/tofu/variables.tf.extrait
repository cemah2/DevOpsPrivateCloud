# tofu/variables.tf — EXTRAIT (M25-E11) : le groupe Keycloak « plateforme » (Lucas compris) reçoit
# ansible-lab en plus de plateforme-lecture. Seule la ligne « plateforme » change ; les groupes
# externes sont créés par vault_identity_group.keycloak (palier 1, tofu/oidc.tf).
variable "groupes_keycloak" {
  description = "Correspondance groupe Keycloak → politiques OpenBao (groupes externes)."
  type        = map(list(string))
  default = {
    "plateforme-admins" = ["plateforme-admin"]
    "plateforme"        = ["plateforme-lecture", "ansible-lab"]
    "support"           = ["plateforme-lecture"]
    "securite"          = ["securite-audit"]
    "mediagenda"        = ["mediagenda-dev"]
  }
}
