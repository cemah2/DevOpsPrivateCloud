# politiques/plateforme-admin.hcl — EXTRAIT : bloc AJOUTÉ en M25-E16 (SEC-2616). Exploitation de la PKI
# de services : CSR et import de la cérémonie, émetteurs, rôle, CRL, révocation, essais de signature.
# La clé de la CA, générée « internal », n'est exportable par aucun chemin de l'API.
# « patch » : modification PARTIELLE d'un émetteur ou d'un rôle (bao patch, méthode HTTP PATCH) ; un
# « bao write » sur pki-services/issuer/<id> ou pki-services/roles/<rôle> REMPLACE l'objet entier
# (champs omis remis à leur valeur par défaut). Vérifié sur OpenBao 2.7.1 : sans « patch », 403.
path "pki-services/*" {
  capabilities = ["create", "read", "update", "patch", "delete", "list"]
}
