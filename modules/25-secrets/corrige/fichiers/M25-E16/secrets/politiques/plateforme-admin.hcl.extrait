# politiques/plateforme-admin.hcl — EXTRAIT : bloc AJOUTÉ en M25-E16 (SEC-2616). Exploitation de la PKI
# de services : CSR et import de la cérémonie, émetteurs, rôle, CRL, révocation, essais de signature.
# La clé de la CA, générée « internal », n'est exportable par aucun chemin de l'API.
path "pki-services/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}
