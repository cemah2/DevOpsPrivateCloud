# .gitlab-ci.yml — plateforme/secrets — EXTRAIT : job AJOUTÉ en M25-E36 (INC-5236).
# Contrôle de dérive de la méthode gitlab/ et des rôles ci-* sur le coffre RÉEL (lecture seule), avec
# l'identité du pipeline (rôle ci-plateforme-secrets, politique tofu-secrets). Il tourne :
#   - après chaque apply de main (le coffre doit être conforme juste après) ;
#   - chaque nuit (pipeline planifié « derive-nuit » sur main, Build > Pipeline schedules) : une
#     modification à la main se voit avant le premier job applicatif du matin.
# Limite connue : si la MÉTHODE gitlab/ elle-même est cassée (variante « clés injoignables »), ce job
# ne peut pas se connecter et échoue à la connexion : c'est déjà le signal (il est le seul à
# échouer la nuit). La réparation se fait alors depuis adm01 (bris de glace d'E10).

roles-ci:verifier:
  extends: .tofu
  stage: appliquer
  needs:
    - job: tofu:apply
      optional: true
  interruptible: false
  before_script:
    - test "$(id -un)" = gitlab-runner
    - . outils/openbao-ci.sh ci-plateforme-secrets
  script:
    - outils/verifier-roles-ci.sh gitlab
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
    # Sur push de main : attend l'apply manuel (needs), puis contrôle le résultat.
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH && $CI_PIPELINE_SOURCE == "push"

# tofu:plan et tofu:apply n'ont aucune règle pour les pipelines planifiés (source « schedule ») :
# la nuit, on CONTRÔLE, on n'applique rien sans relecture.
