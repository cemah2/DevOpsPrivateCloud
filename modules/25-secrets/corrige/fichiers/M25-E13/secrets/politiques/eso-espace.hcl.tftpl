# Gabarit de politique eso-<espace> — plateforme/secrets (M25-E13 ; chemins creds en M25-E14).
# Rendu par tofu/eso-espaces.tf pour chaque espace applicatif : le SecretStore « openbao » de
# l'espace ne lit que les secrets de SON application et de SON environnement.
path "kv/data/${application}/${environnement}/*" {
  capabilities = ["read"]
}
%{ for chemin in chemins_creds ~}

# Identifiants dynamiques (générateur VaultDynamicSecret, M25-E14).
path "${chemin}" {
  capabilities = ["read"]
}
%{ endfor ~}
