# politiques/wb-checks.hcl — EXTRAIT : chemins AJOUTÉS en M25-E41 (INC-5241) à la politique des
# vérifications. Configuration de la PKI de services : émetteur par défaut et son usage, réglages de la
# CRL. Aucune de ces lectures ne renvoie de clé privée (une clé « internal » n'est exportable par
# aucun chemin) ; l'émetteur renvoie son certificat, public.
path "pki-services/config/issuers" {
  capabilities = ["read"]
}

path "pki-services/issuer/+" {
  capabilities = ["read"]
}

path "pki-services/config/crl" {
  capabilities = ["read"]
}
