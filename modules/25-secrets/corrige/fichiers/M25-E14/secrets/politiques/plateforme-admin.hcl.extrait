# politiques/plateforme-admin.hcl — EXTRAIT : blocs AJOUTÉS en M25-E14 (DEV-2614).
# Configuration du moteur db-mediagenda (connexions, rôles, rotation de la racine) ; identifiants
# dynamiques de la RECETTE seulement (essais, observation) : ceux de la prod ne sont demandés que par
# le SecretStore de mediagenda-prod.
path "db-mediagenda/config/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

path "db-mediagenda/roles/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}

path "db-mediagenda/rotate-root/*" {
  capabilities = ["update"]
}

path "db-mediagenda/creds/mediagenda-api-recette" {
  capabilities = ["read"]
}

path "db-mediagenda/creds/mediagenda-migrateur-recette" {
  capabilities = ["read"]
}

# Baux : lister (exige « sudo »), renouveler (révoquer est déjà permis au palier 1).
path "sys/leases/lookup/db-mediagenda/*" {
  capabilities = ["list", "sudo"]
}

path "sys/leases/renew" {
  capabilities = ["update"]
}
