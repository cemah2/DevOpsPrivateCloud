# tofu/eso-espaces.tf — EXTRAIT (M25-E14) : les espaces de MédiAgenda reçoivent la lecture des
# identifiants dynamiques de LEUR environnement (gabarit politiques/eso-espace.hcl.tftpl, M25-E13).
locals {
  espaces_eso = {
    "mediagenda-dev" = { application = "mediagenda", environnement = "dev", chemins_creds = [] }
    "mediagenda-recette" = {
      application   = "mediagenda"
      environnement = "recette"
      chemins_creds = ["db-mediagenda/creds/mediagenda-api-recette", "db-mediagenda/creds/mediagenda-migrateur-recette"]
    }
    "mediagenda-prod" = {
      application   = "mediagenda"
      environnement = "prod"
      chemins_creds = ["db-mediagenda/creds/mediagenda-api-prod", "db-mediagenda/creds/mediagenda-migrateur-prod"]
    }
    "medidoc-dev"     = { application = "medidoc", environnement = "dev", chemins_creds = [] }
    "medidoc-recette" = { application = "medidoc", environnement = "recette", chemins_creds = [] }
  }
}
