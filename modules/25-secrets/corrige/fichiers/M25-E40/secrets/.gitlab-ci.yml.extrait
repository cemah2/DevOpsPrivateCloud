# .gitlab-ci.yml — plateforme/secrets — EXTRAIT : job AJOUTÉ en M25-E40 (INC-5240) à l'étape lint.
# Test des politiques sur un OpenBao de développement JETABLE lancé par le job lui-même (runner01,
# exécuteur shell, bao déjà installé par openbao_client) : aucune connexion à la grappe, aucun jeton
# d'identité, aucun secret. Un écart bloque la MR AVANT le plan, donc avant tout apply.

politiques:tester:
  stage: lint
  tags: [shell]
  interruptible: true
  variables:
    # Un port par job : deux pipelines en parallèle sur runner01 ne se gênent pas.
    TESTER_POLITIQUES_PORT: ""
  script:
    - export TESTER_POLITIQUES_PORT="$((18000 + CI_JOB_ID % 1000))"
    - outils/tester-politiques.sh politiques tests/politiques/capacites.tsv
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH
      changes:
        - politiques/**/*
        - tests/politiques/**/*
        - outils/tester-politiques.sh
