# politiques/plateforme-admin.hcl — À AJOUTER (M25-E24, PLAT-2624) : exploiter la grappe Raft.
# Vérifié sur OpenBao 2.7.1 : « list-peers », « autopilot state|get-config|set-config » et
# « snapshot save » n'exigent pas « sudo » ; « bao operator step-down » (sys/step-down) l'EXIGE
# (403 avec « update » seul). Le retrait d'un pair (RB-251 : VM détruite pour de bon) est un geste
# rare, tracé par l'audit, jamais une réparation de panne (M25-E39).
path "sys/storage/raft/configuration" {
  capabilities = ["read"]
}

path "sys/storage/raft/autopilot/state" {
  capabilities = ["read"]
}

path "sys/storage/raft/autopilot/configuration" {
  capabilities = ["read", "update"]
}

path "sys/storage/raft/snapshot" {
  capabilities = ["read"]
}

path "sys/storage/raft/remove-peer" {
  capabilities = ["update"]
}

# Passage de témoin du nœud actif (bascules d'E24, montée de version d'E29).
path "sys/step-down" {
  capabilities = ["update", "sudo"]
}
