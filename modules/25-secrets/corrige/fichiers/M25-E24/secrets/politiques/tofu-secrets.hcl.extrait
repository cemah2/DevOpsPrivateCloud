# politiques/tofu-secrets.hcl — À AJOUTER (M25-E24, PLAT-2624) : tofu/autopilot.tf (vault_raft_autopilot)
# lit et écrit la configuration d'autopilot. Aucun autre chemin de sys/storage/raft/ (instantanés,
# retrait d'un pair) : ce sont des gestes d'exploitation, pas de la configuration.
path "sys/storage/raft/autopilot/configuration" {
  capabilities = ["read", "update"]
}
