# politiques/wb-checks.hcl — EXTRAIT : chemins AJOUTÉS en M25-E24 (PLAT-2624) à la politique du
# M25-E07/E08. Toujours des métadonnées : état de la grappe, réglages d'autopilot. Aucune valeur de
# secret, aucun instantané (sys/storage/raft/snapshot n'est PAS ici). Politique complète, tous
# paliers confondus : fichiers/M25-E46/secrets/politiques/wb-checks.hcl.

# (M25-E24) Pairs Raft, état et réglages d'autopilot (lab/bin/check 25 24 et suivants).
path "sys/storage/raft/configuration" {
  capabilities = ["read"]
}

path "sys/storage/raft/autopilot/state" {
  capabilities = ["read"]
}

path "sys/storage/raft/autopilot/configuration" {
  capabilities = ["read"]
}
