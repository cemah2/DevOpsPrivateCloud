# politiques/wb-checks.hcl — EXTRAIT : chemins AJOUTÉS par le palier 3 (M25-E24, E28) à la politique
# du M25-E07/E08. Toujours des métadonnées : état de la grappe, réglages d'autopilot, quotas. Aucune
# valeur de secret, aucun instantané (sys/storage/raft/snapshot n'est PAS ici).

# (M25-E24) Pairs Raft, état et réglages d'autopilot (lab/bin/check 25 24 et suivants).
path "sys/storage/raft/configuration" {
  capabilities = ["read"]
}

path "sys/storage/raft/autopilot/state" {
  capabilities = ["read"]
}

path "sys/storage/raft/autopilot/configuration" {
  capabilities = ["read"]
}

# (M25-E28) Quotas de débit : liste et réglages.
path "sys/quotas/rate-limit" {
  capabilities = ["list"]
}

path "sys/quotas/rate-limit/*" {
  capabilities = ["read"]
}
