# politiques/plateforme-admin.hcl — À AJOUTER (M25-E21, SEC-2621) : l'astreinte enquête dans l'audit.
# Lister les dispositifs (exige « sudo », lecture seule malgré le nom) et calculer le HMAC d'une
# valeur pour la retrouver dans le journal (même droit que securite-audit). Les dispositifs
# eux-mêmes ne se créent PAS par l'API (déclarés dans openbao.hcl) : aucun droit d'écriture ici.
path "sys/audit" {
  capabilities = ["read", "sudo"]
}

path "sys/audit-hash/*" {
  capabilities = ["update"]
}
