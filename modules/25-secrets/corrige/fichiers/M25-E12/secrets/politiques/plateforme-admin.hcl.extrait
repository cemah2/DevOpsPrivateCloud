# politiques/plateforme-admin.hcl — EXTRAIT : bloc AJOUTÉ en M25-E12 (PLAT-2612). L'espace d'essais
# est à la plateforme : lecture et écriture des secrets d'essai.
path "kv/data/wb-essais/*" {
  capabilities = ["create", "read", "update", "delete"]
}

path "kv/metadata/wb-essais/*" {
  capabilities = ["create", "read", "update", "delete", "list"]
}
