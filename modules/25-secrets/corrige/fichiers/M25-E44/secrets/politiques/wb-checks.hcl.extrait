# politiques/wb-checks.hcl — EXTRAIT : chemin AJOUTÉ en M25-E44 (PLAT-2644). État du trousseau de la
# barrière : terme, date d'installation, nombre de chiffrements. Aucune clé (le trousseau lui-même
# n'est lisible par aucune API, même avec sudo). « read » suffit (vérifié sur OpenBao 2.7.1) ;
# sys/rotate, lui, exige update + sudo et n'est PAS ici.
path "sys/key-status" {
  capabilities = ["read"]
}
