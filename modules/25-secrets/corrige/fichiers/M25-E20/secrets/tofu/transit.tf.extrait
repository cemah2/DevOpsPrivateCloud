# tofu/transit.tf — À AJOUTER (M25-E20, SEC-2620) : clé de signature Cosign.
# Asymétrique ECDSA P-256 (comme la clé du M13) : OpenBao signe une empreinte (transit/sign/…/sha2-256)
# et publie la clé PUBLIQUE (transit/keys/cosign-medisphere) ; la clé privée n'existe que dans le
# coffre (générée par lui, jamais importée : elle n'a jamais existé ailleurs).
# PAS de rotation automatique : une nouvelle version = une nouvelle clé publique ; toutes les
# vérifications (composant securite, porte de déploiement, Kyverno au M26) doivent la connaître AVANT.
# C'est un changement planifié (docs/securite/secrets/cle-signature.md), pas une tâche de fond.
resource "vault_transit_secret_backend_key" "cosign_medisphere" {
  backend = vault_mount.transit.path
  name    = "cosign-medisphere"
  type    = "ecdsa-p256"

  exportable             = false
  allow_plaintext_backup = false
  deletion_allowed       = false
}
