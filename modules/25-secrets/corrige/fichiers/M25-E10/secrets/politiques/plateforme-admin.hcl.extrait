# politiques/plateforme-admin.hcl — EXTRAIT : blocs AJOUTÉS en M25-E10 (SEC-2610) à la politique du
# palier 1. Les secrets des APPLICATIONS restent illisibles pour la plateforme (palier 1) ; mais
# c'est elle qui y DÉPOSE les secrets de pipeline (jetons de promotion, de release) et, en M25-E13,
# ceux des environnements : dépôt en ÉCRITURE SEULE (create, update ; pas read) dans le moteur KV v2.
# On peut écrire une nouvelle version, jamais lire une valeur. Essayé : « bao kv put » réussit,
# « bao kv get » répond « permission denied ».
# Chemins écrits en clair par application (pas « kv/data/+/ci/* ») : une règle avec des « + » a une
# PRIORITÉ plus faible qu'une règle plus générale comme « kv/metadata/* » du palier 1, qui
# l'emporterait (essayé : écriture des métadonnées refusée).
path "kv/data/mediagenda/*" {
  capabilities = ["create", "update"]
}

path "kv/data/medidoc/*" {
  capabilities = ["create", "update"]
}

# Essai du refus de M25-E10 (retiré avec le rôle d'essai).
path "kv/data/formation/*" {
  capabilities = ["create", "update"]
}

# Métadonnées (versions conservées, métadonnées personnalisées), sans suppression.
path "kv/metadata/mediagenda/*" {
  capabilities = ["create", "read", "update", "list"]
}

path "kv/metadata/medidoc/*" {
  capabilities = ["create", "read", "update", "list"]
}

path "kv/metadata/formation/*" {
  capabilities = ["create", "read", "update", "list"]
}
