# politiques/wb-checks.hcl — EXTRAIT : blocs AJOUTÉS en M25-E10 à la politique du palier 1 (E07/E08),
# qui lit déjà auth/+/config et auth/+/role/+ (configuration des méthodes et des rôles JWT,
# Kubernetes, AppRole). Ajouts pour les vérifications du palier 2 : configuration des connexions et
# des rôles du moteur database, rôles PKI, et la liste des baux d'identifiants dynamiques. Rien qui
# donne une valeur : ni kv/data/*, ni */creds/*, ni */issue/*, ni */sign/*. Relu : la configuration
# d'une connexion de base renvoie l'URL avec ses gabarits {{username}}/{{password}}, jamais le mot
# de passe.

path "db-mediagenda/config/*" {
  capabilities = ["read", "list"]
}

path "db-mediagenda/roles/*" {
  capabilities = ["read", "list"]
}

path "pki-services/roles/*" {
  capabilities = ["read", "list"]
}

# Lister des baux exige « sudo » (API sys/leases/lookup ; essayé : « list » seul est refusé). Limité
# au préfixe des identifiants dynamiques : on voit des identifiants de baux, jamais les comptes.
path "sys/leases/lookup/db-mediagenda/*" {
  capabilities = ["list", "sudo"]
}
