# plateforme/secrets — .gitlab-ci.yml : EXTRAIT, jobs de rotation planifiée (M25-E33, SEC-2633).
# Pipeline planifié (CI/CD → Schedules) : chaque lundi 06:10, branche main, variable ROTATION=oui.
# Sur le runner protégé du socle (shell, runner01) qui a bao, jq, curl ; aucun secret en variable de CI.
# Un échec du pipeline planifié envoie un courriel à plateforme@ (notifications du projet) :
# c'est l'alerte « secret en retard » demandée par Sophie.
stages: [rotation, verification]

.openbao:
  id_tokens:
    OPENBAO_ID_TOKEN:
      aud: openbao.medisphere.internal
  variables:
    BAO_ADDR: https://openbao.par1.medisphere.internal:8200
  before_script:
    # Le jeton d'identité passe par l'entrée standard (« jwt=- »), jamais en argument (ps, journaux).
    - export BAO_TOKEN="$(printf '%s' "$OPENBAO_ID_TOKEN" | bao write -field=token auth/gitlab/login role=ci-secrets-rotation jwt=-)"
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule" && $ROTATION == "oui" && $CI_COMMIT_REF_PROTECTED == "true"
  tags: [socle, protege]

rotation:clients-keycloak:
  extends: .openbao
  stage: rotation
  script:
    - outils/rotation/client-keycloak.sh grafana plateforme/grafana/oidc
    - outils/rotation/client-keycloak.sh argocd plateforme/argocd/oidc

rotation:jetons-gitlab:
  extends: .openbao
  stage: rotation
  script:
    # Jetons d'accès de projet décrits par leurs métadonnées (gitlab_projet, gitlab_portees…).
    - outils/rotation/jeton-gitlab.sh plateforme/argocd/depot-gitops

rotation:comptes-de-service:
  extends: .openbao
  stage: rotation
  script:
    # Mot de passe du rôle PostgreSQL « openbao » des connexions du moteur database : seul OpenBao le
    # connaît, il le change lui-même (rotate-root). Aucun consommateur à prévenir.
    - bao write -f db-mediagenda/rotate-root/mediagenda-recette
    - bao write -f db-mediagenda/rotate-root/mediagenda-prod

verification:consommateurs:
  extends: .openbao
  stage: verification
  # Laisser ESO (5 min) et Reloader faire leur travail avant de couper les anciens secrets.
  when: delayed
  start_in: 15 minutes
  script:
    - outils/rotation/client-keycloak-verifier.sh grafana plateforme/grafana/oidc https://grafana.apps.par1.medisphere.internal/api/health
    - outils/rotation/client-keycloak-verifier.sh argocd plateforme/argocd/oidc https://argocd.apps.par1.medisphere.internal/healthz
    - outils/rotation/jeton-gitlab-revoquer.sh plateforme/argocd/depot-gitops

verification:ages:
  extends: .openbao
  stage: verification
  needs: []
  script:
    - outils/rotation/controle-ages.sh plateforme/
  artifacts:
    when: always
    paths: [rapport-ages.tsv]
    expire_in: 90 days
