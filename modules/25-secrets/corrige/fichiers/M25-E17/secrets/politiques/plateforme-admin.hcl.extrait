# politiques/plateforme-admin.hcl — À AJOUTER (M25-E17, SEC-2617) : administrer les clés de transit.
# Créer, lire, régler (rotation automatique, min_decryption_version), tourner, détruire une clé
# dont deletion_allowed est vrai (la clé d'essai). Chiffrer et déchiffrer avec les clés de la
# plateforme pour l'exploitation (rechiffrement en masse, diagnostic).
# Volontairement ABSENT : transit/export/* et transit/backup/* (une clé ne sort pas, même pour
# un administrateur ; et nos clés sont créées non exportables : la question ne se pose pas).
path "transit/keys" {
  capabilities = ["list"]
}

path "transit/keys/*" {
  capabilities = ["create", "read", "update", "delete"]
}

path "transit/encrypt/*" {
  capabilities = ["update"]
}

path "transit/decrypt/*" {
  capabilities = ["update"]
}

path "transit/rewrap/*" {
  capabilities = ["update"]
}

path "transit/datakey/*" {
  capabilities = ["update"]
}

# Signature et vérification (clé cosign-medisphere, M25-E20 : re-signature exceptionnelle).
path "transit/sign/*" {
  capabilities = ["update"]
}

path "transit/verify/*" {
  capabilities = ["update"]
}
