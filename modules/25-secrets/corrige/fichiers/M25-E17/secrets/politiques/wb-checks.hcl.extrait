# politiques/wb-checks.hcl — À AJOUTER à la fin du fichier (M25-E17, SEC-2617).
# Métadonnées des clés de transit : type, versions, dates, réglages (exportable, rotation…). Pour
# une clé symétrique non exportable, la lecture ne renvoie AUCUN matériel de clé ; pour une clé
# asymétrique (cosign-medisphere, E20) elle renvoie la clé PUBLIQUE, qui n'est pas un secret.
# Jamais transit/export/*, transit/backup/*, transit/decrypt/*.
path "transit/keys" {
  capabilities = ["list"]
}

path "transit/keys/+" {
  capabilities = ["read"]
}
