# politiques/tofu-secrets.hcl — À AJOUTER (M25-E17, SEC-2617) : le pipeline de plateforme/secrets gère
# désormais tofu/transit.tf. Sans ces blocs, le « plan » du pipeline échoue dès qu'il relit une clé
# (403 sur transit/keys/<clé>). Configuration des clés seulement : ni encrypt, ni decrypt, ni export.
path "transit/keys" {
  capabilities = ["list"]
}

path "transit/keys/*" {
  capabilities = ["create", "read", "update", "delete"]
}
