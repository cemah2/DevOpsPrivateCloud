{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InstantanesOpenBaoNonEffacables",
      "Effect": "Deny",
      "Principal": { "AWS": ["arn:aws:iam::000000000000:user/openbao-instantanes"] },
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": ["arn:aws:s3:::openbao-instantanes", "arn:aws:s3:::openbao-instantanes/*"]
    }
  ]
}
