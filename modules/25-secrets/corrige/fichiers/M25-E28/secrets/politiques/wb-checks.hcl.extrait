# politiques/wb-checks.hcl — EXTRAIT : chemins AJOUTÉS en M25-E28 (SEC-2628). Quotas de débit : liste
# et réglages (aucune valeur). Politique complète : fichiers/M25-E46/secrets/politiques/wb-checks.hcl.
path "sys/quotas/rate-limit" {
  capabilities = ["list"]
}

path "sys/quotas/rate-limit/*" {
  capabilities = ["read"]
}
