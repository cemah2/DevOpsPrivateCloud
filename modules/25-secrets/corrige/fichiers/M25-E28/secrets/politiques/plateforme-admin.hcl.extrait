# politiques/plateforme-admin.hcl — À AJOUTER (M25-E28, SEC-2628) : lancer et alimenter la génération
# d'un jeton racine. Dans OpenBao 2.6.4 / 2.7.1 la génération passe par sys/generate-root-token,
# AUTHENTIFIÉ (l'ancien sys/generate-root non authentifié est désactivé). Essayé : ces deux chemins
# suffisent, sans « sudo ». Ce droit seul ne donne RIEN : il faut encore trois clés de récupération
# (trois dépositaires). Personne d'autre que plateforme-admins (OTP obligatoire) ne l'a.
path "sys/generate-root-token/attempt" {
  capabilities = ["read", "update", "delete"]
}

path "sys/generate-root-token/update" {
  capabilities = ["update"]
}
