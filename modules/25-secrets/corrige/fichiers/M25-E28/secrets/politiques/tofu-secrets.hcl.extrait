# politiques/tofu-secrets.hcl — À AJOUTER (M25-E28, SEC-2628) : tofu/quotas.tf (vault_quota_rate_limit).
# Le réglage des durées par méthode (methodes.tf, sys/auth/<méthode>/tune) est déjà couvert par
# sys/auth/* (M25-E10).
path "sys/quotas/rate-limit/*" {
  capabilities = ["create", "read", "update", "delete"]
}
