# tofu/methodes.tf — EXTRAIT : réglages de durée AJOUTÉS au M25-E28 (SEC-2628). Les noms des
# ressources jwt « gitlab » (M25-E10) et kubernetes « k8s-par1 » (M25-E12) sont ceux du palier 2 :
# adapte-les à ton fichier. Chaque méthode a un maximum EXPLICITE (0 = « valeur du système »,
# que lab/bin/check 25 28 refuse) ; le filet global est max_lease_ttl = 24h dans openbao.hcl.
#   oidc      : 1 h par défaut, 8 h au plus (déjà réglé au M25-E06 : une journée de travail)
#   approle   : 10 min / 1 h (les rôles règlent plus court : batch de 5 à 10 min)
#   gitlab    : 10 min / 1 h (un job ; les rôles ci-<projet> règlent 10 min)
#   k8s-par1  : 1 h / 24 h (ESO renouvelle ; cert-manager redemande à chaque signature)

resource "vault_auth_backend" "approle" {
  type        = "approle"
  path        = "approle"
  description = "Machines : vérifications, medictl, pipelines Ansible, instantanés"

  tune {
    default_lease_ttl = "10m"
    max_lease_ttl     = "1h"
    token_type        = "default-service"
  }
}

# Dans la ressource vault_jwt_auth_backend du montage « gitlab » (M25-E10), ajoute :
#   tune {
#     default_lease_ttl = "10m"
#     max_lease_ttl     = "1h"
#     token_type        = "default-service"
#   }
# Dans la ressource vault_auth_backend du montage « k8s-par1 » (M25-E12), ajoute :
#   tune {
#     default_lease_ttl = "1h"
#     max_lease_ttl     = "24h"
#     token_type        = "default-service"
#   }
