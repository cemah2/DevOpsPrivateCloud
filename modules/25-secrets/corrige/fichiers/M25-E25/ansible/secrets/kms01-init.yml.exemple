# secrets/kms01-init.yml — MODÈLE de STRUCTURE (M25-E25). Même procédure et même outil qu'en M25-E03
# (outils/openbao-parts.sh), avec la clé « kms01_init » :
#   BAO_ADDR=https://kms01.par1.medisphere.internal:8200 bao operator init -format=json \
#       -key-shares=5 -key-threshold=3 \
#     | PARTS_CLE=kms01_init JETON_POUR=<MOI> outils/openbao-parts.sh chiffrer pki/openbao-depositaires.txt \
#     | uv run ansible-vault encrypt --encrypt-vault-id critique --output secrets/kms01-init.yml -
# Mêmes dépositaires que la grappe (décision écrite : garde-des-parts.md). Descellement de kms01 :
#   PARTS_FICHIER=secrets/kms01-init.yml PARTS_CLE=kms01_init BAO_ADDR=https://kms01…:8200 \
#     outils/openbao-parts.sh desceller <N> <IDENTITÉ-AGE>        (trois dépositaires)
{
  "kms01_init": {
    "date": "<DATE>",
    "serveur": "https://kms01.par1.medisphere.internal:8200",
    "parts": 5,
    "seuil": 3,
    "depositaires": [
      {"numero": 1, "depositaire": "claire.morel", "destinataire": "age1…", "part": "-----BEGIN AGE ENCRYPTED FILE-----…"},
      {"numero": 2, "depositaire": "karim.benali", "destinataire": "age1…", "part": "…"},
      {"numero": 3, "depositaire": "sophie.laurent", "destinataire": "age1…", "part": "…"},
      {"numero": 4, "depositaire": "nadia.roussel", "destinataire": "age1…", "part": "…"},
      {"numero": 5, "depositaire": "<MOI>", "destinataire": "age1…", "part": "…"}
    ],
    "jeton_racine": {"pour": "<MOI>", "chiffre": "…",
                     "note": "jeton racine initial de kms01 : révoqué à la fin de M25-E25"}
  }
}
