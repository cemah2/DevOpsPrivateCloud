# secrets/openbao-init.yml — MODÈLE de STRUCTURE (M25-E03). Le vrai fichier est chiffré par
# Ansible Vault (identité « critique ») et n'est JAMAIS écrit en clair : il est produit d'un seul
# tube par
#   bao operator init -format=json -key-shares=5 -key-threshold=3 \
#     | JETON_POUR=<MOI> outils/openbao-parts.sh chiffrer pki/openbao-depositaires.txt \
#     | uv run ansible-vault encrypt --encrypt-vault-id critique --output secrets/openbao-init.yml -
# Double protection : il faut l'identité Vault « critique » pour ouvrir le fichier, PUIS la clé
# privée age du dépositaire pour lire SA part. Personne ne lit les cinq.
# Contenu (JSON, donc YAML valide) :
{
  "openbao_init": {
    "date": "2026-10-23T09:12:44Z",
    "serveur": "https://openbao.par1.medisphere.internal:8200",
    "parts": 5,
    "seuil": 3,
    "depositaires": [
      {"numero": 1, "depositaire": "claire.morel", "destinataire": "age1…",
       "part": "-----BEGIN AGE ENCRYPTED FILE-----\n…\n-----END AGE ENCRYPTED FILE-----"},
      {"numero": 2, "depositaire": "karim.benali", "destinataire": "age1…", "part": "…"},
      {"numero": 3, "depositaire": "sophie.laurent", "destinataire": "age1…", "part": "…"},
      {"numero": 4, "depositaire": "nadia.roussel", "destinataire": "age1…", "part": "…"},
      {"numero": 5, "depositaire": "<MOI>", "destinataire": "age1…", "part": "…"}
    ],
    "jeton_racine": {"pour": "<MOI>", "chiffre": "-----BEGIN AGE ENCRYPTED FILE-----…",
                     "note": "jeton racine initial, à révoquer en M25-E08 (bao token revoke -self)"}
  }
}
