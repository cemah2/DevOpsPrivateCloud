# tofu/transit.tf — À AJOUTER (M25-E18, PLAT-2618) : clé de transit de SOPS.
# SOPS ne chiffre pas les fichiers avec elle : il tire une clé de données (AES-256) par fichier et
# demande à transit de CHIFFRER cette clé de données (transit/encrypt/sops-plateforme). Déchiffrer
# un fichier = transit/decrypt/sops-plateforme sur la clé de données, puis AES-GCM en local.
# Pas de rotation automatique : une rotation ne gêne pas SOPS (les anciennes versions déchiffrent),
# mais « sops updatekeys / rotate » doit suivre pour profiter de la nouvelle version (voir corrigé).
resource "vault_transit_secret_backend_key" "sops_plateforme" {
  backend = vault_mount.transit.path
  name    = "sops-plateforme"
  type    = "aes256-gcm96"

  exportable             = false
  allow_plaintext_backup = false
  deletion_allowed       = false
}
