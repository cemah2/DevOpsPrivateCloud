# ce que les autres exercices du palier ont pu y ajouter ; les autres groupes sont inchangés).
  default = {
    "plateforme-admins" = ["plateforme-admin", "sops-plateforme"]
    "plateforme"        = ["plateforme-lecture", "sops-plateforme"]
    "support"           = ["plateforme-lecture"]
    "securite"          = ["securite-audit"]
    "mediagenda"        = ["mediagenda-dev"]
  }
