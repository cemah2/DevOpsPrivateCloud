# {{ conntrackd_fichier }} — {{ inventory_hostname }}
# {{ conntrackd_entete }}
# Source : rôle conntrackd (M07-E27). Modèle : /usr/share/doc/conntrackd/examples/sync/ftfw/.
# Les transitions (commandes -c -f -R -B / -t -n) sont appelées par /usr/local/sbin/bordure-transition.

Sync {
	Mode FTFW {
		# Après « conntrackd -t » (passage en BACKUP), les entrées du noyau devenues fausses
		# expirent au bout de ce délai (secondes).
		PurgeTimeout {{ conntrackd_purge_timeout }}
		# Demande l'état complet au pair au démarrage (passerelle redémarrée).
		StartupResync on
	}
	UDP {
		IPv4_address {{ conntrackd_adresse_locale }}
		IPv4_Destination_Address {{ conntrackd_adresse_pair }}
		Port {{ conntrackd_port }}
		Interface {{ conntrackd_interface }}
		SndSocketBuffer 1249280
		RcvSocketBuffer 1249280
		Checksum on
	}
}

General {
	HashSize 32768
	HashLimit 131072
	LogFile off
	Syslog on
	LockFile /var/lock/conntrack.lock
	UNIX {
		Path /var/run/conntrackd.ctl
	}
	NetlinkBufferSize 2097152
	NetlinkBufferSizeMaxGrowth 8388608
	Filter From Userspace {
		Protocol Accept {
{% for p in conntrackd_protocoles %}
			{{ p }}
{% endfor %}
		}
		Address Ignore {
{% for a in conntrackd_adresses_ignorees %}
			IPv4_address {{ a }}
{% endfor %}
		}
	}
}
