# /etc/systemd/system/ms-verif-reseau.service — installé par « task install:systeme » (M07-E29).
[Unit]
Description=Sonde de la bordure et des répartiteurs (ms-verif-reseau)
Documentation=https://git01.par1.medisphere.internal/plateforme/outils/-/blob/main/docs/astreinte.md
After=network-online.target
Wants=network-online.target
OnFailure=ms-alerte@%n.service

[Service]
Type=oneshot
User=admin
Group=admin
ExecStart=/usr/local/bin/ms-verif-reseau --quiet --prometheus /var/lib/ms-verif/reseau.prom
StateDirectory=ms-verif
StateDirectoryMode=0755
TimeoutStartSec=180
# Durcissement (M02-E26) : la sonde lit la clé de supervision dans ~admin/.config/workbook.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
