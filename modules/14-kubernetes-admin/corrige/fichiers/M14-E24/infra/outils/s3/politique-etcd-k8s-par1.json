{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SauvegardesEtcdNonEffacables",
      "Effect": "Deny",
      "Principal": { "AWS": ["arn:aws:iam::000000000000:user/etcd-k8s"] },
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketVersioning",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy"
      ],
      "Resource": ["arn:aws:s3:::etcd-k8s-par1", "arn:aws:s3:::etcd-k8s-par1/*"]
    }
  ]
}
