# host_vars/s3-01/seaweedfs.yml — EXTRAIT : ajouts de M14-E24 (rôle seaweedfs, M05-E10).
# Les deux secrets vault_s3_etcd_k8s_* sont visibles de s3-01 ET des nœuds de contrôle : place-les dans
# un fichier Vault « critique » lu par les deux (ex. group_vars/all/vault-critique-s3.yml), pas en double.
seaweedfs_identites:
  # … identités existantes (tofu-etat, admin-s3…) …
  # Sauvegardes etcd de k8s-par1 : lecture (restauration depuis adm01), écriture (nœuds de contrôle),
  # listage (contrôle de l'envoi). La suppression et le versionnage sont refusés par la politique du
  # compartiment (plateforme/infra outils/s3/politique-etcd-k8s-par1.json).
  - nom: etcd-k8s
    cle_acces: "{{ vault_s3_etcd_k8s_cle_acces }}"
    cle_secrete: "{{ vault_s3_etcd_k8s_cle_secrete }}"
    actions: [Read:etcd-k8s-par1, Write:etcd-k8s-par1, List:etcd-k8s-par1]

seaweedfs_compartiments:
  # … compartiments existants (tofu-state…) …
  - nom: etcd-k8s-par1
    versionnage: true
