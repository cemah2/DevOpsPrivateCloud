# /etc/systemd/system/k8s-certificats.service — adm01 (M14-E26, SEC-1526)
# Échéances des certificats de k8s-par1 ; échec (un certificat sous 30 jours) → ms-alerte@.
[Unit]
Description=Échéances des certificats de k8s-par1 (seuil 30 jours)
Documentation=https://git01.par1.medisphere.internal/plateforme/medisphere/-/blob/main/docs/kubernetes/runbooks/RB-143-renouveler-les-certificats.md
Wants=network-online.target
After=network-online.target
OnFailure=ms-alerte@%n.service

[Service]
Type=oneshot
User=admin
# Copie installée depuis plateforme/k8s par « task install:systeme » (même principe que les ms-verif-*).
ExecStart=/usr/local/bin/k8s-certificats-echeances --seuil 30 --quiet
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
