# ~/.config/workbook/pve-tofu.env — accès d'OpenTofu à l'API Proxmox (M05-E03).
# Dossier 700, fichier 600, JAMAIS dans un dépôt. Inscrit au registre des secrets.
# Chargement dans le shell avant tofu plan / apply :
#   set -a; . ~/.config/workbook/pve-tofu.env; set +a
# En CI (M05-E26) : mêmes noms en variables protégées et masquées de plateforme/infra.
#
# <IP-PVE01> : une adresse présente dans le certificat de pve01 (comme PVE_API_URL, M00-E17).
# <SECRET>   : affiché UNE fois par « pveum user token add » ; à coller avec l'éditeur.

# Noms lus par le provider bpg/proxmox (documentation du provider, « Environment Variables »).
# L'adresse se termine par « :8006/ », SANS /api2/json (le provider l'ajoute lui-même).
PROXMOX_VE_ENDPOINT="https://<IP-PVE01>:8006/"
# Format imposé : UTILISATEUR@ROYAUME!JETON=SECRET (une seule chaîne).
PROXMOX_VE_API_TOKEN="wb-tofu@pve!tofu=<SECRET>"

# Pas de PROXMOX_VE_INSECURE : la vérification TLS reste active (défaut false), avec
# l'autorité de pve01 du magasin système d'adm01 (M03-E02).
