# versions-outils.env — versions et empreintes des outils de la chaîne IaC (M05-E25).
#
# Source unique de vérité : lu par outils/analyse-securite.sh, par le rôle Ansible
# gitlab_runner (runner01, M05-E26) et recopié dans .gitlab-ci.yml pour Trivy (le job
# vérifie l'empreinte AVANT de lancer l'outil).
# Changer une ligne = MR « build: … » avec, dans la description : lien vers la note de
# version, sommes relevées, vérification de signature faite (qui, quand, comment).
#
# Relevé du 2026-10-07. Format : shell (sourcé), sans espace autour de « = ».

# Trivy — https://github.com/aquasecurity/trivy/releases/tag/v0.75.0
# Archive vérifiée par trivy_0.75.0_checksums.txt ET par la signature Sigstore
# (trivy_0.75.0_Linux-64bit.tar.gz.sigstore.json, identité reusable-release.yaml@refs/tags/v0.75.0).
TRIVY_VERSION=0.75.0
TRIVY_ARCHIVE_SHA256=c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f
# Empreinte du binaire « trivy » extrait de cette archive (c'est lui qu'on contrôle avant usage).
TRIVY_BINAIRE_SHA256=93f9da8e4ba5e0c1c76d8234ed2494cf9afb0a96fd21953e424bb795f3299b8e

# Checkov — https://pypi.org/project/checkov/ (installé par uv tool, version exacte)
CHECKOV_VERSION=3.3.26

# Terragrunt — https://github.com/gruntwork-io/terragrunt/releases/tag/v1.1.6
# Binaire terragrunt_linux_amd64, vérifié par SHA256SUMS (lui-même signé, SHA256SUMS.sigstore.json).
TERRAGRUNT_VERSION=1.1.6
TERRAGRUNT_SHA256=d75a80bb264758ba00dabcb17f4b507fcdab4ca90d9e41f96750df036bf69b04

# tflint — https://github.com/terraform-linters/tflint/releases/tag/v0.64.0 (tflint_linux_amd64.zip)
TFLINT_VERSION=0.64.0
TFLINT_ZIP_SHA256=cca9d13e2e1d7a2c627af60ff899a3c9b74212899416aeb96ec764d2ef954537

# terraform-docs — https://github.com/terraform-docs/terraform-docs/releases/tag/v0.24.0
TERRAFORM_DOCS_VERSION=0.24.0
TERRAFORM_DOCS_TGZ_SHA256=9005daf969de0b50134493a2c00078b49f5f5b39d021cda7c89bf4d4f3d776d3
