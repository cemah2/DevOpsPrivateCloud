# ~/.config/workbook/s3-admin.env — identité S3 « admin-s3 » : BRIS DE GLACE (M05-E10)
# Fichier 600, jamais dans un dépôt, inscrit au registre des secrets (portée : tout SeaweedFS).
# Usage réservé : création/politique des compartiments, restauration d'un état (M05-E29),
# incident. Jamais pour OpenTofu ni en CI. Chargé dans un sous-shell, puis oublié :
#   ( set -a; . ~/.config/workbook/s3-admin.env; set +a; aws s3api get-bucket-policy --bucket tofu-state )
AWS_ACCESS_KEY_ID=<CLE-ACCES-ADMIN-S3>
AWS_SECRET_ACCESS_KEY=<CLE-SECRETE-ADMIN-S3>
AWS_PROFILE=s3-socle
