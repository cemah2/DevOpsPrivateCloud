# ~/.config/workbook/s3-tofu.env — identité S3 « tofu-etat » (M05-E10 ; utilisé par OpenTofu à partir de M05-E11)
# Fichier 600 dans un dossier 700. Jamais dans un dépôt. Inscrit au registre des secrets.
# Chargement : set -a; . ~/.config/workbook/s3-tofu.env; set +a
AWS_ACCESS_KEY_ID=<CLE-ACCES-TOFU-ETAT>
AWS_SECRET_ACCESS_KEY=<CLE-SECRETE-TOFU-ETAT>
# Profil de ~/.aws/config qui donne l'adresse de s3-01 et l'ancre TLS à la CLI aws.
# OpenTofu ne lit pas ce profil (son backend porte endpoints) ; il lit les deux clés ci-dessus.
AWS_PROFILE=s3-socle
