# composants/versions.env — versions ÉPINGLÉES du réseau de k8s-par1 (M15-E23). Lu par Taskfile.yml
# (dotenv) et par la CI (job versions-epinglees). Une montée de version = une MR qui change CE fichier
# (et rien d'autre ne doit contenir de version : c'est le contrôle de la CI).
CILIUM_VERSION=1.20.2
GATEWAY_API_VERSION=v1.6.1
CERT_MANAGER_CHART=oci://quay.io/jetstack/charts/cert-manager
CERT_MANAGER_VERSION=v1.21.2
EXTERNAL_DNS_REPO=https://kubernetes-sigs.github.io/external-dns
EXTERNAL_DNS_CHART_VERSION=1.23.0
