# roles/sonde_reseau/files/etat-reseau — EXTRAIT à intégrer (M15-E26, PLAT-1626) : routes des adresses
# de service de Kubernetes, pour ms-verif-k8s-reseau. À placer avant le « jq -n » final du script de
# M07-E29, puis ajouter « --argjson routes_service "$routes_service" » et « routes_service: $routes_service »
# à l'objet produit. Lecture seule (ip route), aucune nouvelle commande permise au compte supervision.
#
# Une route ECMP apparaît dans « ip -j route » avec un tableau « nexthops » ; une route à un seul saut
# avec « gateway » ; la route de rejet avec « type: blackhole » et aucun saut.
routes_service="$(ip -j -4 route show root 10.10.41.0/24 2>/dev/null \
  | jq -c '[.[] | {dst: (.dst | sub("/32$"; "")), type: (.type // "unicast"),
                  sauts: ([(.nexthops // [])[].gateway] + (if .gateway then [.gateway] else [] end))}]' \
  2>/dev/null || echo '[]')"
