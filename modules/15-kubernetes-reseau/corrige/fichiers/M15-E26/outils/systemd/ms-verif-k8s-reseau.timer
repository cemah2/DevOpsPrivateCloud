# /etc/systemd/system/ms-verif-k8s-reseau.timer — M15-E26 (PLAT-1626)
# 5 minutes : une session BGP tombée ou un certificat qui ne se renouvelle pas doivent être vus dans
# l'heure, pas le lendemain ; une sonde plus fréquente chargerait l'API pour rien (Prometheus, M21).
[Unit]
Description=MédiSphère : sonde du réseau de k8s-par1 toutes les 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true
AccuracySec=15s
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
