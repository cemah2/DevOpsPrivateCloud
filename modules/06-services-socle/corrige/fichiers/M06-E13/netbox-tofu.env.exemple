# ~/.config/workbook/netbox-tofu.env — accès d'OpenTofu à NetBox (M06-E13). Dossier 700, fichier 600.
# Inscrit au registre des secrets. Chargement : set -a; . ~/.config/workbook/netbox-tofu.env; set +a
# En CI (plateforme/infra) : même nom, variable PROTÉGÉE et MASQUÉE.
# Jeton v2 du compte svc-automatisation (M06-E10), restreint aux adresses de adm01 et runner01.
TF_VAR_netbox_api_token="nbt_<CLE>.<JETON>"
