{
  "Dhcp4": {
    "authoritative": true,
    "control-sockets": [
      {
        "socket-name": "kea4-ctrl-socket",
        "socket-type": "unix"
      }
    ],
    "interfaces-config": {
      "dhcp-socket-type": "udp",
      "interfaces": [
        "ens18"
      ]
    },
    "lease-database": {
      "lfc-interval": 3600,
      "name": "kea-leases4.csv",
      "persist": true,
      "type": "memfile"
    },
    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [
          {
            "output": "stdout",
            "pattern": "%-5p %m\n"
          }
        ],
        "severity": "INFO"
      }
    ],
    "option-data": [
      {
        "data": "10.10.20.10",
        "name": "domain-name-servers"
      },
      {
        "data": "par1.medisphere.internal",
        "name": "domain-name"
      },
      {
        "data": "par1.medisphere.internal",
        "name": "domain-search"
      }
    ],
    "rebind-timer": 37800,
    "renew-timer": 21600,
    "subnet4": [
      {
        "id": 99,
        "option-data": [
          {
            "data": "10.10.99.1",
            "name": "routers"
          },
          {
            "data": "10.10.99.1",
            "name": "ntp-servers"
          }
        ],
        "pools": [
          {
            "pool": "10.10.99.100 - 10.10.99.199"
          }
        ],
        "subnet": "10.10.99.0/24",
        "user-context": {
          "commentaire": "VLAN 99 SANDBOX, relay\u00e9 par gw01 (giaddr 10.10.99.1), M00-E14"
        }
      }
    ],
    "user-context": {
      "gere-par": "Fichier g\u00e9r\u00e9 par Ansible (projet plateforme/ansible). Toute modification manuelle sera \u00e9cras\u00e9e au prochain passage."
    },
    "valid-lifetime": 43200
  }
}
