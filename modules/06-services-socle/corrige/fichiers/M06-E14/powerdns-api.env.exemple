# ~/.config/workbook/powerdns-api.env — accès à l'API de PowerDNS Authoritative (M06-E14).
# Dossier 700, fichier 600, jamais dans un dépôt ; inscrit au registre des secrets.
# La clé est celle de vault_powerdns_api_cle (Vault « critique », M06-E06).
# Lu par : curl (source du fichier), OpenTofu (TF_VAR_*), medictl dns (M06-E15, PDNS_*).
PDNS_SERVER_URL="http://dns01.par1.medisphere.internal:8081"
PDNS_API_KEY="<CLE-API-POWERDNS>"
TF_VAR_pdns_api_key="${PDNS_API_KEY}"
