# /etc/systemd/system/medictl-dns-sync.service — M06-E15 (PLAT-725)
# Zones PowerDNS générées depuis NetBox (NetBox est seulement LU ; le jeton de svc-automatisation
# sert, un jeton en lecture seule suffirait).
# Code 4 = conflits signalés (rien écrit pour eux) : l'unité échoue et ms-alerte@ prévient.

[Unit]
Description=MédiSphère : DNS généré depuis NetBox
After=network-online.target medictl-netbox-sync.service
Wants=network-online.target
OnFailure=ms-alerte@%n.service

[Service]
Type=oneshot
User=admin
Environment=MEDICTL_NETBOX_TOKEN_FILE=/home/admin/.config/workbook/netbox-auto.token
Environment=MEDICTL_PDNS_ENV_FILE=/home/admin/.config/workbook/powerdns-api.env
ExecStart=/home/admin/.local/bin/medictl -v dns sync
TimeoutStartSec=2min
SyslogIdentifier=medictl-dns-sync
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
