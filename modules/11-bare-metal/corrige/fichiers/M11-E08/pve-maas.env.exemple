# ~/.config/workbook/pve-maas.env — jeton Proxmox du pilotage d'alimentation (M11-E08)
# Même format que pve-api.env (M00-E17). Fichier SECRET : mode 600, jamais dans un dépôt.
#   install -m 600 /dev/null ~/.config/workbook/pve-maas.env
# Lu (sans être exécuté) par outils/alim.sh et les vérifications ; le même jeton est saisi dans
# MAAS (M11-E10). Inscrit au registre des secrets.
PVE_API_URL="https://<IP-PVE01>:8006/api2/json"
PVE_NODE="<NOEUD>"
PVE_TOKEN_ID="wb-maas@pve!maas"
PVE_TOKEN_SECRET="<SECRET-AFFICHE-UNE-SEULE-FOIS>"
PVE_CACERT="$HOME/.config/workbook/pve-root-ca.pem"   # ancre conforme de pve01 (M02-E08)
