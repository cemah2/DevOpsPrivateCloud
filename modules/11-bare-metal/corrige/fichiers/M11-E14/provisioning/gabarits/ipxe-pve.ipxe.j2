#!ipxe
{# gabarits/ipxe-pve.ipxe.j2 — installation de Proxmox VE par le réseau (M11-E14). Choisi par
   outils/netbox-provision.py pour une machine à installer de plate-forme NetBox « proxmox-ve-9 ».
   Noyau et initrd produits par « proxmox-auto-install-assistant prepare-iso --pxe-loader ipxe »
   (l'initrd contient tout l'installateur, le jeton et l'empreinte du certificat de pxe01),
   déposés sous /pve/<version>/ par playbooks/pve-installateur.yml.
   Variables : m (machine), p (parametres.yml : serveur_http, pve_version, pve_noyau_arguments). -#}
# ipxe/mac-{{ m.mac_tirets }}.ipxe — GÉNÉRÉ par outils/netbox-provision.py depuis NetBox : ne pas modifier.
# {{ m.nom }} — statut NetBox « {{ m.statut }} », plate-forme {{ m.plateforme }}, {{ m.ip }}
set base {{ p.serveur_http }}
echo {{ m.nom }} : installation de Proxmox VE {{ p.pve_version }}, le disque va être effacé (initrd volumineux : patience).
kernel ${base}/pve/{{ p.pve_version }}/vmlinuz {{ p.pve_noyau_arguments }} || goto echec
initrd ${base}/pve/{{ p.pve_version }}/initrd.img || goto echec
boot || goto echec

:echec
echo {{ m.nom }} : échec du chargement de l'installateur PVE. Démarrage sur le disque local dans 30 s.
sleep 30
exit
