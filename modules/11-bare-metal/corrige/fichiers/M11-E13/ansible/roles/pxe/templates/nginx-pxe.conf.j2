# /etc/nginx/sites-available/pxe — {{ inventory_hostname }}
# {{ pxe_entete }}
# Chaîne de provisioning MédiSphère (M11-E13) : HTTPS seulement pour tout ce qui s'exécute ou
# s'installe ; le port 80 ne sert plus qu'une redirection (le défi ACME HTTP-01 est servi par le
# client step pendant l'émission, nginx arrêté).

server {
    listen {{ pxe_adresse }}:80;
    server_name {{ pxe_nom_serveur }};
    access_log /var/log/nginx/pxe-acces.log;
    error_log /var/log/nginx/pxe-erreurs.log;
    location / {
        return 301 https://{{ pxe_nom_serveur }}$request_uri;
    }
}
{% if pxe_https | bool %}

server {
    listen {{ pxe_adresse }}:443 ssl;
    http2 off;
    server_name {{ pxe_nom_serveur }};

    # Chaîne complète (feuille + intermédiaire) : iPXE ne connaît que la racine.
    ssl_certificate     {{ pxe_tls_certificat }};
    ssl_certificate_key {{ pxe_tls_cle }};
    ssl_protocols       {{ pxe_tls_protocoles }};
    ssl_session_cache   shared:pxe:1m;

    root {{ pxe_racine_http }};
    autoindex off;
    default_type application/octet-stream;
    access_log /var/log/nginx/pxe-acces.log;
    error_log /var/log/nginx/pxe-erreurs.log;

{% for reseau in pxe_http_autorises %}
    allow {{ reseau }};
{% endfor %}
    deny all;

    # Scripts iPXE : texte, lecture seule, jamais mis en cache.
    location = /boot.ipxe {
        default_type text/plain;
        add_header Cache-Control "no-store";
        limit_except GET { deny all; }
    }
    location /ipxe/ {
        default_type text/plain;
        add_header Cache-Control "no-store";
        limit_except GET { deny all; }
        try_files $uri =404;
    }

    # Fichiers de réponse et installateur PVE (son initrd contient un jeton) : VLAN 60 et adm01.
    location ~ ^/(preseed|kickstart|pve)/ {
{% for c in pxe_reponses_autorises %}
        allow {{ c }};
{% endfor %}
        deny all;
        default_type text/plain;
        add_header Cache-Control "no-store";
        limit_except GET { deny all; }
        try_files $uri =404;
    }

    location / {
        limit_except GET { deny all; }
        try_files $uri =404;
    }

    # Service de réponse de l'installateur Proxmox VE (rôle pve_reponses, M11-E14).
    include /etc/nginx/pxe.d/*.conf;
}
{% endif %}
