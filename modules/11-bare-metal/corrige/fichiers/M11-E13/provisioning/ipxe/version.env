# shellcheck shell=bash
# ipxe/version.env — version épinglée de l'amont iPXE et racine attendue (M11-E13).
# Toute modification passe par une MR : elle change le binaire servi à tous les serveurs.
#
# IPXE_COMMIT : identifiant complet du commit de l'étiquette, relevé sur
#   https://github.com/ipxe/ipxe/tags (et contrôlé par « git ls-remote --tags »).
# RACINE_SHA256 : empreinte SHA-256 de « MédiSphère Root CA » (sans « : »), celle de la
#   politique de certification (docs/socle/pki/politique-certification.md, M06-E33).
IPXE_DEPOT=https://github.com/ipxe/ipxe.git
IPXE_ETIQUETTE=v2.0.0
IPXE_COMMIT="<COMMIT-DE-L-ETIQUETTE>"
RACINE_SHA256="<EMPREINTE-SHA256-DE-LA-RACINE>"
