# ~/.config/workbook/ilo-hp01.env — accès Redfish/IPMI à l'iLO 4 de hp01 (M11-E07)
#
# Fichier SECRET : mode 600, dossier ~/.config/workbook en 700, jamais dans un dépôt.
# Créé vide avec les bons droits AVANT d'y écrire le mot de passe :
#   install -m 600 /dev/null ~/.config/workbook/ilo-hp01.env
# Lu (sans être exécuté) par outils/redfish.sh, outils/alim.sh et les vérifications du workbook.
# Inscrit au registre des secrets (docs/socle/registre-secrets.md).

ILO_HOST="<IP-ILO-HP01>"            # adresse de l'iLO sur le LAN maison
ILO_NOM_TLS="<NOM-TLS-ILO>"         # nom porté par le certificat de l'iLO (CN / SAN), ex. ILOCZ12345678
ILO_USER="wb-redfish"
ILO_PASSWORD="<MOT-DE-PASSE-GÉNÉRÉ>"  # 24 caractères aléatoires, sans guillemet ni barre oblique inverse
