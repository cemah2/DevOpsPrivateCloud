# À INTÉGRER dans group_vars/role_routeur/pare_feu.yml (la matrice des flux de la bordure, commune à
# gw01 et gw02 depuis M07-E24, version v2 de M07-E30). M11-E02 : DHCP du VLAN 60.
# (iLO : M11-E07 ; MAAS : M11-E10 ; isolement du VLAN 60 : M11-E13.)
# Déjà couverts par la matrice v2, rien à ajouter :
#   définition V_PROV ("ens19.60") et ens19.60 dans LAB_IFS ;
#   réponses de Kea au relais : règle d'entrée « réponses des serveurs Kea au relais de la
#     passerelle (giaddr propre) » (M07-E24), sans destination : elle vaut pour 10.10.60.2/.3 ;
#   VLAN 60 → DNS 10.10.20.10/.16 (règle « DNS du lab », source NETS_LAB) ;
#   VLAN 60 → Internet (règle « lab vers Internet », LAB_IFS) : installateurs ;
#   VLAN 60 → NTP de la passerelle (entrée NTP sur LAB_IFS) ;
#   adm01 → VLAN 60 (règle « bastion (MGMT) vers tout le lab »).
# La documentation (docs/socle/matrice-flux.md) est régénérée par ms-matrice-flux (M07-E30).

# --- pare_feu_entree : ajout (M11-E02) ---
  - {entree: $V_PROV, proto: udp, ports_source: 68, ports: 67,
     motif: "clients DHCP du VLAN 60 (PXE, iPXE, installateurs) vers le relais", ref: M11-E02}

# --- pare_feu_transit : ajout (à côté de la règle équivalente du VLAN 99) ---
  - {entree: $V_PROV, destination: [$DNS01, $DNS02], proto: udp, ports_source: 68, ports: 67,
     motif: "renouvellements DHCP (T1) en unicast vers le serveur Kea du bail, VLAN 60", ref: M11-E02}
