# À INTÉGRER dans host_vars/gw01/pare_feu.yml (la matrice des flux de la bordure, appliquée à gw01
# ET gw02 depuis M07-E24). M11-E02 : DHCP du VLAN 60. (iLO : M11-E07 ; MAAS : M11-E10.)
# Déjà couverts par l'existant, rien à ajouter :
#   VLAN 60 → DNS 10.10.20.10/.16 (règle « DNS du lab », source NETS_LAB) ;
#   VLAN 60 → Internet (règle « lab vers Internet », LAB_IFS contient ens19.60) : installateurs ;
#   VLAN 60 → NTP de la passerelle (entrée NTP sur LAB_IFS) ;
#   adm01 → VLAN 60 (règle « bastion (MGMT) vers tout le lab »).

# --- pare_feu_definitions : ajouts ---
  - {nom: V_PROV, valeur: '"ens19.60"'}

# --- pare_feu_entree : ajouts (M11-E02) ---
  - {entree: $V_PROV, proto: udp, ports_source: 68, ports: 67,
     motif: "clients DHCP du VLAN 60 (PXE, iPXE, installateurs) vers le relais", ref: M11-E02}
  - {entree: $V_INFRA, source: [$DNS01, $DNS02], destination: [10.10.60.2, 10.10.60.3], proto: udp, ports_source: 67, ports: 67,
     motif: "réponses des serveurs Kea adressées au giaddr du VLAN 60", ref: M11-E02}

# --- pare_feu_transit : ajouts ---
  - {entree: $V_PROV, destination: [$DNS01, $DNS02], proto: udp, ports_source: 68, ports: 67,
     motif: "renouvellements DHCP (T1) en unicast, VLAN 60", ref: M11-E02}
