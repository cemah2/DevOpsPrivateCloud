# capi/versions.env — versions de Cluster API du module 18 (M18-E08). Lu par capi/init.sh.
# CAPMOX 0.9 n'est compatible qu'avec CAPI 1.11 et 1.12 (README de CAPMOX v0.9.1) : on reste en
# 1.12 même si 1.14 existe. CAPI 1.12 accepte des clusters de charge de travail 1.36 dès 1.12.8.
CAPI_VERSION=v1.12.11
CAPMOX_VERSION=v0.9.1
IPAM_INCLUSTER_VERSION=v1.1.1
# Repli (vérification préalable en échec) : fournisseur Docker, même version que le cœur.
CAPD_VERSION=v1.12.11
