# lab/lab.env — EXTRAIT : réglages du mini-projet du module 18 (M18-E25), à aligner sur l'ADR-0180.
# 1 = l'ADR garde l'objet (le contrôle vérifie alors qu'il est sain), 0 = l'ADR le supprime (le contrôle
# vérifie qu'il a disparu).
WB_M18_TEMPLATES_CONSERVES=0   # templates Cluster API 9060-9069
WB_M18_WBCAPI_CONSERVE=0       # compte Proxmox wb-capi@pve, jeton capi, rôle WBCapi
