# talos/versions.env — versions de talos-essai (M18-E05 ; montées en M18-E06 par MR sur ce fichier).
# Lu par generer.sh, appliquer.sh et monter.sh ; aucune donnée secrète.
# ⚠️ Changer ces lignes ne change RIEN sur les nœuds : c'est monter.sh (talosctl upgrade,
# upgrade-k8s) qui le fait. Les écrire AVANT, pour que la configuration régénérée suive les nœuds.
TALOS_VERSION=v1.14.2
KUBERNETES_VERSION=1.36.5
# Identifiant du schéma de l'Image Factory (plateforme/infra, envs/m18/talos-schema.yaml) :
# extension siderolabs/qemu-guest-agent. Installeur de la plateforme nocloud.
TALOS_SCHEMA_ID=ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515
TALOS_CLUSTER=talos-essai
TALOS_ENDPOINT=https://talos-01.par1.medisphere.internal:6443
