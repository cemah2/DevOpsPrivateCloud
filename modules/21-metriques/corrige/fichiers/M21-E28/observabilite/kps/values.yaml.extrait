# plateforme/observabilite — kps/values.yaml : changement de M21-E28 (PLAT-2228).
# EXTRAIT : seule la clé ajoutée est montrée.
prometheus:
  prometheusSpec:
    # Chemin de secours des notifications : les alertes qui disent « l'Alertmanager du cluster ne
    # notifie plus » (AlertmanagerFailedToSendAlerts, AlertmanagerClusterDown, AlertmanagerFailedReload…)
    # sont AUSSI envoyées à l'Alertmanager témoin de mon01, qui écrit à l'astreinte par son propre
    # chemin. Seules celles-là (alert_relabel_configs « keep ») : sinon chaque alerte du cluster
    # partirait deux fois.
    # Le chart rend cette liste dans un Secret (kps-prometheus-am-confg) ajouté à la configuration
    # d'alerting ; le retrait de prometheus_replica s'applique aussi (règle globale de l'opérateur).
    # Flux : K8S_TRAV → mon01:9093 (pare_feu.yml, M21-E28).
    additionalAlertManagerConfigs:
      - scheme: http
        api_version: v2
        timeout: 10s
        static_configs:
          - targets: ["mon01.par1.medisphere.internal:9093"]
        alert_relabel_configs:
          - source_labels: [alertname]
            regex: "Alertmanager.+"
            action: keep
