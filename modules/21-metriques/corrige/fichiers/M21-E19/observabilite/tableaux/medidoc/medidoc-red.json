      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "environnement:medidoc_requetes:taux5m{environnement=\"$environnement\"}",
          "legendFormat": "requêtes/s",
          "refId": "A",
          "range": true
