        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(environnement:medidoc_requetes:taux5m, environnement)",
          "refId": "variable"
        },
        "definition": "label_values(environnement:medidoc_requetes:taux5m, environnement)",
