# composants/cilium/values.yaml (plateforme/k8s) — EXTRAIT (M21-E20, PLAT-2220) : ServiceMonitor
# de Cilium, à fusionner dans les sections existantes (M15-E26 : métriques déjà actives). Release
# Helmfile « cilium » (M17-E10) :
#   helmfile -e par1 -l composant=cilium diff     (lis-le : seuls des ServiceMonitor et des
#                                                  étiquettes doivent apparaître)
#   helmfile -e par1 -l composant=cilium apply
# Les ServiceMonitor ne changent pas la ConfigMap de Cilium : aucun redémarrage des agents
# (rollOutCiliumPods: false). Si le diff montre une modification de cilium-config, arrête-toi.
# trustCRDsExist : le chart vérifie la présence des CRD monitoring.coreos.com/v1 à la génération ;
# avec helm diff (sans accès aux capacités réelles), la vérification peut échouer : on lui dit
# qu'elles existent (elles sont installées par kube-prometheus-stack depuis E02).
prometheus:
  enabled: true                         # 9962 (M15-E26)
  serviceMonitor:
    enabled: true
    trustCRDsExist: true
    labels:
      medisphere.internal/supervision: "oui"
operator:
  prometheus:
    enabled: true                       # 9963 (M15-E26)
    serviceMonitor:
      enabled: true
      labels:
        medisphere.internal/supervision: "oui"
envoy:
  prometheus:
    enabled: true                       # 9964 (M15-E26)
    serviceMonitor:
      enabled: true
      labels:
        medisphere.internal/supervision: "oui"
hubble:
  metrics:
    # (liste « enabled » et port 9965 du M15-E26 inchangés)
    serviceMonitor:
      enabled: true
      labels:
        medisphere.internal/supervision: "oui"
