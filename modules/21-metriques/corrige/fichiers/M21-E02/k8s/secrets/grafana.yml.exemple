# plateforme/k8s — secrets/grafana.yml (M21-E02) : MODÈLE en clair, jamais commité rempli.
# Le vrai fichier est chiffré par Ansible Vault « critique » :
#   uv run --project ~/src/ansible ansible-vault create --vault-id critique@$HOME/src/ansible/outils/vault-pass-client.sh secrets/grafana.yml
# Puis : outils/secrets-k8s.sh appliquer grafana && outils/secrets-k8s.sh verifier grafana
# Inscris le Secret au registre des secrets (M06-E28). Rotation du mot de passe : M21-E29.
grafana_admin_user: "admin"
grafana_admin_password: "<MOT-DE-PASSE-DE-24-CARACTERES-AU-MOINS>"
