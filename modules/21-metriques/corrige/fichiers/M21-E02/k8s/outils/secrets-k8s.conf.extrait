# outils/secrets-k8s.conf (plateforme/k8s) — EXTRAIT : ligne ajoutée par M21-E02 (format de M19-E04).
# Grafana (sous-chart de kube-prometheus-stack, grafana.admin.existingSecret) : compte « admin » de
# bris de glace, lu à la PREMIÈRE initialisation de la base seulement (rotation : M21-E29).
# Vault « critique » secrets/grafana.yml (modèle secrets/grafana.yml.exemple) :
#   grafana_admin_user: admin    grafana_admin_password: <24 caractères au moins>
grafana  supervision  grafana-admin  admin-user=vault:grafana_admin_user admin-password=vault:grafana_admin_password
