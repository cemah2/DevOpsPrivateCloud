# plateforme/k8s — outils/secrets-k8s.sh : composant « thanos » (M21-E24, PLAT-2224).
# EXTRAIT à intégrer au script du M20 : reprends SES fonctions de lecture du Vault et
# d'application (noms différents chez toi). Principe inchangé : le secret ne passe ni par un
# fichier en clair, ni par la ligne de commande (visible dans ps), ni par l'écran.
#
# Vault « critique » : secrets/thanos.yml (modèle : secrets/thanos.yml.exemple), deux clés :
#   thanos_s3_access_key, thanos_s3_secret_key (utilisateur RGW « thanos », M21-E24 étape 2).
# Secret produit : supervision/thanos-objstore, clé objstore.yml (format objstore de Thanos),
# lu par les sidecars (prometheusSpec.thanos.objectStorageConfig), le Store et le Compactor.

composant_thanos() {
  local vault
  # vault_lire FICHIER : déchiffre un fichier du Vault « critique » sur la sortie standard
  # (fonction commune du script M20 : ansible-vault view --vault-id critique@…).
  vault="$(vault_lire secrets/thanos.yml)" || return 1
  local ak sk
  ak="$(yq -r '.thanos_s3_access_key' <<<"$vault")"
  sk="$(yq -r '.thanos_s3_secret_key' <<<"$vault")"
  [[ -n "$ak" && "$ak" != null && -n "$sk" && "$sk" != null ]] || {
    echo "secrets/thanos.yml : clés thanos_s3_access_key / thanos_s3_secret_key absentes" >&2
    return 1
  }
  # Le document objstore.yml est construit en mémoire, puis passé à kubectl par l'entrée standard.
  # insecure: false + ca_file : TLS vérifié contre la racine MédiSphère (montée par chaque
  # composant dans /etc/thanos/ca, ConfigMap racine-medisphere).
  # bucket_lookup_type: path : le RGW du lab n'a pas de joker DNS (*.rgw.par1…) pour le style
  # « virtual-host » (même choix que pour aws cli, M08 : s3.addressing_style path).
  AK="$ak" SK="$sk" yq -n '
    .type = "S3" |
    .config.bucket = "thanos-k8s-par1" |
    .config.endpoint = "rgw.par1.medisphere.internal" |
    .config.region = "us-east-1" |
    .config.insecure = false |
    .config.bucket_lookup_type = "path" |
    .config.access_key = strenv(AK) |
    .config.secret_key = strenv(SK) |
    .config.http_config.tls_config.ca_file = "/etc/thanos/ca/ca.crt"
  ' | kubectl -n supervision create secret generic thanos-objstore \
        --from-file=objstore.yml=/dev/stdin --dry-run=client -o yaml \
    | kubectl label --local -f - -o yaml app.kubernetes.io/part-of=thanos \
    | kubectl apply --server-side --field-manager=secrets-k8s -f -
}

# Dans l'aiguillage du script (case "$composant" in …) :
#   thanos) composant_thanos ;;
