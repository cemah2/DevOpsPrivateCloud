# plateforme/k8s — secrets/thanos.yml (M21-E24) : MODÈLE en clair, jamais commité rempli.
# Le vrai fichier est chiffré par Ansible Vault « critique » :
#   uv run --project ~/src/ansible ansible-vault create --vault-id critique@<SCRIPT> secrets/thanos.yml
# Valeurs : sortie de radosgw-admin pour l'utilisateur RGW « thanos » (ceph/thanos-rgw.sh), copiées
# depuis ~/.config/workbook/s3-thanos.env, puis inscrites au registre des secrets (M06-E28).
thanos_s3_access_key: "<CLE-D-ACCES-RGW-THANOS>"
thanos_s3_secret_key: "<CLE-SECRETE-RGW-THANOS>"
