# ~/.config/workbook/s3-thanos.env (M21-E24) — MODÈLE. Le vrai fichier est en 600, jamais dans un dépôt.
# Écrit par ceph/thanos-rgw.sh sans afficher la clé ; lu par aws cli, « thanos tools bucket » et
# les checks du module 21 (lecture du compartiment thanos-k8s-par1).
AWS_ACCESS_KEY_ID=<CLE-D-ACCES-RGW-THANOS>
AWS_SECRET_ACCESS_KEY=<CLE-SECRETE-RGW-THANOS>
AWS_ENDPOINT_URL=https://rgw.par1.medisphere.internal
AWS_DEFAULT_REGION=us-east-1
# aws cli ≥ 2.23 ajoute des sommes de contrôle que le RGW peut refuser (voir M08).
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
