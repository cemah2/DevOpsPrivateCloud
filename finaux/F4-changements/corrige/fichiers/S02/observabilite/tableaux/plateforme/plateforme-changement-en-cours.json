{
  "uid": "f4-changement-en-cours",
  "title": "Changement en cours — sonde de continuité",
  "tags": [
    "changement",
    "continuite",
    "f4"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Source",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Secondes d'erreur cumulées (période affichée)",
      "description": "Même calcul que outils/mesurer-interruption.sh et les checks du final F4 : règle la période sur la fenêtre du changement.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "avg_over_time(max(continuite:en_erreur)[$__range:15s]) * $__range_s",
          "legendFormat": "s",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes de la sonde en erreur (période affichée)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(k6_http_reqs_total{testid=~\"sonde-continuite.*\", expected_response=\"false\"}[$__range]))",
          "legendFormat": "requêtes",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Budget d'erreur restant — MédiAgenda prod (Pyrra, 28 j)",
      "description": "Disponibilité mesurée par Pyrra sur la fenêtre de l'objectif (M21-E26) ; objectif 99,5 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "pyrra_availability{slo=\"mediagenda-disponibilite\"}",
          "legendFormat": "disponibilité",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sonde de charge active",
      "description": "0 = la charge k6 ne tourne pas : la mesure ne repose alors que sur les sondes de mon01.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(continuite:charge_requetes:taux30s)",
          "legendFormat": "req/s",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Interruption (1 = au moins un signal d'erreur)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max(continuite:en_erreur)",
          "legendFormat": "continuite:en_erreur"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "max(continuite:sondes_en_erreur:max)",
          "legendFormat": "sondes mon01"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "continuite:charge_erreurs:taux30s > bool 0",
          "legendFormat": "charge k6"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "continuite:prod_5xx:taux1m > bool 0",
          "legendFormat": "5xx prod"
        }
      ]
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Disponibilité par sonde (mon01, groupes continuite-*)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min by (service) (probe_success{job=\"blackbox\", groupe=~\"continuite-.+\"})",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taux d'erreurs : charge k6 et 5xx de MédiAgenda prod",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "continuite:charge_erreurs:taux30s / clamp_min(continuite:charge_requetes:taux30s, 0.001)",
          "legendFormat": "charge k6 (part en erreur)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum(rate(mediagenda_http_requests_total{namespace=\"mediagenda-prod\", route!~\"/sante|/pret|/metrics\", code=~\"5..\"}[1m])) / sum(rate(mediagenda_http_requests_total{namespace=\"mediagenda-prod\", route!~\"/sante|/pret|/metrics\"}[1m]))",
          "legendFormat": "5xx prod (part)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latence MédiAgenda prod (serveur) p95/p99 et sonde (k6)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mediagenda_http_request_duration_seconds_bucket{namespace=\"mediagenda-prod\", route!~\"/sante|/pret|/metrics\"}[1m])))",
          "legendFormat": "p95 serveur"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mediagenda_http_request_duration_seconds_bucket{namespace=\"mediagenda-prod\", route!~\"/sante|/pret|/metrics\"}[1m])))",
          "legendFormat": "p99 serveur"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "max(k6_http_req_duration_p95{testid=~\"sonde-continuite.*\", cible=\"prod\"})",
          "legendFormat": "p95 sonde (cumulé)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "vector(0.25)",
          "legendFormat": "SLO 250 ms"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Vitesse de consommation du budget (Pyrra, fenêtres courtes)",
      "description": "Au-delà de 14 sur 5 min ET 1 h, l'alerte critique de Pyrra part (M21-E27).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (slo) ({__name__=~\"mediagenda_http_requests:burnrate5m|mediagenda_http_requests:burnrate1h\", slo=\"mediagenda-disponibilite\"})",
          "legendFormat": "{{__name__}}"
        }
      ]
    }
  ]
}