{
  "uid": "plateforme-consommation-locataires",
  "title": "Consommation par locataire",
  "tags": [
    "plateforme",
    "locataires",
    "refacturation",
    "medisphere"
  ],
  "editable": false,
  "description": "Réservé, utilisé et facturé par locataire Capsule : CPU, mémoire, stockage (F2-S08, PLAT-3208).",
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 41,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "locataire",
        "label": "Locataire",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(espace:locataire:info, locataire)",
          "refId": "locataires"
        },
        "definition": "label_values(espace:locataire:info, locataire)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "sort": 1,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "RB-328 — refacturation interne",
      "type": "link",
      "url": "https://git01.par1.medisphere.internal/plateforme/medisphere/-/blob/main/docs/accueil/runbooks/RB-328-refacturation-interne.md",
      "targetBlank": true,
      "icon": "doc",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Lire ce tableau",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Consommation par **locataire Capsule** (règles `locataire:*`, `regles/enregistrement-locataires.yaml`). *Réservé* = requests des pods en cours ; *utilisé* = consommation réelle ; *facturé* = le plus grand des deux. Rapport mensuel : RB-328 (`docs/accueil/mesures/refacturation-AAAA-MM.md`)."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU réservé par locataire (cœurs)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:cpu_demande:somme{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU utilisé par locataire (cœurs)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:cpu_utilise:taux5m{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mémoire réservée par locataire",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:memoire_demandee:somme{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mémoire utilisée par locataire",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:memoire_utilisee:somme{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Stockage en bloc : demandé et utilisé",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:stockage_demande:somme{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}} demandé",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:stockage_utilise:somme{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}} utilisé",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Réservé / utilisé (CPU) : efficacité des requests",
      "description": "Proche de 0 : le locataire réserve beaucoup plus qu'il n'utilise (requests à revoir, VPA). Au-dessus de 1 : il consomme au-delà de ses requests (rafales, risque d'éviction).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:cpu_utilise:taux5m{locataire=~\"$locataire\"} / locataire:cpu_demande:somme{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Part du quota CPU réservée",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "locataire:quota_cpu:ratio{locataire=~\"$locataire\"}",
          "legendFormat": "{{locataire}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Facturé sur la période affichée (moyennes)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Moyenne sur la période choisie en haut à droite : pour un mois, choisis « mois précédent » ; c'est la base du rapport de RB-328.",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(locataire:cpu_facture:max{locataire=~\"$locataire\"}[$__range])",
          "legendFormat": "cpu",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(locataire:memoire_facturee:max{locataire=~\"$locataire\"}[$__range]) / 2^30",
          "legendFormat": "memoire",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time(locataire:stockage_demande:somme{locataire=~\"$locataire\"}[$__range]) / 2^30",
          "legendFormat": "stockage",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "CPU facturé (cœurs)",
              "Value #B": "Mémoire facturée (Gio)",
              "Value #C": "Stockage demandé (Gio)",
              "locataire": "Locataire"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ]
}
