# Gabarit de politique <equipe>-equipe — plateforme/secrets (F2-S02, PLAT-3202), rendu par tofu/equipes.tf.
# Personnes du groupe ${equipe} (connexion OIDC) : elles gèrent elles-mêmes les secrets de leurs
# environnements (kv/${equipe}/<environnement>/*), en libre-service, sans ticket. Jamais :
#   - kv/${equipe}/ci/* (jetons de groupe rangés par la CI de plateforme/equipes) ;
#   - kv/destroy ni la suppression des métadonnées (destruction de toutes les versions) : Plateforme ;
#   - un autre chemin que kv/${equipe}/ (ni la plateforme, ni une autre équipe).
%{ for env in ecriture ~}

path "kv/data/${equipe}/${env}/*" {
  capabilities = ["create", "read", "update", "delete"]
}

path "kv/metadata/${equipe}/${env}/*" {
  capabilities = ["read", "list"]
}

path "kv/delete/${equipe}/${env}/*" {
  capabilities = ["update"]
}

path "kv/undelete/${equipe}/${env}/*" {
  capabilities = ["update"]
}
%{ endfor ~}

# Voir quels environnements existent, sans rien y lire (une LISTE vise le chemin avec la barre finale).
path "kv/metadata/${equipe}/" {
  capabilities = ["list"]
}

path "sys/capabilities-self" {
  capabilities = ["update"]
}
