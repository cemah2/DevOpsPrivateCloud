# Gabarit de politique ci-<groupe>-<service> — plateforme/secrets (F2-S02), rendu par tofu/equipes.tf.
# Jobs des références PROTÉGÉES de ${projet} : lecture seule, chemins exacts (modèle ci-mediagenda-api,
# M25-E10). La signature passe par le rôle ci-signature (transit/cosign-medisphere, M25-E20), pas ici.

# Robot Harbor de publication (robot$medisphere+ci), partagé par les projets applicatifs.
path "kv/data/plateforme/harbor/robot-ci" {
  capabilities = ["read"]
}
