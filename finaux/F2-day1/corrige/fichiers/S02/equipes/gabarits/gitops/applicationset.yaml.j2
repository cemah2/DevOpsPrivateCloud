{#- gabarits/gitops/applicationset.yaml.j2 — le libre-service de déploiement d'une équipe (F2-S02, utilisé
    par le modèle nouveau-service v2 en F2-S04). Rendu dans plateforme/gitops : equipes/<equipe>/services.yaml. -#}
# GÉNÉRÉ par plateforme/equipes (outils/rendre.py) depuis equipes/{{ e.nom }}.yaml — NE PAS MODIFIER ICI.
#
# Une Application par service ET par environnement, sans MR à la plateforme : l'équipe déclare un
# service en ajoutant services/<service>.yaml (« service: <service> ») dans SON dépôt {{ e.groupe_gitlab }}/gitops ;
# le service est livré depuis {{ e.groupe_gitlab }}/<service>-deploiement, overlays/<environnement>.
# Ce que l'équipe NE contrôle PAS : le projet Argo CD (écrit en dur : « {{ e.nom }} », jamais une valeur
# du générateur), les destinations (l'AppProject n'accepte que ses espaces), la politique de
# synchronisation de chaque environnement.
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: {{ e.nom }}
  namespace: argocd
  labels:
    medisphere.internal/equipe: {{ e.nom }}
    medisphere.internal/origine: plateforme-equipes
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  # Si un service disparaît du générateur (fichier supprimé, dépôt illisible), son Application est
  # supprimée mais PAS les objets qu'elle a déployés : le retrait d'un service reste un geste explicite
  # (RB-320). (« applicationsSync » ferait plus, mais exige l'option --enable-policy-override du
  # contrôleur d'ApplicationSet : non activée chez MédiSphère.)
  syncPolicy:
    preserveResourcesOnDeletion: true
  generators:
    - matrix:
        generators:
          - git:
              repoURL: https://git01.par1.medisphere.internal/{{ e.groupe_gitlab }}/gitops.git
              revision: main
              files:
                - path: "services/*.yaml"
          - list:
              elements:
{%- for env, c in e.environnements.items() %}
                - environnement: {{ env }}
                  synchronisation: {{ c.synchronisation }}
{%- endfor %}
  template:
    metadata:
      name: '{{ e.nom }}-{{ "{{" }} .service {{ "}}" }}-{{ "{{" }} .environnement {{ "}}" }}'
      labels:
        medisphere.internal/equipe: {{ e.nom }}
        medisphere.internal/environnement: '{{ "{{" }} .environnement {{ "}}" }}'
    spec:
      project: {{ e.nom }}
      source:
        repoURL: 'https://git01.par1.medisphere.internal/{{ e.groupe_gitlab }}/{{ "{{" }} .service {{ "}}" }}-deploiement.git'
        targetRevision: main
        path: 'overlays/{{ "{{" }} .environnement {{ "}}" }}'
      destination:
        server: https://kubernetes.default.svc
        namespace: '{{ e.nom }}-{{ "{{" }} .environnement {{ "}}" }}'
  # Synchronisation automatique (prune, selfHeal) sauf pour les environnements « manuelle » (production) :
  # là, un humain synchronise, dans la fenêtre de l'AppProject.
  templatePatch: |
    spec:
      syncPolicy:
    {{ "{{-" }} if eq .synchronisation "automatique" {{ "}}" }}
        automated:
          prune: true
          selfHeal: true
    {{ "{{-" }} end {{ "}}" }}
        syncOptions:
          - ServerSideApply=true
          - CreateNamespace=false
