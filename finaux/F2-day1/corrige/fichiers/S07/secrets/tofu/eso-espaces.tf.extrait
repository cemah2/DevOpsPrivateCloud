# tofu/eso-espaces.tf — EXTRAIT (F2-S07) : entrée de local.espaces_eso (M25-E13, M27-E15) pour l'espace de
# secours. Le CronJob d'extraction lit le mot de passe du rôle extraction_data, rangé avec la PROD (une
# seule valeur, un seul endroit) : CE chemin précis, rien d'autre de kv/mediagenda/prod/. « chemins_creds »
# rend une règle « read » par chemin : il sert ici à un chemin KV v2 (préfixe kv/data/).
# (L'espace data-traitements, lui, est rendu par l'équipe en code : tofu/equipes.tf et son extrait.)
    "mediagenda-secours" = {
      application   = "mediagenda", environnement = "secours",
      chemins_creds = ["kv/data/mediagenda/prod/extraction-data"]
    }
