#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# harbor-allowlist — P-VUL-03 (F6-S09) : exceptions de vulnérabilité de Harbor (cve_allowlist de chaque
# projet : CVE, échéance) ; une entrée sans échéance ou échue est listée à part.
# Identités : HARBOR_USER / HARBOR_PASSWORD (robot en lecture, comme P-VUL-01).
# (dans le dépôt : à côté des collecteurs de S02 ; ici, corrigé du F6-S02)
# shellcheck source=../../../../F6-S02/outils/preuves/collecteurs/_commun.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/_commun.sh"
exige HARBOR_USER HARBOR_PASSWORD
H="${HARBOR_URL:-https://registry.par1.medisphere.internal}"
p="$(http_basique "$H/api/v2.0/projects?page_size=100" "$HARBOR_USER" "$HARBOR_PASSWORD")"
entete_preuve | jq -S --argjson p "$p" --argjson n "$(date -u +%s)" '
  . + {exceptions: [$p[] | {projet: .name, cves: [(.cve_allowlist.items // [])[].cve_id] | sort,
                           echeance: (.cve_allowlist.expires_at // null),
                           liste_systeme: ((.metadata.reuse_sys_cve_allowlist // "false") == "true")}] | sort_by(.projet)}
  | . + {anomalies: [.exceptions[] | select((.cves | length) > 0 and (.echeance == null or .echeance < $n))]}'
