#!/usr/bin/env bash
# =============================================================================
# ms-etat-preuves — état des preuves de conformité (F6-S14, SEC-3614)
#
# plateforme/outils — bin/ms-etat-preuves. Lancé par le pipeline planifié « preuves:etat » (après la
# collecte quotidienne) dans un clone de plateforme/medisphere ; le job publie le fichier généré par MR
# automatique. LECTURE SEULE : fiches d'écart du clone, compartiment preuves-conformite (identité de
# lecture « preuves-lecture »).
#
# Usage : ms-etat-preuves [--sortie FICHIER]
#
# Pour chaque fiche docs/conformite/ecarts/ECA-*.md, il lit l'en-tête YAML (id, statut, clos-le, preuve)
# et, pour un écart clos, vérifie :
#   - le champ « preuve » désigne un lot ms-preuves (lots/AAAA/MM/JJ/<LOT>/) qui EXISTE (lot.json lisible) ;
#   - le lot est daté au plus tard du jour de la clôture (une preuve fabriquée après coup se voit) ;
#   - le manifeste du lot porte une rétention en cours (verrouillage).
# Il vérifie aussi la COLLECTE : le compartiment est en COMPLIANCE et le dernier lot quotidien a moins de
# MS_ETAT_AGE_MAX_H heures (une collecte en panne fait rougir l'état avant que l'auditrice ne le voie).
# Sortie 1 si une ligne n'est pas « OK ».
#
# Variables (défauts adaptés au lab) :
#   MS_ETAT_ECARTS        docs/conformite/ecarts
#   MS_ETAT_SORTIE        docs/conformite/etat-preuves.md
#   MS_ETAT_AGE_MAX_H     36
#   MS_PREUVES_RGW_URL    https://rgw.par1.medisphere.internal
#   MS_PREUVES_COMPARTIMENT  preuves-conformite
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY   identité « preuves-lecture » (CI : OpenBao)
#
# Codes retour : 0 tout est recevable, 1 au moins une ligne en défaut, 2 usage ou outil manquant.
# =============================================================================
set -euo pipefail

ECARTS="${MS_ETAT_ECARTS:-docs/conformite/ecarts}"
SORTIE="${MS_ETAT_SORTIE:-docs/conformite/etat-preuves.md}"
AGE_MAX_H="${MS_ETAT_AGE_MAX_H:-36}"
RGW="${MS_PREUVES_RGW_URL:-https://rgw.par1.medisphere.internal}"
BUCKET="${MS_PREUVES_COMPARTIMENT:-preuves-conformite}"

case "${1:-}" in
  "") ;;
  --sortie) [[ -n "${2:-}" ]] || { echo "Usage : $0 [--sortie FICHIER]" >&2; exit 2; }; SORTIE="$2" ;;
  *) echo "Usage : $0 [--sortie FICHIER]" >&2; exit 2 ;;
esac
for c in aws jq date; do
  command -v "$c" >/dev/null 2>&1 || { echo "outil manquant : $c" >&2; exit 2; }
done
[[ -d "$ECARTS" ]] || { echo "registre des écarts introuvable : $ECARTS" >&2; exit 2; }
[[ -n "${AWS_ACCESS_KEY_ID:-}" ]] || { echo "identité de lecture des preuves absente (AWS_ACCESS_KEY_ID)" >&2; exit 2; }
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
s3() { aws --endpoint-url "$RGW" "$@"; }
maintenant() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# champ FICHIER CLÉ — valeur d'un champ de l'en-tête YAML (entre les deux premières lignes « --- »).
champ() {
  awk -v k="$2" 'NR == 1 && $0 != "---" { exit } NR > 1 && $0 == "---" { exit }
    NR > 1 { i = index($0, ":"); if (i && substr($0, 1, i - 1) == k) { v = substr($0, i + 1); sub(/^[ \t]+/, "", v); sub(/[ \t]+#.*$/, "", v); gsub(/^"|"$/, "", v); print v; exit } }' "$1"
}

echec=0
tmp="$(mktemp)"
trap 'rm -f -- "$tmp"' EXIT

# --- Collecte : verrou du compartiment et fraîcheur du dernier lot quotidien ----------------------------
verrou="$(s3 s3api get-object-lock-configuration --bucket "$BUCKET" 2>/dev/null |
  jq -r '.ObjectLockConfiguration.Rule.DefaultRetention | "\(.Mode // "aucun") \(.Days // ((.Years // 0) * 365)) j"' 2>/dev/null || echo "illisible")"
[[ "$verrou" == COMPLIANCE* ]] || echec=1
dernier="$(for m in "$(date -u +%Y/%m)" "$(date -u -d "$(date -u +%Y-%m-15) -1 month" +%Y/%m)"; do
  s3 s3 ls --recursive "s3://$BUCKET/lots/$m/" 2>/dev/null | awk '$4 ~ /-quotidienne\/lot\.json$/ { print $4 }'
done | sort | tail -n 1)"
dernier="${dernier%/lot.json}"
fraicheur="KO : aucun lot quotidien"
if [[ "${dernier##*/}" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z ]]; then
  t="$(date -u -d "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}T${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]}Z" +%s)"
  age_h=$((($(date -u +%s) - t) / 3600))
  if ((age_h <= AGE_MAX_H)); then fraicheur="OK ($age_h h)"; else fraicheur="KO : $age_h h (> $AGE_MAX_H h)"; fi
fi
[[ "$fraicheur" == OK* ]] || echec=1

# --- Écarts ------------------------------------------------------------------------------------------
for f in "$ECARTS"/ECA-*.md; do
  [[ -e "$f" ]] || continue
  id="$(champ "$f" id)"
  statut="$(champ "$f" statut)"
  clos="$(champ "$f" clos-le)"
  preuve="$(champ "$f" preuve)"
  preuve="${preuve#s3://"$BUCKET"/}"
  preuve="${preuve%/}"
  date_lot="—"
  retention="—"
  if [[ "$statut" != clos ]]; then
    etat="à suivre (échéance $(champ "$f" echeance))"
  elif [[ ! "$preuve" =~ ^lots/[0-9]{4}/[0-9]{2}/[0-9]{2}/([0-9]{4})([0-9]{2})([0-9]{2})T[0-9]{6}Z-[a-z]+$ ]]; then
    etat="KO : champ preuve sans lot ms-preuves"
    echec=1
  else
    date_lot="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}"
    if ! s3 s3api head-object --bucket "$BUCKET" --key "$preuve/lot.json" >/dev/null 2>&1; then
      etat="KO : lot introuvable"
      echec=1
    elif [[ ! "$clos" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ || "$date_lot" > "$clos" ]]; then
      etat="KO : lot postérieur à la clôture (ou clos-le absent)"
      echec=1
    else
      retention="$(s3 s3api head-object --bucket "$BUCKET" --key "$preuve/MANIFESTE.sha256" 2>/dev/null |
        jq -r --arg n "$(maintenant)" 'if (.ObjectLockRetainUntilDate // "") > $n then "\(.ObjectLockMode) → \(.ObjectLockRetainUntilDate[0:10])" else "aucune" end' 2>/dev/null || echo "illisible")"
      if [[ "$retention" == aucune || "$retention" == illisible ]]; then
        etat="KO : manifeste sans rétention en cours"
        echec=1
      else
        etat="OK"
      fi
    fi
  fi
  # shellcheck disable=SC2016  # accents graves littéraux (Markdown)
  printf '| %s | %s | %s | `%s` | %s | %s | %s |\n' "$id" "$statut" "${clos:-—}" "${preuve:-—}" "$date_lot" "$retention" "$etat" >>"$tmp"
done

{
  echo "# État des preuves de conformité"
  echo
  echo "> Généré par \`ms-preuves\`/\`ms-etat-preuves\` le $(maintenant) — ne pas modifier à la main."
  echo
  echo "## Collecte"
  echo
  echo "| Compartiment | Verrouillage par défaut | Dernier lot quotidien | Fraîcheur |"
  echo "|---|---|---|---|"
  echo "| \`$BUCKET\` | $verrou | \`${dernier:-—}\` | $fraicheur |"
  echo
  echo "## Écarts"
  echo
  echo "| Écart | Statut | Clos le | Lot de preuve | Date du lot | Rétention du manifeste | État |"
  echo "|---|---|---|---|---|---|---|"
  sort "$tmp"
} >"$SORTIE"
echo "état écrit dans $SORTIE" >&2
if ((echec)); then
  echo "== des preuves manquent, sont postérieures à la clôture ou la collecte est en défaut (voir $SORTIE) ==" >&2
  exit 1
fi
echo "== preuves des écarts clos présentes, antérieures à la clôture et verrouillées ; collecte à jour ==" >&2
