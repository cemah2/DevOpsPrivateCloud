# lab.env — configuration locale des scripts de vérification et de panne.
# Copie ce fichier en lab/lab.env (ignoré par git) et adapte-le à ton installation.
#   cp lab/lab.env.example lab/lab.env

# --- Hôtes SSH -------------------------------------------------------------
# Jusqu'à M00-E14 les checks tournent sur pve01 lui-même : mets WB_PVE_HOST=localhost.
# À partir de M00-E15 ils tournent sur adm01 : noms tels que définis dans ~/.ssh/config.
WB_PVE_HOST=pve01
WB_PBS_HOST=pbs01

# Options SSH supplémentaires (ex. "-i ~/.ssh/id_ed25519_lab")
WB_SSH_OPTS=""

# Délai max des tests réseau, en secondes
WB_TIMEOUT=5

# --- Réseau domestique ---------------------------------------------------
WB_LAN_MAISON="192.168.1.0/24"
# Adresse LAN de hp01 / pbs01 (endpoint WireGuard, accès avant le tunnel)
WB_PBS_LAN=""

# --- Stockages Proxmox (noms logiques de PLAN.md §3.2, adapte si différent) --
WB_STORAGE_NVME=local-nvme
WB_STORAGE_SSD=ssd-lab
WB_STORAGE_BULK=hdd-bulk

# --- M00-E04 : sauvegarde des photos de hp01 -----------------------------
WB_PHOTOS_DIR=/mnt/hdd-bulk/sauvegarde-photos-hp01
# 1 = recalcule toutes les sommes sha256 (long), 0 = contrôle rapide
WB_PHOTOS_FULLCHECK=0

# --- Dépôt de documentation MédiSphère (sur adm01) ------------------------
WB_DEPOT="$HOME/medisphere"

# --- Bloc A (modules 01 à 06) -------------------------------------------------
# Clones de travail des projets GitLab (plateforme/outils, images, ansible, infra…)
WB_SRC="$HOME/src"
# Ton compte GitLab personnel (M01-E05)
WB_MOI=""
# GitLab (M01) : jeton personnel en LECTURE SEULE (portée read_api) pour les checks
WB_GITLAB_URL="https://git01.par1.medisphere.internal"
WB_GITLAB_TOKEN_FILE="$HOME/.config/workbook/gitlab-checks.token"
# Jeton d'ADMINISTRATION GitLab (portée api, expiration courte) : scripts de ressources et de panne
WB_GITLAB_ADMIN_TOKEN_FILE="$HOME/.config/workbook/gitlab-admin.token"
# Stockage objet S3 du socle (M05)
WB_S3_ENDPOINT="https://s3-01.par1.medisphere.internal:8333"
# Semaphore UI (M04) : jeton d'API en lecture pour les checks
WB_SEMAPHORE_URL="https://sem01.par1.medisphere.internal"
WB_SEMAPHORE_TOKEN_FILE="$HOME/.config/workbook/semaphore-checks.token"

# NetBox (M06) : jeton v2 en lecture seule pour les checks
WB_NETBOX_URL="https://nbx01.par1.medisphere.internal"
WB_NETBOX_TOKEN_FILE="$HOME/.config/workbook/netbox-checks.token"

# --- Bloc B (modules 07 à 11) -------------------------------------------------
# Module 07 — bordure redondante (adresses du LAN maison, libres hors DHCP de la box)
WB_GW01_WAN=""      # <IP-GW01-WAN> : adresse WAN propre de gw01 (ex. 192.168.1.40)
WB_GW02_WAN=""      # <IP-GW02-WAN> : adresse WAN propre de gw02 (ex. 192.168.1.41)
WB_GW_WAN_VIP=""    # <IP-GW-WAN-VIP> : VIP WAN de la bordure, VRID 250 (ex. 192.168.1.50)

# Module 08 — Ceph : nœud _admin où les vérifications lancent « ceph » (sudo -n), client de test
WB_CEPH_ADMIN=ceph01
WB_CEPH_CLIENT=cephcli01

# Module 10 — clouds de ~/.config/openstack/clouds.yaml utilisés par les checks et les pannes
WB_OS_CLOUD=medisphere-admin                 # administration (lecture seule dans les checks)
WB_OS_CLOUD_PLATEFORME=medisphere-plateforme # projet plateforme (ton compte, M10-E05)
WB_OS_CLOUD_DEV=medisphere-mediagenda-dev    # julien.petit sur mediagenda-dev (M10-E05)

# Module 11 — provisioning
WB_ILO_ENV_FILE="$HOME/.config/workbook/ilo-hp01.env"   # accès Redfish à l'iLO de hp01
WB_MAAS_URL="http://10.10.60.11:5240/MAAS"              # API MAAS (M11-E09/E10/E22)
WB_MAAS_KEY_FILE="$HOME/.config/workbook/maas-api.key"  # clé d'API MAAS
WB_M11_MAAS_CONSERVE=0                                  # 1 si l'ADR-0110 conserve MAAS (M11-E25)

# --- Bloc C (modules 12 à 18) -------------------------------------------------
# Module 13 — Harbor : robot système en LECTURE pour les checks (HARBOR_USER=..., HARBOR_PASSWORD=...)
WB_HARBOR_URL="https://registry.par1.medisphere.internal"
WB_HARBOR_CHECKS_FILE="$HOME/.config/workbook/harbor-checks.env"

# Module 14 — Kubernetes (cluster k8s-par1)
WB_K8S_KUBECONFIG="$HOME/.config/workbook/k8s-checks.kubeconfig"  # compte de service wb-checks (lecture)
WB_K8S_ADMIN_KUBECONFIG="$HOME/.kube/config"                       # scripts de panne ; lecture de l'état Helm par les checks du M17
WB_K8S_CP="k8s-cp01 k8s-cp02 k8s-cp03"                             # nœuds de contrôle (SSH : admin)
WB_K8S_WORKERS="k8s-w01 k8s-w02 k8s-w03"

# Variables FACULTATIVES du bloc C (valeurs par défaut entre parenthèses ; ne les définis que pour changer le défaut)
