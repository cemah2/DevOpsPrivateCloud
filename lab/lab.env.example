# lab.env — configuration locale des scripts de vérification et de panne.
# Copie ce fichier en lab/lab.env (ignoré par git) et adapte-le à ton installation.
#   cp lab/lab.env.example lab/lab.env

# --- Hôtes SSH -------------------------------------------------------------
# Jusqu'à M00-E14 les checks tournent sur pve01 lui-même : mets WB_PVE_HOST=localhost.
# À partir de M00-E15 ils tournent sur adm01 : noms tels que définis dans ~/.ssh/config.
WB_PVE_HOST=pve01
WB_PBS_HOST=pbs01

# Options SSH supplémentaires (ex. "-i ~/.ssh/id_ed25519_lab")
WB_SSH_OPTS=""

# Délai max des tests réseau, en secondes
WB_TIMEOUT=5

# --- Réseau domestique ---------------------------------------------------
WB_LAN_MAISON="192.168.1.0/24"
# Adresse LAN de hp01 / pbs01 (endpoint WireGuard, accès avant le tunnel)
WB_PBS_LAN=""

# --- Stockages Proxmox (noms logiques de PLAN.md §3.2, adapte si différent) --
WB_STORAGE_NVME=local-nvme
WB_STORAGE_SSD=ssd-lab
WB_STORAGE_BULK=hdd-bulk

# --- M00-E04 : sauvegarde des photos de hp01 -----------------------------
WB_PHOTOS_DIR=/mnt/hdd-bulk/sauvegarde-photos-hp01
# 1 = recalcule toutes les sommes sha256 (long), 0 = contrôle rapide
WB_PHOTOS_FULLCHECK=0

# --- Dépôt de documentation MédiSphère (sur adm01) ------------------------
WB_DEPOT="$HOME/medisphere"

# --- Bloc A (modules 01 à 06) -------------------------------------------------
# Clones de travail des projets GitLab (plateforme/outils, images, ansible, infra…)
WB_SRC="$HOME/src"
# Ton compte GitLab personnel (M01-E05)
WB_MOI=""
# GitLab (M01) : jeton personnel en LECTURE SEULE (portée read_api) pour les checks
WB_GITLAB_URL="https://git01.par1.medisphere.internal"
WB_GITLAB_TOKEN_FILE="$HOME/.config/workbook/gitlab-checks.token"
# Jeton d'ADMINISTRATION GitLab (portée api, expiration courte) : scripts de ressources et de panne
WB_GITLAB_ADMIN_TOKEN_FILE="$HOME/.config/workbook/gitlab-admin.token"
# Stockage objet S3 du socle (M05)
WB_S3_ENDPOINT="https://s3-01.par1.medisphere.internal:8333"
# Semaphore UI (M04) : jeton d'API en lecture pour les checks
WB_SEMAPHORE_URL="https://sem01.par1.medisphere.internal"
WB_SEMAPHORE_TOKEN_FILE="$HOME/.config/workbook/semaphore-checks.token"

# NetBox (M06) : jeton v2 en lecture seule pour les checks
WB_NETBOX_URL="https://nbx01.par1.medisphere.internal"
WB_NETBOX_TOKEN_FILE="$HOME/.config/workbook/netbox-checks.token"
