# --- Blocs D et E (modules 19 à 23) ---------------------------------------------
# Les valeurs ci-dessous sont les défauts de lab/lib/check-lib.sh et des scripts des modules.
# Module 19 — Mailpit sur mon01 (compte wb-checks en lecture : MAILPIT_USER=..., MAILPIT_PASSWORD=...)
WB_MAILPIT_URL="https://mon01.par1.medisphere.internal:8025"
WB_MAILPIT_CHECKS_FILE="$HOME/.config/workbook/mailpit-checks.env"
WB_S3_CI_CACHE_FILE="$HOME/.config/workbook/s3-ci-cache.env"       # identité ci-cache de s3-01 (M19-E07)

# Module 20 — Argo CD (lu par tous les modules suivants)
WB_ARGOCD_URL="https://argocd.apps.par1.medisphere.internal"
WB_ARGOCD_TOKEN_FILE="$HOME/.config/workbook/argocd-checks.token"  # jeton du compte local ci-lecture (M20-E03)

# Modules 21 à 23 — points d'accès de l'observabilité (lus par tous les modules suivants)
WB_PROM_URL="http://prometheus.apps.par1.medisphere.internal:9090"     # Thanos Query (10.10.41.60) après M21-E24
WB_AM_URL="http://alertmanager.apps.par1.medisphere.internal:9093"     # 10.10.41.61
WB_GRAFANA_URL="https://grafana.apps.par1.medisphere.internal"
WB_GRAFANA_TOKEN_FILE="$HOME/.config/workbook/grafana-checks.token"    # compte de service wb-checks, Viewer (M21-E05)
WB_LOKI_URL="http://loki.apps.par1.medisphere.internal:3100"           # 10.10.41.62 (M22-E02)

