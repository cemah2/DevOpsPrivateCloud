#WB_M29_PROJET_RESILIENCE=plateforme/resilience        # scénarios k6, bibliothèque de chaos, journées de jeu (E05 et suivants)
#WB_M29_TEMOIN_URL=http://mon01.par1.medisphere.internal:9090   # Prometheus témoin de mon01 (M21) : sondes blackbox Goss et règles chargées (E07)
#WB_M29_CHAOS_NS=chaos-experiences                     # espace des objets de chaos créés depuis adm01 (E09 et suivants, exception ADR-0290)
#WB_M29_VERSION_VALIDATION=v2.11.0                     # étiquette de plateforme/ci-templates qui publie le composant validation (E10) ; dernière étiquette des modules précédents : v2.10.0 (M25-E20)
#WB_M29_GOSS_HOTES="dns02 nbx01"                       # VMs de l'essai Goss, sondées par mon01 sur le port 8099 (E07)
#WB_M29_PROJET_POLITIQUES=plateforme/politiques        # politiques Rego (E03, E19)
#WB_M29_PROJET_INFRA=plateforme/infra                  # projet dont la CI valide les plans (E19)
#WB_M29_PROJET_CI_TEMPLATES=plateforme/ci-templates    # composant validation (E19, E25)
#WB_M29_COMPOSANT_VALIDATION=templates/validation/template.yml
#WB_M29_CONFTEST_ARGS=""                               # arguments d'espaces de conftest de la CI, si la détection automatique échoue
#                                                      #   ex. "--namespace tofu" (défaut du composant) ou "--all-namespaces"
#WB_M29_E19_PLAN="$WB_ROOT/modules/29-tests-resilience/ressources/E19-plan-dangereux/plan-dangereux.json"   # plan de référence qui doit être refusé
#WB_M29_E19_ETAT=socle                                 # état (contexte.etat) avec lequel le plan de référence est évalué (E19, comme le job de plan)
#WB_M29_PROJET_GITOPS=plateforme/gitops                # valeurs de Chaos Mesh (panne E20 v2)
#WB_M29_FICHIER_VALEURS_CHAOS=valeurs/chaos-mesh/values.yaml
#WB_M29_PROJET_DEPLOIEMENT=mediagenda/deploiement      # overlay de recette (panne E23)
#WB_M29_FICHIER_KUSTO_RECETTE=overlays/recette/kustomization.yaml
#WB_M29_PROJET_TOFU_MODULES=plateforme/tofu-modules    # Terratest et nettoyeur (E08, E21, E25)
#WB_M29_TERRATEST_TMP=/tmp                             # où Terratest laisse ses copies temporaires sur adm01 (E21)
#WB_M29_E22_HOTES="nbx01 mon01"                        # VMs non critiques où E22 pose une dérive
#WB_M29_TESTINFRA_CMD='cd ~/src/ansible && uv run pytest tests/infra -q -p no:cacheprovider --hosts=ansible://{hote}'   # {hote} remplacé (E22)
